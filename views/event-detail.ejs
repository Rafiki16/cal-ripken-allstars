          <a href="/game/setup/<%= event.id %><%= typeof subEventId !== 'undefined' && subEventId ? '?sub=' + subEventId : '' %>" class="btn" style="margin-left:8px; background:#16a34a; color:white; text-decoration:none;">Start Live Game</a>
          <label style="display:flex; align-items:center; gap:6px; font-size:13px; font-weight:600; cursor:pointer; margin-left:12px;">
            <input type="checkbox" id="batting-nine-cb" <%= (event.batting_all || 0) === 0 ? 'checked' : '' %>> Batting 9
          </label>
          <span class="lg-save-msg" id="lg-save-msg"></span>
        </div>
        <div class="lg-add-player" id="lg-add-player">
          <select id="lg-player-select" class="form-input">
            <option value="">+ Add player to lineup...</option>
          </select>
        </div>
        <% } %>

        <!-- Print-only field diagram -->
        <div class="lg-print-field" id="lg-print-field">
          <svg viewBox="0 0 300 280" xmlns="http://www.w3.org/2000/svg" style="width:260px;">
            <polygon points="150,30 270,140 150,250 30,140" fill="none" stroke="#555" stroke-width="1.5"/>
            <line x1="150" y1="30" x2="150" y2="250" stroke="#ccc" stroke-width="0.5" stroke-dasharray="4"/>
            <line x1="30" y1="140" x2="270" y2="140" stroke="#ccc" stroke-width="0.5" stroke-dasharray="4"/>
            <circle cx="150" cy="30" r="14" fill="#1e40af" opacity="0.9"/><text x="150" y="34" text-anchor="middle" fill="white" font-size="10" font-weight="bold">CF-8</text>
            <circle cx="70" cy="80" r="14" fill="#1e40af" opacity="0.9"/><text x="70" y="84" text-anchor="middle" fill="white" font-size="10" font-weight="bold">LF-7</text>
            <circle cx="230" cy="80" r="14" fill="#1e40af" opacity="0.9"/><text x="230" y="84" text-anchor="middle" fill="white" font-size="10" font-weight="bold">RF-9</text>
            <circle cx="110" cy="130" r="14" fill="#16a34a" opacity="0.9"/><text x="110" y="134" text-anchor="middle" fill="white" font-size="10" font-weight="bold">SS-6</text>
            <circle cx="190" cy="130" r="14" fill="#16a34a" opacity="0.9"/><text x="190" y="134" text-anchor="middle" fill="white" font-size="10" font-weight="bold">2B-4</text>
            <circle cx="80" cy="175" r="14" fill="#16a34a" opacity="0.9"/><text x="80" y="179" text-anchor="middle" fill="white" font-size="10" font-weight="bold">3B-5</text>
            <circle cx="220" cy="175" r="14" fill="#16a34a" opacity="0.9"/><text x="220" y="179" text-anchor="middle" fill="white" font-size="10" font-weight="bold">1B-3</text>
            <circle cx="150" cy="190" r="14" fill="#dc2626" opacity="0.9"/><text x="150" y="194" text-anchor="middle" fill="white" font-size="10" font-weight="bold">P-1</text>
            <circle cx="150" cy="240" r="14" fill="#dc2626" opacity="0.9"/><text x="150" y="244" text-anchor="middle" fill="white" font-size="10" font-weight="bold">C-2</text>
          </svg>
        </div>
      </div>

      <script>
      (function() {
        const POS_MAP = {1:'P',2:'C',3:'1B',4:'2B',5:'3B',6:'SS',7:'LF',8:'CF',9:'RF'};
        const INNINGS = 6;
        const isAdmin = <%= isAdmin ? 'true' : 'false' %>;
        const allPlayers = <%- JSON.stringify(confirmedPlayers.map(p => ({
          id: p.id, name: p.player_name,
          jersey: p.jersey_number || '',
          positions: (p.best_positions || '').split(',').filter(Boolean)
        }))) %>;
        const savedGrid = <%- JSON.stringify(lineupGrid) %>;

        let grid = []; // [{playerId, name, positions, cells: [null or {pos, status}]}]
        let battingNine = <%= (event.batting_all || 0) === 0 ? 'true' : 'false' %>;
        const eventDate = '<%= new Date(event.start_date + "T12:00:00").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" }) %>';
        const eventTime = '<%= event.start_time ? (function(){ var parts = event.start_time.split(":"); var hr = parseInt(parts[0]); return (hr % 12 || 12) + ":" + parts[1].slice(0,2) + " " + (hr >= 12 ? "PM" : "AM"); })() : "" %>';
        const eventTitle = '<%= event.title %>';
        const opponentName = '<%= event.opponent_name || "" %>';

        function initGrid() {
          const playerMap = {};
          savedGrid.forEach(g => {
            if (!playerMap[g.player_id]) playerMap[g.player_id] = { order: g.batting_order, cells: {} };
            playerMap[g.player_id].cells[g.inning] = { pos: g.position_number, status: g.status };
          });
          const usedIds = new Set();
          const sorted = Object.entries(playerMap).sort((a,b) => a[1].order - b[1].order);
          sorted.forEach(([pid, data]) => {
            const p = allPlayers.find(x => x.id === Number(pid));
            if (!p) return;
            usedIds.add(p.id);
            const cells = [];
            for (let i = 1; i <= INNINGS; i++) {
              const c = data.cells[i];
              cells.push(c ? { pos: c.pos, status: c.status } : null);
            }
            grid.push({ playerId: p.id, name: p.name, jersey: p.jersey || '', positions: p.positions, cells });
          });
          if (grid.length === 0) {
            allPlayers.forEach(p => {
              grid.push({ playerId: p.id, name: p.name, jersey: p.jersey || '', positions: p.positions, cells: Array(INNINGS).fill(null) });
            });
          }
          renderGrid();
          updateAddSelect();
        }

        function isPositionFlagged(posNum, playerPositions) {
          if (!posNum || posNum >= 7) return false;
          if (!playerPositions || playerPositions.length === 0) return false;
          const posStr = POS_MAP[posNum];
          return !playerPositions.includes(posStr);
        }

        let dragIdx = null;

        function renderGrid() {
          const body = document.getElementById('lg-body');
          body.innerHTML = '';
          grid.forEach((row, ri) => {
            const tr = document.createElement('tr');
            if (isAdmin) {
              tr.draggable = true;
              tr.dataset.ri = ri;
              tr.addEventListener('dragstart', function(e) {
                dragIdx = ri;
                tr.classList.add('lg-dragging');
                e.dataTransfer.effectAllowed = 'move';
              });
              tr.addEventListener('dragend', function() {
                tr.classList.remove('lg-dragging');
                dragIdx = null;
                document.querySelectorAll('.lg-drag-over').forEach(el => el.classList.remove('lg-drag-over'));
              });
              tr.addEventListener('dragover', function(e) {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'move';
                if (dragIdx !== null && dragIdx !== ri) tr.classList.add('lg-drag-over');
              });
              tr.addEventListener('dragleave', function() { tr.classList.remove('lg-drag-over'); });
              tr.addEventListener('drop', function(e) {
                e.preventDefault();
                tr.classList.remove('lg-drag-over');
                if (dragIdx === null || dragIdx === ri) return;
                var moved = grid.splice(dragIdx, 1)[0];
                grid.splice(ri, 0, moved);
                dragIdx = null;
                renderGrid();
              });
            }
            const orderTd = document.createElement('td');
            orderTd.className = 'lg-cell-order';
            if (isAdmin) { orderTd.style.cursor = 'grab'; orderTd.title = 'Drag to reorder'; }
            orderTd.textContent = ri + 1;
            tr.appendChild(orderTd);

            const nameTd = document.createElement('td');
            nameTd.className = 'lg-cell-name';
            const nameContent = document.createElement('span');
            nameContent.className = 'lg-name-content';
            nameContent.innerHTML = (row.jersey ? '<span class="lg-jersey">' + row.jersey + '</span>' : '') + '<span class="lg-name-text">' + row.name + '</span>';
            if (row.positions.length > 0) {
              nameContent.innerHTML += '<span class="lg-pos-tag">' + row.positions.join(',') + '</span>';
            }
            nameTd.appendChild(nameContent);
            if (isAdmin) {
              const clrBtn = document.createElement('button');
              clrBtn.className = 'lg-rm-btn';
              clrBtn.textContent = '⌫';
              clrBtn.title = 'Clear positions';
              clrBtn.onclick = () => clearPlayerLineup(ri);
              nameTd.appendChild(clrBtn);
              const rmBtn = document.createElement('button');
              rmBtn.className = 'lg-rm-btn';
              rmBtn.textContent = '×';
              rmBtn.title = 'Remove from lineup';
              rmBtn.onclick = () => { grid.splice(ri, 1); renderGrid(); updateAddSelect(); };
              nameTd.appendChild(rmBtn);
            }
            tr.appendChild(nameTd);

            let sitCount = 0;
            for (let inn = 0; inn < INNINGS; inn++) {
              const td = document.createElement('td');
              td.className = 'lg-cell';
              const cell = row.cells[inn];
              if (isAdmin) {
                const inp = document.createElement('input');
                inp.className = 'lg-inp';
                inp.maxLength = 1;
                inp.dataset.row = ri;
                inp.dataset.inn = inn;
                if (cell) {
                  if (cell.status === 'sit') { inp.value = 'X'; td.classList.add('lg-sit'); sitCount++; }
                  else if (cell.status === 'sub_in') { inp.value = 'Y'; td.classList.add('lg-sub'); }
                  else if (cell.pos) { inp.value = cell.pos; }
                }
                if (cell && cell.pos && isPositionFlagged(cell.pos, row.positions)) {
                  td.classList.add('lg-flagged');
                }
                inp.addEventListener('input', (e) => handleCellInput(e, ri, inn));
                inp.addEventListener('keydown', (e) => handleCellNav(e, ri, inn));
                td.appendChild(inp);
              } else {
                if (cell) {
                  if (cell.status === 'sit') { td.textContent = 'X'; td.classList.add('lg-sit'); sitCount++; }
                  else if (cell.status === 'sub_in') { td.textContent = 'Y'; td.classList.add('lg-sub'); }
                  else if (cell.pos) { td.textContent = cell.pos; }
                }
                if (cell && cell.pos && isPositionFlagged(cell.pos, row.positions)) {
                  td.classList.add('lg-flagged');
                }
              }
              tr.appendChild(td);
            }

            const sitTd = document.createElement('td');
            sitTd.className = 'lg-cell-sit';
            sitTd.textContent = sitCount;
            if (sitCount > 0) sitTd.style.fontWeight = '700';
            tr.appendChild(sitTd);

            body.appendChild(tr);

            if (battingNine && ri === 8 && grid.length > 9) {
              var sep = document.createElement('tr');
              sep.className = 'lg-eligible-divider';
              sep.innerHTML = '<td colspan="' + (INNINGS + 3) + '">Also Eligible</td>';
              body.appendChild(sep);
            }
          });
          // Add "Need" row showing unfilled positions per inning
          var needTr = document.createElement('tr');
          needTr.className = 'lg-need-row';
          var needLabelTd = document.createElement('td');
          needLabelTd.colSpan = 2;
          needLabelTd.className = 'lg-need-label';
          needLabelTd.textContent = 'Need';
          needTr.appendChild(needLabelTd);

          for (var inn = 0; inn < INNINGS; inn++) {
            var filledPositions = new Set();
            grid.forEach(function(row) {
              var cell = row.cells[inn];
              if (cell && cell.status === 'field' && cell.pos) {
                filledPositions.add(cell.pos);
              }
            });
            var needTd = document.createElement('td');
            needTd.className = 'lg-need-cell';
            var missing = [];
            for (var p = 1; p <= 9; p++) {
              if (!filledPositions.has(p)) missing.push(POS_MAP[p]);
            }
            if (missing.length === 0) {
              needTd.innerHTML = '<span class="lg-need-ok">&#10003;</span>';
            } else if (missing.length === 9) {
              needTd.innerHTML = '<span class="lg-need-empty">All</span>';
            } else {
              needTd.innerHTML = missing.map(function(m) { return '<span class="lg-need-pos">' + m + '</span>'; }).join(' ');
            }
            needTr.appendChild(needTd);
          }
          // Empty sit column
          var needSitTd = document.createElement('td');
          needSitTd.className = 'lg-need-cell';
          needTr.appendChild(needSitTd);
          body.appendChild(needTr);

          validateGrid();
        }

        function handleCellInput(e, ri, inn) {
          let v = e.target.value.toUpperCase();
          if (v === 'X') {
            grid[ri].cells[inn] = { pos: null, status: 'sit' };
          } else if (v === 'Y') {
            grid[ri].cells[inn] = { pos: null, status: 'sub_in' };
          } else if (/^[1-9]$/.test(v)) {
            grid[ri].cells[inn] = { pos: parseInt(v), status: 'field' };
          } else {
            grid[ri].cells[inn] = null;
            e.target.value = '';
          }
          renderGrid();
          const next = document.querySelector('.lg-inp[data-row="' + ri + '"][data-inn="' + inn + '"]');
          if (next) next.focus();
          if (v && /^[1-9XY]$/i.test(v)) {
            const nextInn = inn + 1;
            if (nextInn < INNINGS) {
              const nxt = document.querySelector('.lg-inp[data-row="' + ri + '"][data-inn="' + nextInn + '"]');
              if (nxt) nxt.focus();
            }
          }
        }

        function handleCellNav(e, ri, inn) {
          let nr = ri, ni = inn;
          if (e.key === 'ArrowRight' || e.key === 'Tab' && !e.shiftKey) {
            ni++; if (ni >= INNINGS) { ni = 0; nr++; }
          } else if (e.key === 'ArrowLeft' || e.key === 'Tab' && e.shiftKey) {
            ni--; if (ni < 0) { ni = INNINGS - 1; nr--; }
          } else if (e.key === 'ArrowDown') { nr++; }
          else if (e.key === 'ArrowUp') { nr--; }
          else return;
          if (nr < 0 || nr >= grid.length) return;
          e.preventDefault();
          const nxt = document.querySelector('.lg-inp[data-row="' + nr + '"][data-inn="' + ni + '"]');
          if (nxt) { nxt.focus(); nxt.select(); }
        }

        function validateGrid() {
          const el = document.getElementById('lg-validation');
          const msgs = [];
          for (let inn = 0; inn < INNINGS; inn++) {
            const positions = {};
            let fieldCount = 0;
            grid.forEach((row, ri) => {
              const cell = row.cells[inn];
              if (cell && cell.status === 'field' && cell.pos) {
                fieldCount++;
                if (positions[cell.pos]) positions[cell.pos].push(row.name);
                else positions[cell.pos] = [row.name];
              }
            });
            if (fieldCount > 0 && fieldCount !== 9) {
              msgs.push('Inning ' + (inn+1) + ': ' + fieldCount + ' fielders (need 9)');
            }
            Object.entries(positions).forEach(([pos, names]) => {
              if (names.length > 1) msgs.push('Inning ' + (inn+1) + ': ' + POS_MAP[pos] + ' assigned to ' + names.join(', '));
            });
          }
          el.innerHTML = msgs.map(m => '<div class="lg-val-err">' + m + '</div>').join('');
        }

        function updateAddSelect() {
          const sel = document.getElementById('lg-player-select');
          if (!sel) return;
          const used = new Set(grid.map(r => r.playerId));
          sel.innerHTML = '<option value="">+ Add player to lineup...</option>';
          allPlayers.filter(p => !used.has(p.id)).forEach(p => {
            sel.innerHTML += '<option value="' + p.id + '">' + p.name + '</option>';
          });
          sel.onchange = () => {
            const pid = Number(sel.value);
            if (!pid) return;
            const p = allPlayers.find(x => x.id === pid);
            if (p) {
              grid.push({ playerId: p.id, name: p.name, jersey: p.jersey || '', positions: p.positions, cells: Array(INNINGS).fill(null) });
              renderGrid();
              updateAddSelect();
            }
          };
        }

        window.saveLineupGrid = async function() {
          const entries = [];
          grid.forEach((row, ri) => {
            row.cells.forEach((cell, inn) => {
              if (cell) {
                entries.push({
                  player_id: row.playerId,
                  batting_order: ri + 1,
                  inning: inn + 1,
                  position_number: cell.pos || null,
                  status: cell.status
                });
              }
            });
          });
          const msgEl = document.getElementById('lg-save-msg');
          try {
            const r = await fetch('/event/<%= event.id %>/lineup-grid', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ entries })
            });
            const data = await r.json();
            if (data.ok) { msgEl.textContent = 'Saved!'; msgEl.style.color = '#16a34a'; }
            else { msgEl.textContent = 'Error saving'; msgEl.style.color = '#dc2626'; }
          } catch(e) { msgEl.textContent = 'Error saving'; msgEl.style.color = '#dc2626'; }
          setTimeout(() => msgEl.textContent = '', 3000);
        };

        window.printLineup = function(mode) {
          if (mode === 'umpire') {
            // When batting 9: starters = first 9 in order, eligible = everyone else
            // When batting all: everyone is in the lineup, no eligible column
            var starters = [];
            var eligible = [];

            if (battingNine) {
              // Batting 9: split into starters (fielding inning 1) and eligible (sitting)
              grid.forEach(function(row, ri) {
                var c0 = row.cells[0];
                var pos = '';
                var isSitting = false;
                if (c0 && c0.status === 'field' && c0.pos) {
                  pos = POS_MAP[c0.pos] || String(c0.pos);
                } else if (c0 && (c0.status === 'sit' || c0.status === 'sub_in')) {
                  isSitting = true;
                } else if (!c0) {
                  isSitting = true;
                }
                var entry = { name: row.name, jersey: row.jersey, pos: pos };
                if (isSitting) eligible.push(entry);
                else starters.push(entry);
              });
              // Ensure 9 starter slots
              while (starters.length < 9) starters.push(null);
            } else {
              // Batting all: everyone is in the lineup
              grid.forEach(function(row) {
                var c0 = row.cells[0];
                var pos = '';
                if (c0 && c0.status === 'field' && c0.pos) {
                  pos = POS_MAP[c0.pos] || String(c0.pos);
                }
                starters.push({ name: row.name, jersey: row.jersey, pos: pos });
              });
            }

            var showEligible = battingNine && eligible.length > 0;
            var eligStartNum = starters.filter(Boolean).length;

            var html = '<div class="ump-card' + (showEligible ? '' : ' ump-no-elig') + '">';

            // Header
            html += '<div class="ump-hdr">';
            html += '<div class="ump-hdr-title">OFFICIAL BATTING ORDER</div>';
            html += '<div class="ump-hdr-team"><%= teamName %></div>';
            html += '<div class="ump-hdr-details">';
            html += '<span>' + eventDate + '</span>';
            if (eventTime) html += '<span> at ' + eventTime + '</span>';
            if (opponentName) html += '<span> &mdash; vs ' + opponentName + '</span>';
            html += '</div>';
            html += '</div>';

            // Main layout: table on left, eligible sidebar on right (only if batting 9)
            html += '<div class="ump-body">';

            // Left: main batting order table
            html += '<table class="ump-tbl">';
            html += '<colgroup>';
            html += '<col style="width:28px;">';   // #
            html += '<col>';                        // Original (auto)
            html += '<col style="width:38px;">';    // Pos
            html += '<col>';                        // Change 1 (auto — write-in width)
            html += '<col style="width:38px;">';    // Pos
            html += '</colgroup>';
            html += '<thead><tr>';
            html += '<th class="ump-t-num"></th>';
            html += '<th class="ump-t-hd-orig">ORIGINAL</th>';
            html += '<th class="ump-t-hd-pos">POS.</th>';
            html += '<th class="ump-t-hd-chg">CHANGE</th>';
            html += '<th class="ump-t-hd-pos">POS.</th>';
            html += '</tr></thead><tbody>';

            for (var s = 0; s < starters.length; s++) {
              var p = starters[s];
              // Top row: starter info
              html += '<tr class="ump-row-top">';
              html += '<td class="ump-t-num" rowspan="2">' + (s + 1) + '</td>';
              html += '<td class="ump-t-name">';
              if (p) html += (p.jersey ? '<span class="ump-j">#' + p.jersey + '</span> ' : '') + p.name;
              html += '</td>';
              html += '<td class="ump-t-posbox">' + (p ? p.pos : '') + '</td>';
              html += '<td class="ump-t-writein"></td>';
              html += '<td class="ump-t-posbox"></td>';
              html += '</tr>';
              // Bottom row: blank for defensive change / sub
              html += '<tr class="ump-row-bot">';
              html += '<td class="ump-t-sub"></td>';
              html += '<td class="ump-t-posbox"></td>';
              html += '<td class="ump-t-writein"></td>';
              html += '<td class="ump-t-posbox"></td>';
              html += '</tr>';
            }
            html += '</tbody></table>';

            // Right: Also Eligible sidebar (only when batting 9)
            if (showEligible) {
              html += '<div class="ump-elig">';
              html += '<div class="ump-elig-hdr">ALSO ELIGIBLE</div>';
              html += '<div class="ump-elig-list">';
              eligible.forEach(function(ep, idx) {
                html += '<div class="ump-elig-row">';
                html += '<span class="ump-elig-num">' + (eligStartNum + idx + 1) + '.</span> ';
                html += (ep.jersey ? '#' + ep.jersey + ' ' : '') + ep.name;
                html += '</div>';
              });
              // Pad with empty numbered rows
              for (var e = eligible.length; e < 6; e++) {
                html += '<div class="ump-elig-row ump-elig-empty">';
                html += '<span class="ump-elig-num">' + (eligStartNum + e + 1) + '.</span>';
                html += '</div>';
              }
              html += '</div></div>';
            }

            html += '</div>'; // end ump-body

            // Footer
            html += '<div class="ump-ft">';
            html += '<div class="ump-ft-sig"><span>MANAGER SIGNATURE:</span><span class="ump-ft-line"></span></div>';
            html += '</div>';
            html += '</div>';

            // Two copies side by side with cut line
            var fullHtml = '<div class="ump-page">';
            fullHtml += '<div class="ump-copy">' + html + '</div>';
            fullHtml += '<div class="ump-cut"></div>';
            fullHtml += '<div class="ump-copy">' + html + '</div>';
            fullHtml += '</div>';

            var old = document.getElementById('umpire-print');
            if (old) old.remove();
            var div = document.createElement('div');
            div.id = 'umpire-print';
            div.innerHTML = fullHtml;
            document.body.appendChild(div);
            document.body.classList.add('print-umpire');
            setTimeout(function() {
              window.print();
              document.body.classList.remove('print-umpire');
              div.remove();
            }, 100);
          } else {
            document.body.classList.add('print-full');
            window.print();
            document.body.classList.remove('print-full');
          }
        };

        window.clearEntireLineup = function() {
          if (!confirm('Clear all lineup assignments? You will need to Save to persist.')) return;
          grid.forEach(row => { row.cells = Array(INNINGS).fill(null); });
          renderGrid();
        };

        window.clearPlayerLineup = function(ri) {
          grid[ri].cells = Array(INNINGS).fill(null);
          renderGrid();
        };

        initGrid();

        var b9cb = document.getElementById('batting-nine-cb');
        if (b9cb) {
          b9cb.addEventListener('change', function() {
            battingNine = this.checked;
            renderGrid();
            fetch('/event/<%= event.id %>/batting-nine', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ batting_all: battingNine ? 0 : 1 })
            });
          });
        }
      })();
      </script>
      <% } %>

      <!-- ============ RSVP ============ -->
      <div class="ed-section">
        <%
          const yesCount = rsvps.filter(r => r.status === 'yes').length;
          const noCount = rsvps.filter(r => r.status === 'no').length;
          const maybeCount = rsvps.filter(r => r.status === 'maybe').length;
          const notResponded = confirmedPlayers.length - rsvps.filter(r => r.status !== 'pending').length;
        %>
        <h3 class="ed-section-title">RSVP Status</h3>
        <div class="rsvp-counts">
          <div class="rsvp-count rsvp-count-yes"><span class="rsvp-count-num"><%= yesCount %></span> Attending</div>
          <div class="rsvp-count rsvp-count-maybe"><span class="rsvp-count-num"><%= maybeCount %></span> Maybe</div>
          <div class="rsvp-count rsvp-count-no"><span class="rsvp-count-num"><%= noCount %></span> Can't Make It</div>
          <div class="rsvp-count rsvp-count-pending"><span class="rsvp-count-num"><%= notResponded %></span> No Response</div>
        </div>

        <% if (isAdmin || isStaff) { %>
        <%
          const yesPlayers = rsvps.filter(r => r.status === 'yes');
          const noPlayers = rsvps.filter(r => r.status === 'no');
          const maybePlayers = rsvps.filter(r => r.status === 'maybe');
          const respondedIds = new Set(rsvps.map(r => r.player_id));
          const noResponsePlayers = confirmedPlayers.filter(p => !respondedIds.has(p.id));
        %>
        <div style="margin-top:16px; display:flex; flex-direction:column; gap:12px;">
          <% if (yesPlayers.length > 0) { %>
          <div>
            <div style="font-size:12px; font-weight:700; color:#16a34a; margin-bottom:4px;">Attending (<%= yesPlayers.length %>)</div>
            <div style="display:flex; flex-wrap:wrap; gap:4px;">
              <% yesPlayers.forEach(r => { %>
              <span style="font-size:12px; padding:3px 10px; border-radius:6px; background:#dcfce7; color:#166534;"><%= r.player_name %></span>
              <% }); %>
            </div>
          </div>
          <% } %>
          <% if (maybePlayers.length > 0) { %>
          <div>
            <div style="font-size:12px; font-weight:700; color:#ca8a04; margin-bottom:4px;">Maybe (<%= maybePlayers.length %>)</div>
            <div style="display:flex; flex-wrap:wrap; gap:4px;">
              <% maybePlayers.forEach(r => { %>
              <span style="font-size:12px; padding:3px 10px; border-radius:6px; background:#fef9c3; color:#854d0e;"><%= r.player_name %></span>
              <% }); %>
            </div>
          </div>
          <% } %>
          <% if (noPlayers.length > 0) { %>
          <div>
            <div style="font-size:12px; font-weight:700; color:#dc2626; margin-bottom:4px;">Can't Make It (<%= noPlayers.length %>)</div>
            <div style="display:flex; flex-wrap:wrap; gap:4px;">
              <% noPlayers.forEach(r => { %>
              <span style="font-size:12px; padding:3px 10px; border-radius:6px; background:#fee2e2; color:#991b1b;"><%= r.player_name %></span>
              <% }); %>
            </div>
          </div>
          <% } %>
          <% if (noResponsePlayers.length > 0) { %>
          <div>
            <div style="font-size:12px; font-weight:700; color:#6b7280; margin-bottom:4px;">No Response (<%= noResponsePlayers.length %>)</div>
            <div style="display:flex; flex-wrap:wrap; gap:4px;">
              <% noResponsePlayers.forEach(p => { %>
              <span style="font-size:12px; padding:3px 10px; border-radius:6px; background:#f3f4f6; color:#6b7280;"><%= p.player_name %></span>
              <% }); %>
            </div>
          </div>
          <% } %>
        </div>
        <% } %>

        <% if (parentUser) { %>
        <% const myRsvps = rsvps.filter(r => parentUser.player_ids && parentUser.player_ids.includes(r.player_id)); %>
        <% const myStatus = myRsvps.length > 0 ? myRsvps[0].status : null; %>
        <div class="rsvp-form-section">
          <% if (myStatus) { %>
          <div style="margin-bottom:12px; padding:10px 16px; border-radius:10px; background:<%= myStatus === 'yes' ? '#dcfce7' : myStatus === 'no' ? '#fee2e2' : '#fef9c3' %>; font-size:14px; font-weight:600; color:<%= myStatus === 'yes' ? '#166534' : myStatus === 'no' ? '#991b1b' : '#854d0e' %>;">
            You RSVP'd: <%= myStatus === 'yes' ? 'Attending' : myStatus === 'no' ? 'Not Attending' : 'Maybe' %>
          </div>
          <% } %>
          <h4 style="margin:0 0 8px; color:var(--navy); font-size:15px;"><%= myStatus ? 'Change RSVP' : 'RSVP for Your Player' %></h4>
          <form method="POST" action="/event/<%= event.id %>/rsvp" class="rsvp-phone-form">
            <div style="display:flex; gap:6px;">
              <button type="submit" name="status" value="yes" class="btn rsvp-btn-sm rsvp-yes">Yes</button>
              <button type="submit" name="status" value="maybe" class="btn rsvp-btn-sm rsvp-maybe">Maybe</button>
              <button type="submit" name="status" value="no" class="btn rsvp-btn-sm rsvp-no">No</button>
            </div>
          </form>
        </div>
        <% } else { %>
        <div class="rsvp-form-section">
          <h4 style="margin:0 0 8px; color:var(--navy); font-size:15px;">RSVP for Your Player</h4>
          <form method="POST" action="/event/<%= event.id %>/rsvp" class="rsvp-phone-form">
            <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
              <div style="flex:1; min-width:180px;">
                <label style="font-size:12px; color:var(--gray-500); font-weight:600; display:block; margin-bottom:4px;">Your Phone Number</label>
                <input type="tel" name="phone" placeholder="(941) 555-1234" class="form-input" required style="margin:0;">
              </div>
              <div style="display:flex; gap:6px;">
                <button type="submit" name="status" value="yes" class="btn rsvp-btn-sm rsvp-yes">Yes</button>
                <button type="submit" name="status" value="maybe" class="btn rsvp-btn-sm rsvp-maybe">Maybe</button>
                <button type="submit" name="status" value="no" class="btn rsvp-btn-sm rsvp-no">No</button>
              </div>
            </div>
          </form>
        </div>
        <% } %>
      </div>
    </div>
  </main>

  <footer>
    <div class="container">
      <p>Summer 2026 <%= teamName %> &middot; Major Division</p>
    </div>
  </footer>
</body>
</html>
