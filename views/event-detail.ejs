<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title><%= event.title %> &middot; <%= teamName %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <div class="container">
      <div class="header-content">
        <a href="/" class="back-link">&larr; Back to Schedule</a>
        <div class="header-text">
          <div class="logo">&#9918;</div>
          <div>
            <h1><%= event.title %></h1>
            <% const typeLabel = event.event_type === 'practice' ? 'Practice' : event.event_type === 'game' ? 'Game' : event.event_type === 'tournament' ? 'Tournament' : 'Event'; %>
            <p class="subtitle"><%= typeLabel %></p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="container">
    <div class="ed-body">
      <!-- Event Info -->
      <div class="ed-info">
        <% if (isAdmin) { %>
        <div style="display:flex;justify-content:flex-end;margin-bottom:8px;">
          <button type="button" class="btn btn-secondary" style="font-size:13px;padding:6px 16px;" onclick="document.getElementById('edit-event-panel').style.display = document.getElementById('edit-event-panel').style.display === 'none' ? 'block' : 'none'">&#9998; Edit Event</button>
        </div>
        <div id="edit-event-panel" style="display:none;margin-bottom:20px;padding:16px;background:#f3f4f6;border-radius:12px;border:1px solid var(--gray-200);">
          <h4 style="margin:0 0 12px;font-size:15px;color:var(--navy);">Edit Event</h4>
          <form method="POST" action="/admin/edit-team-event">
            <input type="hidden" name="event_id" value="<%= event.id %>">
            <input type="hidden" name="return_to" value="/event/<%= event.id %>">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
              <div>
                <label style="font-size:12px;font-weight:600;color:var(--gray-500);display:block;margin-bottom:3px;">Title</label>
                <input type="text" name="title" value="<%= event.title %>" required class="form-input" style="width:100%;">
              </div>
              <div>
                <label style="font-size:12px;font-weight:600;color:var(--gray-500);display:block;margin-bottom:3px;">Type</label>
                <select name="event_type" class="form-input" style="width:100%;">
                  <option value="practice" <%= event.event_type === 'practice' ? 'selected' : '' %>>Practice</option>
                  <option value="game" <%= event.event_type === 'game' ? 'selected' : '' %>>Game</option>
                  <option value="tournament" <%= event.event_type === 'tournament' ? 'selected' : '' %>>Tournament</option>
                  <option value="other" <%= event.event_type === 'other' ? 'selected' : '' %>>Other</option>
                </select>
              </div>
              <div>
                <label style="font-size:12px;font-weight:600;color:var(--gray-500);display:block;margin-bottom:3px;">Start Date</label>
                <input type="date" name="start_date" value="<%= event.start_date %>" required class="form-input" style="width:100%;">
              </div>
              <div>
                <label style="font-size:12px;font-weight:600;color:var(--gray-500);display:block;margin-bottom:3px;">End Date</label>
                <input type="date" name="end_date" value="<%= event.end_date || '' %>" class="form-input" style="width:100%;">
              </div>
              <div>
                <label style="font-size:12px;font-weight:600;color:var(--gray-500);display:block;margin-bottom:3px;">Start Time</label>
                <input type="time" name="start_time" value="<%= event.start_time || '' %>" class="form-input" style="width:100%;">
              </div>
              <div>
                <label style="font-size:12px;font-weight:600;color:var(--gray-500);display:block;margin-bottom:3px;">End Time</label>
                <input type="time" name="end_time" value="<%= event.end_time || '' %>" class="form-input" style="width:100%;">
              </div>
              <div>
                <label style="font-size:12px;font-weight:600;color:var(--gray-500);display:block;margin-bottom:3px;">Location Name</label>
                <input type="text" name="location_name" value="<%= event.location_name || '' %>" class="form-input" style="width:100%;">
              </div>
              <div>
                <label style="font-size:12px;font-weight:600;color:var(--gray-500);display:block;margin-bottom:3px;">Address</label>
                <input type="text" name="address" value="<%= event.address || '' %>" class="form-input" style="width:100%;">
              </div>
            </div>
            <div style="margin-top:10px;">
              <label style="font-size:12px;font-weight:600;color:var(--gray-500);display:block;margin-bottom:3px;">Notes</label>
              <textarea name="notes" class="form-input" rows="2" style="width:100%;resize:vertical;"><%= event.notes || '' %></textarea>
            </div>
            <div style="margin-top:12px;display:flex;gap:8px;">
              <button type="submit" class="btn btn-confirm" style="font-size:13px;padding:8px 20px;">Save Changes</button>
              <button type="button" class="btn btn-secondary" style="font-size:13px;padding:8px 20px;" onclick="document.getElementById('edit-event-panel').style.display='none'">Cancel</button>
            </div>
          </form>
        </div>
        <% } %>
        <div class="ed-meta-row">
          <div>
            <div class="ed-label">Date</div>
            <div class="ed-value">
              <%= new Date(event.start_date + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) %><% if (event.end_date && event.end_date !== event.start_date) { %> &ndash; <%= new Date(event.end_date + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }) %><% } %>
            </div>
          </div>
          <% if (event.start_time) { %>
          <div>
            <div class="ed-label">Time</div>
            <div class="ed-value">
              <% const [h,m] = event.start_time.split(':'); const hr = parseInt(h); %>
              <%= (hr % 12 || 12) + ':' + m + ' ' + (hr >= 12 ? 'PM' : 'AM') %><% if (event.end_time) { const [h2,m2] = event.end_time.split(':'); const hr2 = parseInt(h2); %> &ndash; <%= (hr2 % 12 || 12) + ':' + m2 + ' ' + (hr2 >= 12 ? 'PM' : 'AM') %><% } %>
            </div>
          </div>
          <% } %>
        </div>

        <% if (event.location_name || event.address) { %>
        <div style="margin-bottom:20px;">
          <div class="ed-label">Location</div>
          <% if (event.location_name) { %><div class="ed-value"><%= event.location_name %></div><% } %>
          <% if (event.address) { %>
            <div style="font-size:14px; color:var(--gray-700); margin-top:2px;"><%= event.address %></div>
            <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(event.address) %>" target="_blank" rel="noopener" class="te-map-link" style="display:inline-block; margin-top:6px;">Open in Google Maps &rarr;</a>
          <% } %>
        </div>
        <% } %>

        <% if (event.event_type === 'game' && event.opponent_name) { %>
        <div style="margin-bottom:20px;">
          <div class="ed-label">Opponent</div>
          <div class="ed-value"><%= event.opponent_name %></div>
        </div>
        <% } %>

        <% if (event.event_type === 'game' && event.our_score != null && event.opponent_score != null) { %>
        <div style="margin-bottom:20px; padding:16px; background:#f0f4ff; border-radius:12px; text-align:center;">
          <div class="ed-label" style="margin-bottom:8px;">Game Result</div>
          <div style="font-size:28px; font-weight:800; color:var(--navy); letter-spacing:2px;">
            <%= event.our_score %> &ndash; <%= event.opponent_score %>
          </div>
          <div style="margin-top:6px; font-size:14px; font-weight:700; color:<%= event.our_score > event.opponent_score ? '#16a34a' : event.our_score < event.opponent_score ? '#dc2626' : '#854d0e' %>;">
            <%= event.our_score > event.opponent_score ? 'WIN' : event.our_score < event.opponent_score ? 'LOSS' : 'TIE' %>
          </div>
          <% if (event.opponent_name) { %>
          <div style="font-size:13px; color:var(--gray-500); margin-top:4px;">vs <%= event.opponent_name %></div>
          <% } %>
        </div>
        <% } %>

        <% if (event.event_type === 'game' && isAdmin && (event.our_score == null || event.opponent_score == null)) { %>
        <div style="margin-bottom:20px; padding:16px; background:#fef9c3; border-radius:12px;">
          <div class="ed-label" style="margin-bottom:8px;">Enter Game Score</div>
          <form method="POST" action="/admin/update-score" style="display:flex; gap:8px; align-items:end; flex-wrap:wrap;">
            <input type="hidden" name="event_id" value="<%= event.id %>">
            <div>
              <label style="font-size:12px; color:var(--gray-500); display:block; margin-bottom:2px;">Us</label>
              <input type="number" name="our_score" min="0" class="form-input" style="width:70px;" required>
            </div>
            <div>
              <label style="font-size:12px; color:var(--gray-500); display:block; margin-bottom:2px;">Them</label>
              <input type="number" name="opponent_score" min="0" class="form-input" style="width:70px;" required>
            </div>
            <button type="submit" class="btn btn-confirm">Save Score</button>
          </form>
        </div>
        <% } else if (event.event_type === 'game' && isAdmin && event.our_score != null) { %>
        <div style="margin-bottom:12px;">
          <form method="POST" action="/admin/update-score" style="display:flex; gap:8px; align-items:end; flex-wrap:wrap;">
            <input type="hidden" name="event_id" value="<%= event.id %>">
            <div>
              <label style="font-size:12px; color:var(--gray-500); display:block; margin-bottom:2px;">Us</label>
              <input type="number" name="our_score" min="0" value="<%= event.our_score %>" class="form-input" style="width:70px;" required>
            </div>
            <div>
              <label style="font-size:12px; color:var(--gray-500); display:block; margin-bottom:2px;">Them</label>
              <input type="number" name="opponent_score" min="0" value="<%= event.opponent_score %>" class="form-input" style="width:70px;" required>
            </div>
            <button type="submit" class="btn btn-confirm" style="font-size:12px;">Update Score</button>
          </form>
          <form method="POST" action="/admin/clear-score" style="margin-top:8px;" onsubmit="return confirm('Clear the score for this game?')">
            <input type="hidden" name="event_id" value="<%= event.id %>">
            <button type="submit" class="btn-sm btn-sm-remove" style="font-size:11px; padding:4px 12px;">Clear Score</button>
          </form>
        </div>
        <% } %>

        <% if (event.notes) { %>
        <div style="margin-bottom:20px;">
          <div class="ed-label">Notes</div>
          <div style="font-size:14px; color:var(--gray-700);"><%= event.notes %></div>
        </div>
        <% } %>

        <% if (event.event_type === 'tournament' && event.hotel_info) { %>
        <div class="te-detail" style="margin-bottom:16px;">
          <div class="ed-label">Hotels</div>
          <div style="font-size:14px; color:var(--gray-700); white-space:pre-wrap;"><%= event.hotel_info %></div>
        </div>
        <% } %>
        <% if (event.event_type === 'tournament' && event.carpool_info) { %>
        <div class="te-detail" style="margin-bottom:16px;">
          <div class="ed-label">Carpool Info</div>
          <div style="font-size:14px; color:var(--gray-700); white-space:pre-wrap;"><%= event.carpool_info %></div>
        </div>
        <% } %>

        <% if (event.address) { %>
        <div class="te-map-embed">
          <iframe src="https://www.google.com/maps?q=<%= encodeURIComponent(event.address) %>&output=embed" width="100%" height="250" style="border:0; border-radius:12px;" allowfullscreen loading="lazy"></iframe>
        </div>
        <% } %>
      </div>

      <!-- ============ PRACTICE PLAN ============ -->
      <% if (event.event_type === 'practice') { %>
      <div class="ed-section">
        <h3 class="ed-section-title">Practice Plan</h3>

        <% if (drills.length > 0) { %>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px;">
          <% if (isStaff) { %>
          <a href="/event/<%= event.id %>/practice-timer" class="btn btn-confirm" style="display:inline-block;text-decoration:none;font-size:15px;padding:10px 24px;">Start Practice</a>
          <% } %>
          <% if (isAdmin) { %>
          <a href="/event/<%= event.id %>/print" class="btn btn-secondary" style="display:inline-block;text-decoration:none;font-size:15px;padding:10px 24px;">&#128424; Print Practice Plan</a>
          <form method="POST" action="/event/<%= event.id %>/drill/clear-all" onsubmit="return confirm('Remove ALL drills from this practice plan? This cannot be undone.')" style="margin:0;display:inline;">
            <button type="submit" class="btn btn-secondary" style="font-size:15px;padding:10px 24px;color:#dc2626;border-color:#fecaca;">Reset Practice Plan</button>
          </form>
          <% } %>
        </div>
        <%
          // Group drills into blocks (preserving sort order)
          const blocks = [];
          const blockMap = {};
          drills.forEach(drill => {
            const bName = drill.block_name || '';
            if (!blockMap[bName]) {
              blockMap[bName] = { name: bName, drills: [], parallelGroup: drill.parallel_group || null };
              blocks.push(blockMap[bName]);
            }
            blockMap[bName].drills.push(drill);
            // Use first drill's parallel_group as the block's group
            if (!blockMap[bName].parallelGroup && drill.parallel_group) {
              blockMap[bName].parallelGroup = drill.parallel_group;
            }
          });
          const hasBlocks = blocks.some(b => b.name !== '');

          // Group consecutive blocks that share a parallel_group
          const displayGroups = []; // each: { parallel: bool, groupName, blocks: [...] }
          blocks.forEach(block => {
            const pg = block.parallelGroup;
            if (pg) {
              const last = displayGroups[displayGroups.length - 1];
              if (last && last.parallel && last.groupName === pg) {
                last.blocks.push(block);
              } else {
                displayGroups.push({ parallel: true, groupName: pg, blocks: [block] });
              }
            } else {
              displayGroups.push({ parallel: false, groupName: null, blocks: [block] });
            }
          });

          // Calculate smart total: parallel groups use max, serial blocks sum
          let smartTotal = 0;
          displayGroups.forEach(dg => {
            if (dg.parallel && dg.blocks.length > 1) {
              const maxBlock = Math.max(...dg.blocks.map(b => b.drills.reduce((s, d) => s + d.duration_minutes, 0)));
              smartTotal += maxBlock;
            } else {
              dg.blocks.forEach(b => { smartTotal += b.drills.reduce((s, d) => s + d.duration_minutes, 0); });
            }
          });

          let globalDrillIdx = 0;
        %>
        <div id="drill-list" class="drill-list">
          <% displayGroups.forEach((dg, dgi) => { %>
            <% if (dg.parallel && dg.blocks.length > 1) { %>
            <!-- Parallel group container -->
            <div class="parallel-group" style="margin-top:<%= dgi > 0 ? '16px' : '0' %>;">
              <div class="parallel-label" style="display:flex;align-items:center;gap:8px;padding:6px 14px;background:#eef2ff;border:2px solid #818cf8;border-radius:10px 10px 0 0;font-size:13px;font-weight:700;color:#4338ca;">
                <span style="font-size:15px;">&#8644;</span> Running in Parallel &mdash; <%= dg.groupName %>
                <span style="margin-left:auto;font-weight:600;color:#6366f1;"><%= Math.max(...dg.blocks.map(b => b.drills.reduce((s, d) => s + d.duration_minutes, 0))) %> min (concurrent)</span>
              </div>
              <div class="parallel-columns" style="display:grid;grid-template-columns:repeat(<%= dg.blocks.length %>, 1fr);gap:0;border:2px solid #818cf8;border-top:none;border-radius:0 0 10px 10px;overflow:hidden;">
                <% dg.blocks.forEach((block, pbi) => { %>
                <div class="parallel-col" style="<%= pbi > 0 ? 'border-left:2px solid #c7d2fe;' : '' %>">
                  <div class="block-header" style="display:flex;justify-content:space-between;align-items:center;padding:8px 12px;background:var(--navy);color:#fff;font-weight:700;font-size:14px;">
                    <span><%= block.name || 'Station ' + (pbi+1) %></span>
                    <span style="font-size:12px;font-weight:600;opacity:0.85;"><%= block.drills.reduce((s, d) => s + d.duration_minutes, 0) %> min</span>
                  </div>
                  <% block.drills.forEach((drill, di) => { %>
                  <div class="drill-card<%= isAdmin ? ' drill-draggable' : '' %>" data-duration="<%= drill.duration_minutes %>" data-name="<%= drill.drill_name %>" data-id="<%= drill.id %>" data-block="<%= drill.block_name || '' %>" id="drill-<%= drill.id %>" style="border-radius:0;border-left:none;border-right:none;border-top:none;<%= di === block.drills.length - 1 ? 'border-bottom:none;' : '' %>" <% if (isAdmin) { %>draggable="true"<% } %>>
                    <% if (isAdmin) { %><div class="drill-grip" title="Drag to reorder">&#9776;</div><% } %>
                    <div class="drill-num"><%= ++globalDrillIdx %></div>
                    <div class="drill-body">
                      <div class="drill-name"><%= drill.drill_name %></div>
                      <% if (drill.description) { %><div class="drill-desc"><%= drill.description %></div><% } %>
                      <% if (drill.assigned_staff) { %>
                      <div class="drill-staff-tags"><% const pStaffIds = drill.assigned_staff.split(','); pStaffIds.forEach(sid => { const s = staffList.find(x => String(x.id) === sid.trim()); if (s) { %><span class="drill-staff-tag"><%= s.name %></span><% } }); %></div>
                      <% } %>
                      <% if (isStaff && drill.coach_notes) { %><div class="drill-coach-notes"><span class="coach-notes-badge">Coach Notes</span> <%= drill.coach_notes %></div><% } %>
                    </div>
                    <div class="drill-dur"><%= drill.duration_minutes %> min</div>
                  </div>
                  <% }); %>
                </div>
                <% }); %>
              </div>
            </div>
            <% } else { %>
            <!-- Serial block(s) -->
            <% dg.blocks.forEach((block, bi) => { %>
              <% if (hasBlocks && block.name) { %>
              <div class="block-header" style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;margin-top:<%= (dgi > 0 || bi > 0) ? '16px' : '0' %>;background:var(--navy);color:#fff;border-radius:10px 10px 0 0;font-weight:700;font-size:15px;">
                <span><%= block.name %></span>
                <span style="font-size:13px;font-weight:600;opacity:0.85;"><%= block.drills.reduce((s, d) => s + d.duration_minutes, 0) %> min</span>
              </div>
              <% } else if (hasBlocks && !block.name) { %>
              <div class="block-header" style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;margin-top:<%= (dgi > 0 || bi > 0) ? '16px' : '0' %>;background:#6b7280;color:#fff;border-radius:10px 10px 0 0;font-weight:700;font-size:15px;">
                <span>Other</span>
                <span style="font-size:13px;font-weight:600;opacity:0.85;"><%= block.drills.reduce((s, d) => s + d.duration_minutes, 0) %> min</span>
              </div>
              <% } %>
              <% block.drills.forEach((drill, di) => { %>
              <div class="drill-card<%= isAdmin ? ' drill-draggable' : '' %><%= hasBlocks && block.name ? ' drill-in-block' : '' %>" data-duration="<%= drill.duration_minutes %>" data-name="<%= drill.drill_name %>" data-id="<%= drill.id %>" data-block="<%= drill.block_name || '' %>" id="drill-<%= drill.id %>" <% if (isAdmin) { %>draggable="true"<% } %>>
                <% if (isAdmin) { %><div class="drill-grip" title="Drag to reorder">&#9776;</div><% } %>
                <div class="drill-num"><%= ++globalDrillIdx %></div>
                <div class="drill-body">
                  <div class="drill-name"><%= drill.drill_name %></div>
                  <% if (drill.description) { %><div class="drill-desc"><%= drill.description %></div><% } %>
                  <% if (drill.assigned_staff) { %>
                  <div class="drill-staff-tags"><% const drillStaffIds = drill.assigned_staff.split(','); drillStaffIds.forEach(sid => { const s = staffList.find(x => String(x.id) === sid.trim()); if (s) { %><span class="drill-staff-tag"><%= s.name %></span><% } }); %></div>
                  <% } %>
                  <% if (isStaff && drill.coach_notes) { %><div class="drill-coach-notes"><span class="coach-notes-badge">Coach Notes</span> <%= drill.coach_notes %></div><% } %>
                </div>
                <div class="drill-dur"><%= drill.duration_minutes %> min</div>
              </div>
              <% }); %>
            <% }); %>
            <% } %>
          <% }); %>
        </div>

        <div class="drill-total">Total: <%= smartTotal %> minutes<% if (smartTotal !== drills.reduce((s, d) => s + d.duration_minutes, 0)) { %> <span style="font-weight:400;color:#6366f1;font-size:12px;">(parallel blocks run concurrently)</span><% } %></div>

        <% if (isStaff) { %>
        <!-- Timer UI -->
        <div id="timer-panel" class="timer-panel" style="display:none;">
          <div class="timer-current-label" id="timer-label">—</div>
          <div class="timer-countdown" id="timer-countdown">00:00</div>
          <div class="timer-progress-bar"><div class="timer-progress-fill" id="timer-fill"></div></div>
          <div class="timer-next" id="timer-next"></div>
          <div class="timer-controls">
            <button type="button" class="btn timer-btn" id="timer-pause">Pause</button>
            <button type="button" class="btn timer-btn" id="timer-skip">Skip &rarr;</button>
            <button type="button" class="btn timer-btn timer-btn-stop" id="timer-stop">End</button>
          </div>
        </div>
        <button type="button" class="btn btn-primary btn-large" id="timer-start" style="margin-top:16px; width:100%;">Start Practice Timer</button>

        <script>
        (function(){
          const drills = <%- JSON.stringify(drills.map(d => ({ id: d.id, name: d.drill_name, desc: d.description, mins: d.duration_minutes }))) %>;
          let idx = 0, remaining = 0, interval = null, paused = false;
          const panel = document.getElementById('timer-panel');
          const label = document.getElementById('timer-label');
          const countdown = document.getElementById('timer-countdown');
          const fill = document.getElementById('timer-fill');
          const next = document.getElementById('timer-next');
          const cards = document.querySelectorAll('.drill-card');

          function fmt(s) { return Math.floor(s/60).toString().padStart(2,'0') + ':' + (s%60).toString().padStart(2,'0'); }

          function beep() {
            try {
              const ctx = new (window.AudioContext || window.webkitAudioContext)();
              const osc = ctx.createOscillator(); const gain = ctx.createGain();
              osc.connect(gain); gain.connect(ctx.destination);
              osc.frequency.value = 880; gain.gain.value = 0.3;
              osc.start(); osc.stop(ctx.currentTime + 0.3);
              setTimeout(() => { const o2 = ctx.createOscillator(); o2.connect(gain); o2.frequency.value = 1100; o2.start(); o2.stop(ctx.currentTime + 0.3); }, 400);
            } catch(e) {}
          }

          function highlight(i) {
            cards.forEach((c, j) => { c.classList.toggle('drill-active', j === i); });
            if (cards[i]) cards[i].scrollIntoView({ behavior: 'smooth', block: 'center' });
          }

          function startDrill(i) {
            if (i >= drills.length) { finish(); return; }
            idx = i;
            remaining = drills[i].mins * 60;
            label.textContent = drills[i].name;
            next.textContent = i + 1 < drills.length ? 'Next: ' + drills[i+1].name + ' (' + drills[i+1].mins + ' min)' : 'Last drill';
            highlight(i);
            tick();
          }

          function tick() {
            const total = drills[idx].mins * 60;
            countdown.textContent = fmt(remaining);
            fill.style.width = ((total - remaining) / total * 100) + '%';
            if (remaining <= 0) { beep(); startDrill(idx + 1); return; }
            remaining--;
          }

          function finish() {
            clearInterval(interval); interval = null;
            panel.style.display = 'none';
            document.getElementById('timer-start').style.display = '';
            document.getElementById('timer-start').textContent = 'Restart Practice Timer';
            cards.forEach(c => c.classList.remove('drill-active'));
            beep(); setTimeout(beep, 600);
            label.textContent = 'Practice Complete!';
          }

          document.getElementById('timer-start').onclick = function() {
            this.style.display = 'none';
            panel.style.display = '';
            paused = false;
            document.getElementById('timer-pause').textContent = 'Pause';
            startDrill(0);
            if (interval) clearInterval(interval);
            interval = setInterval(() => { if (!paused) tick(); }, 1000);
          };

          document.getElementById('timer-pause').onclick = function() {
            paused = !paused;
            this.textContent = paused ? 'Resume' : 'Pause';
          };

          document.getElementById('timer-skip').onclick = function() {
            startDrill(idx + 1);
          };

          document.getElementById('timer-stop').onclick = function() {
            finish();
          };
        })();
        </script>
        <% } /* end isStaff timer */ %>
        <% } else if (!isAdmin) { %>
          <p style="color:var(--gray-500); font-size:14px;">No practice plan posted yet.</p>
        <% } %>

        <% if (isAdmin) { %>
        <div class="ed-admin-section">
          <% if (practiceTemplates.length > 0) { %>
          <div style="margin-bottom:16px; padding-bottom:16px; border-bottom:1px solid var(--gray-200);">
            <h4 class="ed-admin-title">Load from Template</h4>
            <form method="POST" action="/event/<%= event.id %>/load-program" style="display:flex; gap:8px; align-items:end; flex-wrap:wrap;">
              <div style="flex:1; min-width:200px;">
                <select name="program_id" class="form-input" style="width:100%;" required>
                  <option value="">Select a template...</option>
                  <% practiceTemplates.forEach(t => { %>
                  <option value="<%= t.id %>"><%= t.title %></option>
                  <% }); %>
                </select>
              </div>
              <button type="submit" class="btn btn-secondary" style="white-space:nowrap;">Load Template</button>
            </form>
          </div>
          <% } %>
          <h4 class="ed-admin-title">Add Drill</h4>
          <form method="POST" action="/event/<%= event.id %>/drill" class="drill-form">
            <div style="display:flex; flex-direction:column; gap:8px;">
              <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
                <div style="flex:1; min-width:150px;">
                  <label style="font-size:12px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:4px;">Block <span style="font-weight:400;">(optional &mdash; group drills together)</span></label>
                  <input type="text" name="block_name" list="block-names" placeholder="e.g. Warm-Up, Infield, BP..." class="form-input" style="width:100%;">
                  <datalist id="block-names">
                    <% const existingBlocks = [...new Set(drills.map(d => d.block_name).filter(Boolean))]; %>
                    <% existingBlocks.forEach(b => { %>
                    <option value="<%= b %>">
                    <% }); %>
                  </datalist>
                </div>
              </div>
              <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
                <div style="flex:2; min-width:200px;">
                  <label style="font-size:12px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:4px;">Drill Name *</label>
                  <input type="text" name="drill_name" placeholder="e.g. Infield grounders, Batting practice..." required class="form-input" style="width:100%;">
                </div>
                <div style="width:80px;">
                  <label style="font-size:12px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:4px;">Minutes</label>
                  <input type="number" name="duration_minutes" placeholder="Min" value="10" min="1" max="120" class="form-input" style="width:100%;">
                </div>
              </div>
              <div>
                <label style="font-size:12px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:4px;">Description <span style="font-weight:400;">(visible to parents)</span></label>
                <textarea name="description" placeholder="What players should expect, what to bring, etc." class="form-input" rows="2" style="width:100%; resize:vertical;"></textarea>
              </div>
              <% if (staffList.length > 0) { %>
              <div>
                <label style="font-size:12px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:4px;">Assigned Coaches</label>
                <div class="staff-checkbox-group">
                  <% staffList.forEach(s => { %>
                  <label class="staff-checkbox-label"><input type="checkbox" name="assigned_staff" value="<%= s.id %>"> <%= s.name %><% if (s.role) { %> <span style="font-size:11px;color:var(--gray-400);">(<%= s.role %>)</span><% } %></label>
                  <% }); %>
                </div>
              </div>
              <% } %>
              <div>
                <label style="font-size:12px; font-weight:600; color:var(--orange, #d97706); display:block; margin-bottom:4px;">Coach Notes <span style="font-weight:400;">(staff only)</span></label>
                <textarea name="coach_notes" placeholder="Internal coaching notes — only visible to staff and admins" class="form-input" rows="2" style="width:100%; resize:vertical; border-color:var(--orange, #d97706);"></textarea>
              </div>
              <button type="submit" class="btn btn-confirm" style="align-self:flex-start;">Add Drill</button>
            </div>
          </form>

          <!-- Import from Excel -->
          <div style="margin-top:16px; padding-top:16px; border-top:1px solid var(--gray-200);">
            <h4 class="ed-admin-title">Import from Excel</h4>
            <div id="import-upload">
              <label style="display:inline-flex; align-items:center; gap:8px; cursor:pointer; padding:8px 16px; border:2px dashed var(--gray-300); border-radius:8px; font-size:13px; color:var(--gray-500); transition:border-color .2s;" onmouseover="this.style.borderColor='var(--navy)'" onmouseout="this.style.borderColor='var(--gray-300)'">
                <span style="font-size:18px;">&#128196;</span> Choose .xlsx or .xls file
                <input type="file" accept=".xlsx,.xls,.csv" id="import-file" style="display:none;">
              </label>
              <span id="import-filename" style="font-size:12px; color:var(--gray-500); margin-left:8px;"></span>
              <div id="import-error" style="color:#dc2626; font-size:13px; margin-top:8px; display:none;"></div>
            </div>

            <div id="import-mapper" style="display:none; margin-top:12px;">
              <div id="import-sheet-pick" style="margin-bottom:12px; display:none;">
                <label style="font-size:13px; font-weight:600; color:var(--navy);">Sheet:</label>
                <select id="import-sheet" class="form-input" style="width:auto; display:inline-block; margin-left:4px;"></select>
              </div>

              <p style="font-size:13px; color:var(--gray-500); margin:0 0 10px;">Map your spreadsheet columns to practice plan fields:</p>
              <div style="display:flex; flex-direction:column; gap:8px;">
                <div style="display:flex; align-items:center; gap:8px;">
                  <label style="width:140px; font-size:13px; font-weight:600; color:var(--navy);">Drill Name *</label>
                  <select id="map-name" class="form-input" style="flex:1;"></select>
                </div>
                <div style="display:flex; align-items:center; gap:8px;">
                  <label style="width:140px; font-size:13px; font-weight:600; color:var(--navy);">Description</label>
                  <select id="map-desc" class="form-input" style="flex:1;"><option value="">(skip)</option></select>
                </div>
                <div style="display:flex; align-items:center; gap:8px;">
                  <label style="width:140px; font-size:13px; font-weight:600; color:var(--navy);">Duration (min)</label>
                  <select id="map-dur" class="form-input" style="flex:1;"><option value="">(skip &mdash; default 10 min)</option></select>
                </div>
                <div style="display:flex; align-items:center; gap:8px;">
                  <label style="width:140px; font-size:13px; font-weight:600; color:var(--navy);">Block / Station</label>
                  <select id="map-block" class="form-input" style="flex:1;"><option value="">(skip)</option></select>
                </div>
                <div style="display:flex; align-items:center; gap:8px;">
                  <label style="width:140px; font-size:13px; font-weight:600; color:var(--navy);">Coach Notes</label>
                  <select id="map-notes" class="form-input" style="flex:1;"><option value="">(skip)</option></select>
                </div>
              </div>

              <div id="import-preview" style="margin-top:12px; overflow-x:auto;"></div>

              <button type="button" id="import-submit" class="btn btn-confirm" style="margin-top:12px;">Import Drills</button>
              <button type="button" id="import-cancel" class="btn btn-secondary" style="margin-top:12px; margin-left:8px;">Cancel</button>
            </div>
          </div>

          <script>
          (function() {
            let parsedData = null, selectedFile = null;
            const fileInput = document.getElementById('import-file');
            const mapper = document.getElementById('import-mapper');
            const sheetPick = document.getElementById('import-sheet-pick');
            const sheetSel = document.getElementById('import-sheet');
            const mapName = document.getElementById('map-name');
            const mapDesc = document.getElementById('map-desc');
            const mapDur = document.getElementById('map-dur');
            const mapBlock = document.getElementById('map-block');
            const mapNotes = document.getElementById('map-notes');
            const preview = document.getElementById('import-preview');
            const errDiv = document.getElementById('import-error');

            fileInput.addEventListener('change', async function() {
              const file = this.files[0];
              if (!file) return;
              selectedFile = file;
              document.getElementById('import-filename').textContent = file.name;
              errDiv.style.display = 'none';
              const form = new FormData();
              form.append('file', file);
              const resp = await fetch('/event/<%= event.id %>/drill/parse-excel', { method: 'POST', body: form });
              const data = await resp.json();
              if (data.error) { errDiv.textContent = data.error; errDiv.style.display = 'block'; mapper.style.display = 'none'; return; }
              parsedData = data.sheets;
              const names = Object.keys(parsedData);
              if (names.length === 0) { errDiv.textContent = 'No data found in file.'; errDiv.style.display = 'block'; return; }
              sheetSel.innerHTML = '';
              names.forEach(n => { const o = document.createElement('option'); o.value = n; o.textContent = n; sheetSel.appendChild(o); });
              sheetPick.style.display = names.length > 1 ? 'block' : 'none';
              mapper.style.display = 'block';
              populateMapping(names[0]);
            });

            sheetSel.addEventListener('change', function() { populateMapping(this.value); });

            function populateMapping(sheetName) {
              const sheet = parsedData[sheetName];
              if (!sheet) return;
              const cols = sheet.columns;

              mapName.innerHTML = '';
              mapDesc.innerHTML = '<option value="">(skip)</option>';
              mapDur.innerHTML = '<option value="">(skip — default 10 min)</option>';
              mapBlock.innerHTML = '<option value="">(skip)</option>';
              mapNotes.innerHTML = '<option value="">(skip)</option>';

              cols.forEach(c => {
                [mapName, mapDesc, mapDur, mapBlock, mapNotes].forEach(sel => {
                  const o = document.createElement('option'); o.value = c; o.textContent = c; sel.appendChild(o);
                });
              });

              // Auto-detect column mappings by name
              cols.forEach(c => {
                const cl = c.toLowerCase();
                if (cl.includes('name') || cl.includes('drill') || cl.includes('title') || cl.includes('activity')) mapName.value = c;
                if (cl.includes('desc') || cl.includes('detail') || cl.includes('focus')) mapDesc.value = c;
                if (cl.includes('dur') || cl.includes('min') || cl.includes('time') || cl.includes('length')) mapDur.value = c;
                if (cl.includes('block') || cl.includes('station') || cl.includes('group') || cl.includes('section') || cl.includes('segment')) mapBlock.value = c;
                if (cl.includes('note') || cl.includes('coach') || cl.includes('comment') || cl.includes('instruction')) mapNotes.value = c;
              });

              renderPreview(sheet);
              [mapName, mapDesc, mapDur, mapBlock, mapNotes].forEach(sel => { sel.onchange = function() { renderPreview(sheet); }; });
            }

            function renderPreview(sheet) {
              const rows = sheet.preview;
              var nameCol = mapName.value, descCol = mapDesc.value, durCol = mapDur.value, blockCol = mapBlock.value, notesCol = mapNotes.value;
              var thStyle = 'padding:4px 8px; text-align:left; border-bottom:2px solid var(--gray-200); white-space:nowrap;';
              var tdStyle = 'padding:4px 8px; border-bottom:1px solid var(--gray-100);';
              let html = '<table style="width:100%; font-size:12px; border-collapse:collapse;">';
              html += '<thead><tr style="background:var(--gray-50);">';
              html += '<th style="' + thStyle + '">Drill Name</th>';
              if (descCol) html += '<th style="' + thStyle + '">Description</th>';
              html += '<th style="' + thStyle + '">Duration</th>';
              if (blockCol) html += '<th style="' + thStyle + '">Block</th>';
              if (notesCol) html += '<th style="' + thStyle + '">Coach Notes</th>';
              html += '</tr></thead><tbody>';
              var colCount = 2 + (descCol ? 1 : 0) + (blockCol ? 1 : 0) + (notesCol ? 1 : 0);
              rows.forEach(r => {
                var name = nameCol ? (r[nameCol] || '') : '';
                var desc = descCol ? (r[descCol] || '') : '';
                var dur = durCol ? (r[durCol] || '') : '10';
                var block = blockCol ? (r[blockCol] || '') : '';
                var notes = notesCol ? (r[notesCol] || '') : '';
                html += '<tr><td style="' + tdStyle + '">' + escHtml(String(name)) + '</td>';
                if (descCol) html += '<td style="' + tdStyle + ' color:var(--gray-500);">' + escHtml(String(desc)) + '</td>';
                html += '<td style="' + tdStyle + '">' + escHtml(String(dur)) + ' min</td>';
                if (blockCol) html += '<td style="' + tdStyle + ' color:#6366f1;">' + escHtml(String(block)) + '</td>';
                if (notesCol) html += '<td style="' + tdStyle + ' color:var(--gray-500); max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">' + escHtml(String(notes)) + '</td>';
                html += '</tr>';
              });
              if (rows.length >= 5) html += '<tr><td colspan="' + colCount + '" style="padding:4px 8px; color:var(--gray-400); font-style:italic;">...more rows in file</td></tr>';
              html += '</tbody></table>';
              preview.innerHTML = html;
            }

            function escHtml(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

            document.getElementById('import-submit').addEventListener('click', function() {
              if (!selectedFile || !mapName.value) return;
              const form = new FormData();
              form.append('file', selectedFile);
              form.append('sheet', sheetSel.value);
              form.append('col_name', mapName.value);
              form.append('col_desc', mapDesc.value);
              form.append('col_duration', mapDur.value);
              form.append('col_block', mapBlock.value);
              form.append('col_notes', mapNotes.value);
              const f = document.createElement('form');
              f.method = 'POST'; f.action = '/event/<%= event.id %>/drill/import'; f.enctype = 'multipart/form-data'; f.style.display = 'none';

              const dt = new DataTransfer();
              dt.items.add(selectedFile);
              const fi = document.createElement('input'); fi.type = 'file'; fi.name = 'file'; fi.files = dt.files; f.appendChild(fi);
              ['sheet','col_name','col_desc','col_duration','col_block','col_notes'].forEach(k => { const i = document.createElement('input'); i.type = 'hidden'; i.name = k; i.value = form.get(k); f.appendChild(i); });
              document.body.appendChild(f);
              f.submit();
            });

            document.getElementById('import-cancel').addEventListener('click', function() {
              mapper.style.display = 'none';
              fileInput.value = '';
              document.getElementById('import-filename').textContent = '';
              parsedData = null; selectedFile = null;
            });
          })();
          </script>

          <div style="margin-top:16px; padding-top:16px; border-top:1px solid var(--gray-200);">
            <h4 class="ed-admin-title">Save as Template</h4>
            <form method="POST" action="/event/<%= event.id %>/save-as-program" style="display:flex; gap:8px; align-items:end; flex-wrap:wrap;">
              <div style="flex:1; min-width:200px;">
                <label style="font-size:12px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:4px;">Template Name</label>
                <input type="text" name="template_name" placeholder="<%= event.title %> Template" class="form-input" style="width:100%;">
              </div>
              <button type="submit" class="btn btn-secondary" style="white-space:nowrap;"<%= drills.length === 0 ? ' disabled' : '' %>>Save as Template</button>
            </form>
          </div>

          <% if (drills.length > 0) { %>
          <div style="margin-top:16px; padding-top:12px; border-top:1px solid var(--gray-200);">
            <h4 class="ed-admin-title">Manage Drills</h4>

            <%
              // Build ordered block list for manage section
              const mBlocks = [];
              const mBlockMap = {};
              drills.forEach(d => {
                const bn = d.block_name || '';
                if (!mBlockMap[bn]) {
                  mBlockMap[bn] = { name: bn, drills: [], parallelGroup: d.parallel_group || '' };
                  mBlocks.push(mBlockMap[bn]);
                }
                mBlockMap[bn].drills.push(d);
                if (!mBlockMap[bn].parallelGroup && d.parallel_group) mBlockMap[bn].parallelGroup = d.parallel_group;
              });
              const mBlockNames = mBlocks.filter(b => b.name).map(b => b.name);
              const mParallelGroups = [...new Set(drills.map(d => d.parallel_group).filter(Boolean))];
            %>

            <div id="block-sortable-container" data-event-id="<%= event.id %>">
            <% mBlocks.forEach((mBlock, mbi) => { %>
              <% if (mBlock.name) { %>
              <!-- Named Block Group -->
              <details class="drag-block" data-block-name="<%= mBlock.name %>" style="margin-bottom:12px;border:2px solid <%= mBlock.parallelGroup ? '#818cf8' : 'var(--navy)' %>;border-radius:10px;overflow:hidden;" open>
                <summary style="padding:10px 14px;cursor:pointer;background:<%= mBlock.parallelGroup ? '#4338ca' : 'var(--navy)' %>;color:#fff;font-weight:700;font-size:14px;display:flex;align-items:center;gap:8px;">
                  <span class="drag-handle" title="Drag to reorder" style="cursor:grab;font-size:18px;opacity:0.7;user-select:none;">&#9776;</span>
                  <span style="flex:1;"><%= mBlock.name %></span>
                  <span style="font-size:12px;font-weight:600;opacity:0.8;"><%= mBlock.drills.length %> drills &middot; <%= mBlock.drills.reduce((s,d) => s + d.duration_minutes, 0) %> min</span>
                  <% if (mBlock.parallelGroup) { %>
                  <span style="font-size:11px;background:rgba(255,255,255,0.2);padding:2px 8px;border-radius:10px;">&#8644; Parallel: <%= mBlock.parallelGroup %></span>
                  <% } else { %>
                  <span style="font-size:11px;opacity:0.6;">Serial</span>
                  <% } %>
                </summary>
                <div style="padding:12px;">
                  <!-- Block-level controls -->
                  <div style="margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid var(--gray-200);">
                    <form method="POST" action="/event/<%= event.id %>/drill/update-block" style="margin:0;">
                      <input type="hidden" name="block_name" value="<%= mBlock.name %>">
                      <div style="display:flex;flex-direction:column;gap:8px;">
                        <div style="display:flex;gap:8px;align-items:end;flex-wrap:wrap;">
                          <div style="flex:1;min-width:150px;">
                            <label style="font-size:11px;font-weight:700;color:var(--navy);display:block;margin-bottom:3px;">Block Name</label>
                            <input type="text" name="new_block_name" value="<%= mBlock.name %>" required class="form-input" style="width:100%;font-size:13px;">
                          </div>
                          <div style="flex:1;min-width:150px;">
                            <label style="font-size:11px;font-weight:700;color:#4338ca;display:block;margin-bottom:3px;">Runs parallel with</label>
                            <%
                              // Find which other block shares the same parallel group
                              const partnerBlock = mBlock.parallelGroup
                                ? mBlocks.find(b => b.name !== mBlock.name && b.parallelGroup === mBlock.parallelGroup)
                                : null;
                              const partnerName = partnerBlock ? partnerBlock.name : '';
                            %>
                            <select name="parallel_group" class="form-input" style="width:100%;font-size:13px;border-color:#a5b4fc;">
                              <option value="">None (runs in sequence)</option>
                              <% mBlockNames.filter(n => n !== mBlock.name).forEach(n => { %>
                              <option value="<%= n %>" <%= partnerName === n ? 'selected' : '' %>><%= n %></option>
                              <% }); %>
                            </select>
                          </div>
                          <button type="submit" class="btn btn-confirm" style="font-size:12px;padding:6px 12px;white-space:nowrap;">Save</button>
                        </div>
                        <p style="font-size:11px;color:#6366f1;margin:0;">Select another block to run at the same time as this one.</p>
                      </div>
                    </form>
                    <div style="margin-top:8px;">
                      <form method="POST" action="/event/<%= event.id %>/drill/copy-block" style="display:inline;margin:0;">
                        <input type="hidden" name="block_name" value="<%= mBlock.name %>">
                        <button type="submit" class="btn-sm" style="font-size:12px;padding:4px 10px;background:#eef2ff;color:#4338ca;border:1px solid #c7d2fe;border-radius:6px;cursor:pointer;white-space:nowrap;">&#x2398; Copy Block</button>
                      </form>
                    </div>
                  </div>

                  <!-- Drills in this block -->
                  <% mBlock.drills.forEach(drill => { %>
                  <details style="margin-bottom:6px;border:1px solid var(--gray-200);border-radius:8px;overflow:hidden;">
                    <summary style="padding:7px 10px;cursor:pointer;font-size:13px;font-weight:600;background:var(--gray-50);display:flex;align-items:center;gap:8px;">
                      <span style="flex:1;"><%= drill.drill_name %></span>
                      <span style="font-size:12px;color:var(--gray-500);font-weight:400;"><%= drill.duration_minutes %>m</span>
                    </summary>
                    <div style="padding:10px 12px;">
                      <form method="POST" action="/event/<%= event.id %>/drill/<%= drill.id %>/update">
                        <input type="hidden" name="sort_order" value="<%= drill.sort_order %>">
                        <input type="hidden" name="parallel_group" value="<%= drill.parallel_group || '' %>">
                        <div style="display:flex;flex-direction:column;gap:6px;">
                          <div style="display:flex;gap:8px;align-items:end;">
                            <div style="flex:1;">
                              <label style="font-size:11px;font-weight:600;color:var(--gray-500);">Block</label>
                              <input type="text" name="block_name" value="<%= drill.block_name || '' %>" list="block-names-manage" class="form-input" style="width:100%;">
                            </div>
                            <div style="flex:2;">
                              <label style="font-size:11px;font-weight:600;color:var(--gray-500);">Name</label>
                              <input type="text" name="drill_name" value="<%= drill.drill_name %>" class="form-input" style="width:100%;">
                            </div>
                            <div style="width:65px;">
                              <label style="font-size:11px;font-weight:600;color:var(--gray-500);">Min</label>
                              <input type="number" name="duration_minutes" value="<%= drill.duration_minutes %>" min="1" max="120" class="form-input" style="width:100%;">
                            </div>
                          </div>
                          <div>
                            <label style="font-size:11px;font-weight:600;color:var(--gray-500);">Description</label>
                            <textarea name="description" class="form-input" rows="2" style="width:100%;resize:vertical;"><%= drill.description || '' %></textarea>
                          </div>
                          <% if (staffList.length > 0) { %>
                          <div>
                            <label style="font-size:11px;font-weight:600;color:var(--gray-500);">Assigned Coaches</label>
                            <div class="staff-checkbox-group">
                              <% const bStaff = (drill.assigned_staff || '').split(',').map(s => s.trim()); %>
                              <% staffList.forEach(s => { %>
                              <label class="staff-checkbox-label"><input type="checkbox" name="assigned_staff" value="<%= s.id %>" <%= bStaff.includes(String(s.id)) ? 'checked' : '' %>> <%= s.name %></label>
