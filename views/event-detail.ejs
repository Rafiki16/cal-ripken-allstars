<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= event.title %> &middot; Cal Ripken All-Stars</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <div class="container">
      <div class="header-content">
        <a href="/" class="back-link">&larr; Back to Schedule</a>
        <div class="header-text">
          <div class="logo">&#9918;</div>
          <div>
            <h1><%= event.title %></h1>
            <% const typeLabel = event.event_type === 'practice' ? 'Practice' : event.event_type === 'game' ? 'Game' : event.event_type === 'tournament' ? 'Tournament' : 'Event'; %>
            <p class="subtitle"><%= typeLabel %></p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="container">
    <div class="ed-body">
      <!-- Event Info -->
      <div class="ed-info">
        <div class="ed-meta-row">
          <div>
            <div class="ed-label">Date</div>
            <div class="ed-value">
              <%= new Date(event.start_date + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) %><% if (event.end_date && event.end_date !== event.start_date) { %> &ndash; <%= new Date(event.end_date + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }) %><% } %>
            </div>
          </div>
          <% if (event.start_time) { %>
          <div>
            <div class="ed-label">Time</div>
            <div class="ed-value">
              <% const [h,m] = event.start_time.split(':'); const hr = parseInt(h); %>
              <%= (hr % 12 || 12) + ':' + m + ' ' + (hr >= 12 ? 'PM' : 'AM') %><% if (event.end_time) { const [h2,m2] = event.end_time.split(':'); const hr2 = parseInt(h2); %> &ndash; <%= (hr2 % 12 || 12) + ':' + m2 + ' ' + (hr2 >= 12 ? 'PM' : 'AM') %><% } %>
            </div>
          </div>
          <% } %>
        </div>

        <% if (event.location_name || event.address) { %>
        <div style="margin-bottom:20px;">
          <div class="ed-label">Location</div>
          <% if (event.location_name) { %><div class="ed-value"><%= event.location_name %></div><% } %>
          <% if (event.address) { %>
            <div style="font-size:14px; color:var(--gray-700); margin-top:2px;"><%= event.address %></div>
            <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(event.address) %>" target="_blank" rel="noopener" class="te-map-link" style="display:inline-block; margin-top:6px;">Open in Google Maps &rarr;</a>
          <% } %>
        </div>
        <% } %>

        <% if (event.event_type === 'game' && event.opponent_name) { %>
        <div style="margin-bottom:20px;">
          <div class="ed-label">Opponent</div>
          <div class="ed-value"><%= event.opponent_name %></div>
        </div>
        <% } %>

        <% if (event.event_type === 'game' && event.our_score != null && event.opponent_score != null) { %>
        <div style="margin-bottom:20px; padding:16px; background:#f0f4ff; border-radius:12px; text-align:center;">
          <div class="ed-label" style="margin-bottom:8px;">Game Result</div>
          <div style="font-size:28px; font-weight:800; color:var(--navy); letter-spacing:2px;">
            <%= event.our_score %> &ndash; <%= event.opponent_score %>
          </div>
          <div style="margin-top:6px; font-size:14px; font-weight:700; color:<%= event.our_score > event.opponent_score ? '#16a34a' : event.our_score < event.opponent_score ? '#dc2626' : '#854d0e' %>;">
            <%= event.our_score > event.opponent_score ? 'WIN' : event.our_score < event.opponent_score ? 'LOSS' : 'TIE' %>
          </div>
          <% if (event.opponent_name) { %>
          <div style="font-size:13px; color:var(--gray-500); margin-top:4px;">vs <%= event.opponent_name %></div>
          <% } %>
        </div>
        <% } %>

        <% if (event.event_type === 'game' && isAdmin && (event.our_score == null || event.opponent_score == null)) { %>
        <div style="margin-bottom:20px; padding:16px; background:#fef9c3; border-radius:12px;">
          <div class="ed-label" style="margin-bottom:8px;">Enter Game Score</div>
          <form method="POST" action="/admin/update-score" style="display:flex; gap:8px; align-items:end; flex-wrap:wrap;">
            <input type="hidden" name="event_id" value="<%= event.id %>">
            <div>
              <label style="font-size:12px; color:var(--gray-500); display:block; margin-bottom:2px;">Us</label>
              <input type="number" name="our_score" min="0" class="form-input" style="width:70px;" required>
            </div>
            <div>
              <label style="font-size:12px; color:var(--gray-500); display:block; margin-bottom:2px;">Them</label>
              <input type="number" name="opponent_score" min="0" class="form-input" style="width:70px;" required>
            </div>
            <button type="submit" class="btn btn-confirm">Save Score</button>
          </form>
        </div>
        <% } else if (event.event_type === 'game' && isAdmin && event.our_score != null) { %>
        <div style="margin-bottom:12px;">
          <form method="POST" action="/admin/update-score" style="display:flex; gap:8px; align-items:end; flex-wrap:wrap;">
            <input type="hidden" name="event_id" value="<%= event.id %>">
            <div>
              <label style="font-size:12px; color:var(--gray-500); display:block; margin-bottom:2px;">Us</label>
              <input type="number" name="our_score" min="0" value="<%= event.our_score %>" class="form-input" style="width:70px;" required>
            </div>
            <div>
              <label style="font-size:12px; color:var(--gray-500); display:block; margin-bottom:2px;">Them</label>
              <input type="number" name="opponent_score" min="0" value="<%= event.opponent_score %>" class="form-input" style="width:70px;" required>
            </div>
            <button type="submit" class="btn btn-confirm" style="font-size:12px;">Update Score</button>
          </form>
        </div>
        <% } %>

        <% if (event.notes) { %>
        <div style="margin-bottom:20px;">
          <div class="ed-label">Notes</div>
          <div style="font-size:14px; color:var(--gray-700);"><%= event.notes %></div>
        </div>
        <% } %>

        <% if (event.event_type === 'tournament' && event.hotel_info) { %>
        <div class="te-detail" style="margin-bottom:16px;">
          <div class="ed-label">Hotels</div>
          <div style="font-size:14px; color:var(--gray-700); white-space:pre-wrap;"><%= event.hotel_info %></div>
        </div>
        <% } %>
        <% if (event.event_type === 'tournament' && event.carpool_info) { %>
        <div class="te-detail" style="margin-bottom:16px;">
          <div class="ed-label">Carpool Info</div>
          <div style="font-size:14px; color:var(--gray-700); white-space:pre-wrap;"><%= event.carpool_info %></div>
        </div>
        <% } %>

        <% if (event.address) { %>
        <div class="te-map-embed">
          <iframe src="https://www.google.com/maps?q=<%= encodeURIComponent(event.address) %>&output=embed" width="100%" height="250" style="border:0; border-radius:12px;" allowfullscreen loading="lazy"></iframe>
        </div>
        <% } %>
      </div>

      <!-- ============ PRACTICE PLAN ============ -->
      <% if (event.event_type === 'practice') { %>
      <div class="ed-section">
        <h3 class="ed-section-title">Practice Plan</h3>

        <% if (drills.length > 0) { %>
        <div id="drill-list" class="drill-list">
          <% drills.forEach((drill, i) => { %>
          <div class="drill-card" data-duration="<%= drill.duration_minutes %>" data-name="<%= drill.drill_name %>" id="drill-<%= drill.id %>">
            <div class="drill-num"><%= i + 1 %></div>
            <div class="drill-body">
              <div class="drill-name"><%= drill.drill_name %></div>
              <% if (drill.description) { %><div class="drill-desc"><%= drill.description %></div><% } %>
            </div>
            <div class="drill-dur"><%= drill.duration_minutes %> min</div>
          </div>
          <% }); %>
        </div>

        <div class="drill-total">Total: <%= drills.reduce((s, d) => s + d.duration_minutes, 0) %> minutes</div>

        <!-- Timer UI -->
        <div id="timer-panel" class="timer-panel" style="display:none;">
          <div class="timer-current-label" id="timer-label">—</div>
          <div class="timer-countdown" id="timer-countdown">00:00</div>
          <div class="timer-progress-bar"><div class="timer-progress-fill" id="timer-fill"></div></div>
          <div class="timer-next" id="timer-next"></div>
          <div class="timer-controls">
            <button type="button" class="btn timer-btn" id="timer-pause">Pause</button>
            <button type="button" class="btn timer-btn" id="timer-skip">Skip &rarr;</button>
            <button type="button" class="btn timer-btn timer-btn-stop" id="timer-stop">End</button>
          </div>
        </div>
        <button type="button" class="btn btn-primary btn-large" id="timer-start" style="margin-top:16px; width:100%;">Start Practice Timer</button>

        <script>
        (function(){
          const drills = <%- JSON.stringify(drills.map(d => ({ id: d.id, name: d.drill_name, desc: d.description, mins: d.duration_minutes }))) %>;
          let idx = 0, remaining = 0, interval = null, paused = false;
          const panel = document.getElementById('timer-panel');
          const label = document.getElementById('timer-label');
          const countdown = document.getElementById('timer-countdown');
          const fill = document.getElementById('timer-fill');
          const next = document.getElementById('timer-next');
          const cards = document.querySelectorAll('.drill-card');

          function fmt(s) { return Math.floor(s/60).toString().padStart(2,'0') + ':' + (s%60).toString().padStart(2,'0'); }

          function beep() {
            try {
              const ctx = new (window.AudioContext || window.webkitAudioContext)();
              const osc = ctx.createOscillator(); const gain = ctx.createGain();
              osc.connect(gain); gain.connect(ctx.destination);
              osc.frequency.value = 880; gain.gain.value = 0.3;
              osc.start(); osc.stop(ctx.currentTime + 0.3);
              setTimeout(() => { const o2 = ctx.createOscillator(); o2.connect(gain); o2.frequency.value = 1100; o2.start(); o2.stop(ctx.currentTime + 0.3); }, 400);
            } catch(e) {}
          }

          function highlight(i) {
            cards.forEach((c, j) => { c.classList.toggle('drill-active', j === i); });
            if (cards[i]) cards[i].scrollIntoView({ behavior: 'smooth', block: 'center' });
          }

          function startDrill(i) {
            if (i >= drills.length) { finish(); return; }
            idx = i;
            remaining = drills[i].mins * 60;
            label.textContent = drills[i].name;
            next.textContent = i + 1 < drills.length ? 'Next: ' + drills[i+1].name + ' (' + drills[i+1].mins + ' min)' : 'Last drill';
            highlight(i);
            tick();
          }

          function tick() {
            const total = drills[idx].mins * 60;
            countdown.textContent = fmt(remaining);
            fill.style.width = ((total - remaining) / total * 100) + '%';
            if (remaining <= 0) { beep(); startDrill(idx + 1); return; }
            remaining--;
          }

          function finish() {
            clearInterval(interval); interval = null;
            panel.style.display = 'none';
            document.getElementById('timer-start').style.display = '';
            document.getElementById('timer-start').textContent = 'Restart Practice Timer';
            cards.forEach(c => c.classList.remove('drill-active'));
            beep(); setTimeout(beep, 600);
            label.textContent = 'Practice Complete!';
          }

          document.getElementById('timer-start').onclick = function() {
            this.style.display = 'none';
            panel.style.display = '';
            paused = false;
            document.getElementById('timer-pause').textContent = 'Pause';
            startDrill(0);
            if (interval) clearInterval(interval);
            interval = setInterval(() => { if (!paused) tick(); }, 1000);
          };

          document.getElementById('timer-pause').onclick = function() {
            paused = !paused;
            this.textContent = paused ? 'Resume' : 'Pause';
          };

          document.getElementById('timer-skip').onclick = function() {
            startDrill(idx + 1);
          };

          document.getElementById('timer-stop').onclick = function() {
            finish();
          };
        })();
        </script>
        <% } else if (!isAdmin) { %>
          <p style="color:var(--gray-500); font-size:14px;">No practice plan posted yet.</p>
        <% } %>

        <% if (isAdmin) { %>
        <div class="ed-admin-section">
          <h4 class="ed-admin-title">Add Drill</h4>
          <form method="POST" action="/event/<%= event.id %>/drill" class="drill-form">
            <div style="display:flex; gap:8px; flex-wrap:wrap;">
              <input type="text" name="drill_name" placeholder="Drill name" required class="form-input" style="flex:2; min-width:140px;">
              <input type="text" name="description" placeholder="Description (optional)" class="form-input" style="flex:2; min-width:140px;">
              <input type="number" name="duration_minutes" placeholder="Min" value="10" min="1" max="120" class="form-input" style="width:70px;">
              <button type="submit" class="btn btn-confirm">Add</button>
            </div>
          </form>
          <% if (drills.length > 0) { %>
          <div style="margin-top:12px;">
            <% drills.forEach(drill => { %>
            <div style="display:flex; align-items:center; gap:8px; padding:6px 0; border-bottom:1px solid var(--gray-100);">
              <span style="flex:1; font-size:13px; font-weight:600;"><%= drill.drill_name %></span>
              <span style="font-size:12px; color:var(--gray-500);"><%= drill.duration_minutes %>m</span>
              <form method="POST" action="/event/<%= event.id %>/drill/<%= drill.id %>/delete" style="margin:0;">
                <button type="submit" class="btn-sm btn-sm-remove" title="Remove">&times;</button>
              </form>
            </div>
            <% }); %>
          </div>
          <% } %>
        </div>
        <% } %>
      </div>
      <% } %>

      <!-- ============ TOURNAMENT SUB-EVENTS ============ -->
      <% if (event.event_type === 'tournament') { %>
      <div class="ed-section">
        <h3 class="ed-section-title">Tournament Schedule</h3>

        <% if (subEvents.length > 0) { %>
        <div class="sub-events-list">
          <% subEvents.forEach(se => { %>
          <div class="sub-event-card" id="sub-<%= se.id %>">
            <div class="sub-event-header">
              <span class="sub-event-type sub-type-<%= se.sub_type %>"><%= se.sub_type === 'game' ? 'Game' : se.sub_type === 'practice' ? 'Practice' : se.sub_type === 'meeting' ? 'Meeting' : 'Other' %></span>
              <span class="sub-event-title"><%= se.title %></span>
              <% if (se.opponent) { %><span class="sub-event-vs">vs <%= se.opponent %></span><% } %>
            </div>
            <div class="sub-event-details">
              <% if (se.start_date) { %>
                <span><%= new Date(se.start_date + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %></span>
              <% } %>
              <% if (se.start_time) { const [sh,sm] = se.start_time.split(':'); const shr = parseInt(sh); %>
                <span><%= (shr % 12 || 12) + ':' + sm + ' ' + (shr >= 12 ? 'PM' : 'AM') %><% if (se.end_time) { const [eh,em] = se.end_time.split(':'); const ehr = parseInt(eh); %> &ndash; <%= (ehr % 12 || 12) + ':' + em + ' ' + (ehr >= 12 ? 'PM' : 'AM') %><% } %></span>
              <% } %>
              <% if (se.location_name) { %><span><%= se.location_name %></span><% } %>
            </div>
            <% if (se.notes) { %><div class="sub-event-notes"><%= se.notes %></div><% } %>

            <% if (se.sub_type === 'game') { %>
              <% const seLineup = subLineups[se.id] || []; %>
              <% if (seLineup.length > 0) { %>
              <div class="lineup-section">
                <h5 class="lineup-title">Lineup<% if (se.batting_all) { %> <span style="font-weight:400; color:var(--gray-500);">(Batting All)</span><% } %></h5>
                <table class="lineup-table">
                  <thead><tr><th>#</th><th>Player</th><th>Pos</th><th>Role</th></tr></thead>
                  <tbody>
                    <% seLineup.forEach(l => { %>
                    <tr class="<%= l.is_starter ? '' : 'lineup-bench' %>">
                      <td><%= l.batting_order || '-' %></td>
                      <td><%= l.player_name %></td>
                      <td><%= l.position || '-' %></td>
                      <td><%= l.is_starter ? 'Starter' : 'Bench' %></td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
              <% } %>

              <% if (isAdmin) { %>
              <details class="ed-admin-details">
                <summary>Manage Lineup</summary>
                <form method="POST" action="/event/<%= event.id %>/sub-event/<%= se.id %>/lineup" class="lineup-form">
                  <label style="display:flex; align-items:center; gap:6px; margin-bottom:10px; font-size:13px;">
                    <input type="checkbox" name="batting_all" value="1" <%= se.batting_all ? 'checked' : '' %>> Batting everyone
                  </label>
                  <table class="lineup-edit-table">
                    <thead><tr><th>Order</th><th>Player</th><th>Position</th><th>Start</th></tr></thead>
                    <tbody>
                      <% const sePlayers = confirmedPlayers; const seExisting = subLineups[se.id] || []; %>
                      <% sePlayers.forEach((p, i) => { const ex = seExisting.find(l => l.player_id === p.id); %>
                      <tr>
                        <td><input type="number" name="batting_order" value="<%= ex ? ex.batting_order : (i+1) %>" min="1" style="width:50px;" class="form-input"></td>
                        <td><%= p.player_name %><input type="hidden" name="player_id" value="<%= p.id %>"></td>
                        <td><select name="position" class="form-input" style="width:70px;">
                          <option value="">—</option>
                          <% POSITIONS.forEach(pos => { %><option value="<%= pos %>" <%= ex && ex.position === pos ? 'selected' : '' %>><%= pos %></option><% }); %>
                        </select></td>
                        <td><input type="checkbox" name="is_starter" value="<%= p.id %>" <%= !ex || ex.is_starter ? 'checked' : '' %>></td>
                      </tr>
                      <% }); %>
                    </tbody>
                  </table>
                  <button type="submit" class="btn btn-confirm" style="margin-top:8px;">Save Lineup</button>
                </form>
              </details>
              <% } %>
            <% } %>

            <% if (isAdmin) { %>
            <div style="margin-top:8px; display:flex; gap:6px;">
              <form method="POST" action="/event/<%= event.id %>/sub-event/<%= se.id %>/delete" style="margin:0;" onsubmit="return confirm('Remove this sub-event?')">
                <button type="submit" class="btn-sm btn-sm-remove">&times; Remove</button>
              </form>
            </div>
            <% } %>
          </div>
          <% }); %>
        </div>
        <% } else if (!isAdmin) { %>
          <p style="color:var(--gray-500); font-size:14px;">Tournament schedule not posted yet.</p>
        <% } %>

        <% if (isAdmin) { %>
        <div class="ed-admin-section">
          <h4 class="ed-admin-title">Add Sub-Event</h4>
          <form method="POST" action="/event/<%= event.id %>/sub-event" class="sub-event-form">
            <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:8px;">
              <select name="sub_type" class="form-input" style="width:110px;">
                <option value="game">Game</option>
                <option value="practice">Practice</option>
                <option value="meeting">Meeting</option>
                <option value="other">Other</option>
              </select>
              <input type="text" name="title" placeholder="Title (e.g. Game 1)" required class="form-input" style="flex:1; min-width:120px;">
              <input type="text" name="opponent" placeholder="Opponent" class="form-input" style="width:140px;">
            </div>
            <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:8px;">
              <input type="date" name="start_date" value="<%= event.start_date %>" class="form-input" style="width:150px;">
              <input type="time" name="start_time" class="form-input" style="width:120px;">
              <input type="time" name="end_time" class="form-input" style="width:120px;">
              <input type="text" name="location_name" placeholder="Field / Location" class="form-input" style="flex:1; min-width:120px;">
            </div>
            <input type="text" name="notes" placeholder="Notes (optional)" class="form-input" style="margin-bottom:8px;">
            <button type="submit" class="btn btn-confirm">Add Sub-Event</button>
          </form>
        </div>
        <% } %>
      </div>
      <% } %>

      <!-- ============ GAME LINEUP (admin only) ============ -->
      <% if (event.event_type === 'game' && isAdmin) { %>
      <div class="ed-section lineup-grid-section" id="lineup-grid-section">
        <h3 class="ed-section-title">Game Lineup</h3>
        <div class="lg-legend">1=P 2=C 3=1B 4=2B 5=3B 6=SS 7=LF 8=CF 9=RF &middot; X=Sit &middot; Y=Sub In</div>

        <div class="lg-wrap">
          <table class="lg-table" id="lg-table">
            <thead>
              <tr>
                <th class="lg-th-order">#</th>
                <th class="lg-th-name">Player</th>
                <th class="lg-th-inn">1st</th>
                <th class="lg-th-inn">2nd</th>
                <th class="lg-th-inn">3rd</th>
                <th class="lg-th-inn">4th</th>
                <th class="lg-th-inn">5th</th>
                <th class="lg-th-inn">6th</th>
                <th class="lg-th-sit">Sit</th>
              </tr>
            </thead>
            <tbody id="lg-body"></tbody>
          </table>
        </div>

        <div class="lg-validation" id="lg-validation"></div>

        <% if (isAdmin) { %>
        <div class="lg-controls">
          <button type="button" class="btn btn-confirm" onclick="saveLineupGrid()">Save Lineup</button>
          <button type="button" class="btn" onclick="printLineup()" style="margin-left:8px;">Print Lineup Card</button>
          <button type="button" class="btn" onclick="clearEntireLineup()" style="margin-left:8px; background:#dc2626; color:white;">Clear All</button>
          <span class="lg-save-msg" id="lg-save-msg"></span>
        </div>
        <div class="lg-add-player" id="lg-add-player">
          <select id="lg-player-select" class="form-input">
            <option value="">+ Add player to lineup...</option>
          </select>
        </div>
        <% } %>

        <!-- Print-only field diagram -->
        <div class="lg-print-field" id="lg-print-field">
          <svg viewBox="0 0 300 280" xmlns="http://www.w3.org/2000/svg" style="width:260px;">
            <polygon points="150,30 270,140 150,250 30,140" fill="none" stroke="#555" stroke-width="1.5"/>
            <line x1="150" y1="30" x2="150" y2="250" stroke="#ccc" stroke-width="0.5" stroke-dasharray="4"/>
            <line x1="30" y1="140" x2="270" y2="140" stroke="#ccc" stroke-width="0.5" stroke-dasharray="4"/>
            <circle cx="150" cy="30" r="14" fill="#1e40af" opacity="0.9"/><text x="150" y="34" text-anchor="middle" fill="white" font-size="10" font-weight="bold">CF-8</text>
            <circle cx="70" cy="80" r="14" fill="#1e40af" opacity="0.9"/><text x="70" y="84" text-anchor="middle" fill="white" font-size="10" font-weight="bold">LF-7</text>
            <circle cx="230" cy="80" r="14" fill="#1e40af" opacity="0.9"/><text x="230" y="84" text-anchor="middle" fill="white" font-size="10" font-weight="bold">RF-9</text>
            <circle cx="110" cy="130" r="14" fill="#16a34a" opacity="0.9"/><text x="110" y="134" text-anchor="middle" fill="white" font-size="10" font-weight="bold">SS-6</text>
            <circle cx="190" cy="130" r="14" fill="#16a34a" opacity="0.9"/><text x="190" y="134" text-anchor="middle" fill="white" font-size="10" font-weight="bold">2B-4</text>
            <circle cx="80" cy="175" r="14" fill="#16a34a" opacity="0.9"/><text x="80" y="179" text-anchor="middle" fill="white" font-size="10" font-weight="bold">3B-5</text>
            <circle cx="220" cy="175" r="14" fill="#16a34a" opacity="0.9"/><text x="220" y="179" text-anchor="middle" fill="white" font-size="10" font-weight="bold">1B-3</text>
            <circle cx="150" cy="190" r="14" fill="#dc2626" opacity="0.9"/><text x="150" y="194" text-anchor="middle" fill="white" font-size="10" font-weight="bold">P-1</text>
            <circle cx="150" cy="240" r="14" fill="#dc2626" opacity="0.9"/><text x="150" y="244" text-anchor="middle" fill="white" font-size="10" font-weight="bold">C-2</text>
          </svg>
        </div>
      </div>

      <script>
      (function() {
        const POS_MAP = {1:'P',2:'C',3:'1B',4:'2B',5:'3B',6:'SS',7:'LF',8:'CF',9:'RF'};
        const INNINGS = 6;
        const isAdmin = <%= isAdmin ? 'true' : 'false' %>;
        const allPlayers = <%- JSON.stringify(confirmedPlayers.map(p => ({
          id: p.id, name: p.player_name,
          jersey: p.jersey_number || '',
          positions: (p.best_positions || '').split(',').filter(Boolean)
        }))) %>;
        const savedGrid = <%- JSON.stringify(lineupGrid) %>;

        let grid = []; // [{playerId, name, positions, cells: [null or {pos, status}]}]

        function initGrid() {
          const playerMap = {};
          savedGrid.forEach(g => {
            if (!playerMap[g.player_id]) playerMap[g.player_id] = { order: g.batting_order, cells: {} };
            playerMap[g.player_id].cells[g.inning] = { pos: g.position_number, status: g.status };
          });
          const usedIds = new Set();
          const sorted = Object.entries(playerMap).sort((a,b) => a[1].order - b[1].order);
          sorted.forEach(([pid, data]) => {
            const p = allPlayers.find(x => x.id === Number(pid));
            if (!p) return;
            usedIds.add(p.id);
            const cells = [];
            for (let i = 1; i <= INNINGS; i++) {
              const c = data.cells[i];
              cells.push(c ? { pos: c.pos, status: c.status } : null);
            }
            grid.push({ playerId: p.id, name: p.name, jersey: p.jersey || '', positions: p.positions, cells });
          });
          if (grid.length === 0) {
            allPlayers.forEach(p => {
              grid.push({ playerId: p.id, name: p.name, jersey: p.jersey || '', positions: p.positions, cells: Array(INNINGS).fill(null) });
            });
          }
          renderGrid();
          updateAddSelect();
        }

        function isPositionFlagged(posNum, playerPositions) {
          if (!posNum || posNum >= 7) return false;
          if (!playerPositions || playerPositions.length === 0) return false;
          const posStr = POS_MAP[posNum];
          return !playerPositions.includes(posStr);
        }

        function renderGrid() {
          const body = document.getElementById('lg-body');
          body.innerHTML = '';
          grid.forEach((row, ri) => {
            const tr = document.createElement('tr');
            const orderTd = document.createElement('td');
            orderTd.className = 'lg-cell-order';
            orderTd.textContent = ri + 1;
            tr.appendChild(orderTd);

            const nameTd = document.createElement('td');
            nameTd.className = 'lg-cell-name';
            nameTd.innerHTML = (row.jersey ? '<span class="lg-jersey">' + row.jersey + '</span>' : '') + '<span class="lg-name-text">' + row.name + '</span>';
            if (isAdmin) {
              const clrBtn = document.createElement('button');
              clrBtn.className = 'lg-rm-btn';
              clrBtn.textContent = '⌫';
              clrBtn.title = 'Clear positions';
              clrBtn.style.marginRight = '2px';
              clrBtn.onclick = () => clearPlayerLineup(ri);
              nameTd.appendChild(clrBtn);
              const rmBtn = document.createElement('button');
              rmBtn.className = 'lg-rm-btn';
              rmBtn.textContent = '×';
              rmBtn.title = 'Remove from lineup';
              rmBtn.onclick = () => { grid.splice(ri, 1); renderGrid(); updateAddSelect(); };
              nameTd.appendChild(rmBtn);
            }
            if (row.positions.length > 0) {
              const posTag = document.createElement('span');
              posTag.className = 'lg-pos-tag';
              posTag.textContent = row.positions.join(',');
              nameTd.appendChild(posTag);
            }
            tr.appendChild(nameTd);

            let sitCount = 0;
            for (let inn = 0; inn < INNINGS; inn++) {
              const td = document.createElement('td');
              td.className = 'lg-cell';
              const cell = row.cells[inn];
              if (isAdmin) {
                const inp = document.createElement('input');
                inp.className = 'lg-inp';
                inp.maxLength = 1;
                inp.dataset.row = ri;
                inp.dataset.inn = inn;
                if (cell) {
                  if (cell.status === 'sit') { inp.value = 'X'; td.classList.add('lg-sit'); sitCount++; }
                  else if (cell.status === 'sub_in') { inp.value = 'Y'; td.classList.add('lg-sub'); }
                  else if (cell.pos) { inp.value = cell.pos; }
                }
                if (cell && cell.pos && isPositionFlagged(cell.pos, row.positions)) {
                  td.classList.add('lg-flagged');
                }
                inp.addEventListener('input', (e) => handleCellInput(e, ri, inn));
                inp.addEventListener('keydown', (e) => handleCellNav(e, ri, inn));
                td.appendChild(inp);
              } else {
                if (cell) {
                  if (cell.status === 'sit') { td.textContent = 'X'; td.classList.add('lg-sit'); sitCount++; }
                  else if (cell.status === 'sub_in') { td.textContent = 'Y'; td.classList.add('lg-sub'); }
                  else if (cell.pos) { td.textContent = cell.pos; }
                }
                if (cell && cell.pos && isPositionFlagged(cell.pos, row.positions)) {
                  td.classList.add('lg-flagged');
                }
              }
              tr.appendChild(td);
            }

            const sitTd = document.createElement('td');
            sitTd.className = 'lg-cell-sit';
            sitTd.textContent = sitCount;
            if (sitCount > 0) sitTd.style.fontWeight = '700';
            tr.appendChild(sitTd);

            body.appendChild(tr);
          });
          validateGrid();
        }

        function handleCellInput(e, ri, inn) {
          let v = e.target.value.toUpperCase();
          if (v === 'X') {
            grid[ri].cells[inn] = { pos: null, status: 'sit' };
          } else if (v === 'Y') {
            grid[ri].cells[inn] = { pos: null, status: 'sub_in' };
          } else if (/^[1-9]$/.test(v)) {
            grid[ri].cells[inn] = { pos: parseInt(v), status: 'field' };
          } else {
            grid[ri].cells[inn] = null;
            e.target.value = '';
          }
          renderGrid();
          const next = document.querySelector('.lg-inp[data-row="' + ri + '"][data-inn="' + inn + '"]');
          if (next) next.focus();
          if (v && /^[1-9XY]$/i.test(v)) {
            const nextInn = inn + 1;
            if (nextInn < INNINGS) {
              const nxt = document.querySelector('.lg-inp[data-row="' + ri + '"][data-inn="' + nextInn + '"]');
              if (nxt) nxt.focus();
            }
          }
        }

        function handleCellNav(e, ri, inn) {
          let nr = ri, ni = inn;
          if (e.key === 'ArrowRight' || e.key === 'Tab' && !e.shiftKey) {
            ni++; if (ni >= INNINGS) { ni = 0; nr++; }
          } else if (e.key === 'ArrowLeft' || e.key === 'Tab' && e.shiftKey) {
            ni--; if (ni < 0) { ni = INNINGS - 1; nr--; }
          } else if (e.key === 'ArrowDown') { nr++; }
          else if (e.key === 'ArrowUp') { nr--; }
          else return;
          if (nr < 0 || nr >= grid.length) return;
          e.preventDefault();
          const nxt = document.querySelector('.lg-inp[data-row="' + nr + '"][data-inn="' + ni + '"]');
          if (nxt) { nxt.focus(); nxt.select(); }
        }

        function validateGrid() {
          const el = document.getElementById('lg-validation');
          const msgs = [];
          for (let inn = 0; inn < INNINGS; inn++) {
            const positions = {};
            let fieldCount = 0;
            grid.forEach((row, ri) => {
              const cell = row.cells[inn];
              if (cell && cell.status === 'field' && cell.pos) {
                fieldCount++;
                if (positions[cell.pos]) positions[cell.pos].push(row.name);
                else positions[cell.pos] = [row.name];
              }
            });
            if (fieldCount > 0 && fieldCount !== 9) {
              msgs.push('Inning ' + (inn+1) + ': ' + fieldCount + ' fielders (need 9)');
            }
            Object.entries(positions).forEach(([pos, names]) => {
              if (names.length > 1) msgs.push('Inning ' + (inn+1) + ': ' + POS_MAP[pos] + ' assigned to ' + names.join(', '));
            });
          }
          el.innerHTML = msgs.map(m => '<div class="lg-val-err">' + m + '</div>').join('');
        }

        function updateAddSelect() {
          const sel = document.getElementById('lg-player-select');
          if (!sel) return;
          const used = new Set(grid.map(r => r.playerId));
          sel.innerHTML = '<option value="">+ Add player to lineup...</option>';
          allPlayers.filter(p => !used.has(p.id)).forEach(p => {
            sel.innerHTML += '<option value="' + p.id + '">' + p.name + '</option>';
          });
          sel.onchange = () => {
            const pid = Number(sel.value);
            if (!pid) return;
            const p = allPlayers.find(x => x.id === pid);
            if (p) {
              grid.push({ playerId: p.id, name: p.name, jersey: p.jersey || '', positions: p.positions, cells: Array(INNINGS).fill(null) });
              renderGrid();
              updateAddSelect();
            }
          };
        }

        window.saveLineupGrid = async function() {
          const entries = [];
          grid.forEach((row, ri) => {
            row.cells.forEach((cell, inn) => {
              if (cell) {
                entries.push({
                  player_id: row.playerId,
                  batting_order: ri + 1,
                  inning: inn + 1,
                  position_number: cell.pos || null,
                  status: cell.status
                });
              }
            });
          });
          const msgEl = document.getElementById('lg-save-msg');
          try {
            const r = await fetch('/event/<%= event.id %>/lineup-grid', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ entries })
            });
            const data = await r.json();
            if (data.ok) { msgEl.textContent = 'Saved!'; msgEl.style.color = '#16a34a'; }
            else { msgEl.textContent = 'Error saving'; msgEl.style.color = '#dc2626'; }
          } catch(e) { msgEl.textContent = 'Error saving'; msgEl.style.color = '#dc2626'; }
          setTimeout(() => msgEl.textContent = '', 3000);
        };

        window.printLineup = function() {
          window.print();
        };

        window.clearEntireLineup = function() {
          if (!confirm('Clear all lineup assignments? You will need to Save to persist.')) return;
          grid.forEach(row => { row.cells = Array(INNINGS).fill(null); });
          renderGrid();
        };

        window.clearPlayerLineup = function(ri) {
          grid[ri].cells = Array(INNINGS).fill(null);
          renderGrid();
        };

        initGrid();
      })();
      </script>
      <% } %>

      <!-- ============ RSVP ============ -->
      <div class="ed-section">
        <%
          const yesCount = rsvps.filter(r => r.status === 'yes').length;
          const noCount = rsvps.filter(r => r.status === 'no').length;
          const maybeCount = rsvps.filter(r => r.status === 'maybe').length;
          const notResponded = confirmedPlayers.length - rsvps.filter(r => r.status !== 'pending').length;
        %>
        <h3 class="ed-section-title">RSVP Status</h3>
        <div class="rsvp-counts">
          <div class="rsvp-count rsvp-count-yes"><span class="rsvp-count-num"><%= yesCount %></span> Attending</div>
          <div class="rsvp-count rsvp-count-maybe"><span class="rsvp-count-num"><%= maybeCount %></span> Maybe</div>
          <div class="rsvp-count rsvp-count-no"><span class="rsvp-count-num"><%= noCount %></span> Can't Make It</div>
          <div class="rsvp-count rsvp-count-pending"><span class="rsvp-count-num"><%= notResponded %></span> No Response</div>
        </div>

        <% if (parentUser) { %>
        <% const myRsvps = rsvps.filter(r => parentUser.player_ids && parentUser.player_ids.includes(r.player_id)); %>
        <% const myStatus = myRsvps.length > 0 ? myRsvps[0].status : null; %>
        <div class="rsvp-form-section">
          <% if (myStatus) { %>
          <div style="margin-bottom:12px; padding:10px 16px; border-radius:10px; background:<%= myStatus === 'yes' ? '#dcfce7' : myStatus === 'no' ? '#fee2e2' : '#fef9c3' %>; font-size:14px; font-weight:600; color:<%= myStatus === 'yes' ? '#166534' : myStatus === 'no' ? '#991b1b' : '#854d0e' %>;">
            You RSVP'd: <%= myStatus === 'yes' ? 'Attending' : myStatus === 'no' ? 'Not Attending' : 'Maybe' %>
          </div>
          <% } %>
          <h4 style="margin:0 0 8px; color:var(--navy); font-size:15px;"><%= myStatus ? 'Change RSVP' : 'RSVP for Your Player' %></h4>
          <form method="POST" action="/event/<%= event.id %>/rsvp" class="rsvp-phone-form">
            <div style="display:flex; gap:6px;">
              <button type="submit" name="status" value="yes" class="btn rsvp-btn-sm rsvp-yes">Yes</button>
              <button type="submit" name="status" value="maybe" class="btn rsvp-btn-sm rsvp-maybe">Maybe</button>
              <button type="submit" name="status" value="no" class="btn rsvp-btn-sm rsvp-no">No</button>
            </div>
          </form>
        </div>
        <% } else { %>
        <div class="rsvp-form-section">
          <h4 style="margin:0 0 8px; color:var(--navy); font-size:15px;">RSVP for Your Player</h4>
          <form method="POST" action="/event/<%= event.id %>/rsvp" class="rsvp-phone-form">
            <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
              <div style="flex:1; min-width:180px;">
                <label style="font-size:12px; color:var(--gray-500); font-weight:600; display:block; margin-bottom:4px;">Your Phone Number</label>
                <input type="tel" name="phone" placeholder="(941) 555-1234" class="form-input" required style="margin:0;">
              </div>
              <div style="display:flex; gap:6px;">
                <button type="submit" name="status" value="yes" class="btn rsvp-btn-sm rsvp-yes">Yes</button>
                <button type="submit" name="status" value="maybe" class="btn rsvp-btn-sm rsvp-maybe">Maybe</button>
                <button type="submit" name="status" value="no" class="btn rsvp-btn-sm rsvp-no">No</button>
              </div>
            </div>
          </form>
        </div>
        <% } %>
      </div>
    </div>
  </main>

  <footer>
    <div class="container">
      <p>Summer 2026 Cal Ripken All-Stars &middot; Major Division</p>
    </div>
  </footer>
</body>
</html>
