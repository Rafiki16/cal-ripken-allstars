          </div>

          <% } %>
        </div>

        <% if (isAdmin && drills.length > 1) { %>
        <script>
        (function() {
          const list = document.getElementById('drill-list');
          if (!list) return;
          let dragEl = null;

          list.addEventListener('dragstart', function(e) {
            const card = e.target.closest('.drill-draggable');
            if (!card) return;
            dragEl = card;
            card.classList.add('drill-dragging');
            e.dataTransfer.effectAllowed = 'move';
          });

          list.addEventListener('dragend', function(e) {
            if (dragEl) dragEl.classList.remove('drill-dragging');
            document.querySelectorAll('.drill-drop-target').forEach(c => c.classList.remove('drill-drop-target'));
            dragEl = null;
          });

          list.addEventListener('dragover', function(e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            const card = e.target.closest('.drill-draggable');
            document.querySelectorAll('.drill-drop-target').forEach(c => c.classList.remove('drill-drop-target'));
            if (card && card !== dragEl) card.classList.add('drill-drop-target');
          });

          list.addEventListener('drop', function(e) {
            e.preventDefault();
            const target = e.target.closest('.drill-draggable');
            if (!target || !dragEl || target === dragEl) return;
            const cards = [...list.querySelectorAll('.drill-draggable')];
            const fromIdx = cards.indexOf(dragEl);
            const toIdx = cards.indexOf(target);
            if (fromIdx < toIdx) target.after(dragEl);
            else target.before(dragEl);
            renumber();
            saveOrder();
          });

          function renumber() {
            list.querySelectorAll('.drill-draggable').forEach((c, i) => {
              const num = c.querySelector('.drill-num');
              if (num) num.textContent = i + 1;
            });
          }

          function saveOrder() {
            const order = [...list.querySelectorAll('.drill-draggable')].map(c => Number(c.dataset.id));
            fetch('/event/<%= event.id %>/drill/reorder', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ order }),
            });
          }

          // Touch support
          let touchEl = null, touchClone = null, touchStartY = 0;
          list.addEventListener('touchstart', function(e) {
            const grip = e.target.closest('.drill-grip');
            if (!grip) return;
            touchEl = grip.closest('.drill-draggable');
            if (!touchEl) return;
            touchStartY = e.touches[0].clientY;
            touchClone = touchEl.cloneNode(true);
            touchClone.classList.add('drill-touch-ghost');
            touchClone.style.width = touchEl.offsetWidth + 'px';
            document.body.appendChild(touchClone);
            touchEl.classList.add('drill-dragging');
            e.preventDefault();
          }, { passive: false });

          document.addEventListener('touchmove', function(e) {
            if (!touchEl || !touchClone) return;
            e.preventDefault();
            const y = e.touches[0].clientY;
            touchClone.style.top = y - 20 + 'px';
            touchClone.style.left = touchEl.getBoundingClientRect().left + 'px';
            const target = document.elementFromPoint(e.touches[0].clientX, y);
            const card = target ? target.closest('.drill-draggable') : null;
            document.querySelectorAll('.drill-drop-target').forEach(c => c.classList.remove('drill-drop-target'));
            if (card && card !== touchEl) card.classList.add('drill-drop-target');
          }, { passive: false });

          document.addEventListener('touchend', function(e) {
            if (!touchEl) return;
            const dropTarget = document.querySelector('.drill-drop-target');
            if (dropTarget) {
              const cards = [...list.querySelectorAll('.drill-draggable')];
              const fromIdx = cards.indexOf(touchEl);
              const toIdx = cards.indexOf(dropTarget);
              if (fromIdx < toIdx) dropTarget.after(touchEl);
              else dropTarget.before(touchEl);
              renumber();
              saveOrder();
            }
            touchEl.classList.remove('drill-dragging');
            document.querySelectorAll('.drill-drop-target').forEach(c => c.classList.remove('drill-drop-target'));
            if (touchClone) { touchClone.remove(); touchClone = null; }
            touchEl = null;
          });
        })();
        </script>
        <% } %>

        <% if (isAdmin && drills.length > 0) { %>
        <script>
        (function() {
          const container = document.getElementById('block-sortable-container');
          if (!container) return;
          const eventId = container.dataset.eventId;
          let dragBlock = null;

          // Only drag from the handle
          container.addEventListener('mousedown', function(e) {
            const handle = e.target.closest('.drag-handle');
            if (!handle) return;
            const block = handle.closest('.drag-block');
            if (block) block.setAttribute('draggable', 'true');
          });
          container.addEventListener('mouseup', function() {
            container.querySelectorAll('.drag-block').forEach(b => b.removeAttribute('draggable'));
          });

          container.addEventListener('dragstart', function(e) {
            const block = e.target.closest('.drag-block');
            if (!block) return;
            dragBlock = block;
            block.style.opacity = '0.4';
            e.dataTransfer.effectAllowed = 'move';
          });

          container.addEventListener('dragend', function() {
            if (dragBlock) {
              dragBlock.style.opacity = '';
              dragBlock.removeAttribute('draggable');
            }
            container.querySelectorAll('.drag-block').forEach(b => {
              b.classList.remove('block-drop-above', 'block-drop-below');
            });
            dragBlock = null;
          });

          container.addEventListener('dragover', function(e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            const block = e.target.closest('.drag-block');
            container.querySelectorAll('.drag-block').forEach(b => {
              b.classList.remove('block-drop-above', 'block-drop-below');
            });
            if (block && block !== dragBlock) {
              const rect = block.getBoundingClientRect();
              const mid = rect.top + rect.height / 2;
              if (e.clientY < mid) block.classList.add('block-drop-above');
              else block.classList.add('block-drop-below');
            }
          });

          container.addEventListener('drop', function(e) {
            e.preventDefault();
            const target = e.target.closest('.drag-block');
            if (!target || !dragBlock || target === dragBlock) return;
            const rect = target.getBoundingClientRect();
            const mid = rect.top + rect.height / 2;
            if (e.clientY < mid) target.before(dragBlock);
            else target.after(dragBlock);
            saveBlockOrder();
          });

          // Touch support for blocks
          let touchBlock = null, touchGhost = null;
          container.addEventListener('touchstart', function(e) {
            const handle = e.target.closest('.drag-handle');
            if (!handle) return;
            touchBlock = handle.closest('.drag-block');
            if (!touchBlock) return;
            touchGhost = touchBlock.cloneNode(true);
            touchGhost.style.cssText = 'position:fixed;z-index:9999;opacity:0.8;pointer-events:none;width:' + touchBlock.offsetWidth + 'px;box-shadow:0 8px 24px rgba(0,0,0,0.2);border-radius:10px;';
            document.body.appendChild(touchGhost);
            touchBlock.style.opacity = '0.3';
            e.preventDefault();
          }, { passive: false });

          document.addEventListener('touchmove', function(e) {
            if (!touchBlock || !touchGhost) return;
            e.preventDefault();
            const y = e.touches[0].clientY;
            touchGhost.style.top = y - 30 + 'px';
            touchGhost.style.left = touchBlock.getBoundingClientRect().left + 'px';
            const el = document.elementFromPoint(e.touches[0].clientX, y);
            const target = el ? el.closest('.drag-block') : null;
            container.querySelectorAll('.drag-block').forEach(b => {
              b.classList.remove('block-drop-above', 'block-drop-below');
            });
            if (target && target !== touchBlock) {
              const rect = target.getBoundingClientRect();
              if (y < rect.top + rect.height / 2) target.classList.add('block-drop-above');
              else target.classList.add('block-drop-below');
            }
          }, { passive: false });

          document.addEventListener('touchend', function() {
            if (!touchBlock) return;
            const dropTarget = container.querySelector('.block-drop-above, .block-drop-below');
            if (dropTarget) {
              if (dropTarget.classList.contains('block-drop-above')) dropTarget.before(touchBlock);
              else dropTarget.after(touchBlock);
              saveBlockOrder();
            }
            touchBlock.style.opacity = '';
            container.querySelectorAll('.drag-block').forEach(b => {
              b.classList.remove('block-drop-above', 'block-drop-below');
            });
            if (touchGhost) { touchGhost.remove(); touchGhost = null; }
            touchBlock = null;
          });

          function saveBlockOrder() {
            const order = [...container.querySelectorAll('.drag-block')].map(b => b.dataset.blockName);
            fetch('/event/' + eventId + '/drill/reorder-blocks', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ order }),
            }).then(r => { if (r.ok) location.reload(); });
          }
        })();
        </script>
        <% } %>

        <% } %>
      </div>
      <% } %>

