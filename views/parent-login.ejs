<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= teamName %></title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    .login-hero { text-align: center; padding: 40px 0 20px; }
    .login-hero .logo { font-size: 48px; margin-bottom: 8px; }
    .login-hero h1 { font-size: 26px; color: var(--navy); margin: 0; }
    .login-hero .sub { font-size: 14px; color: #6b7280; margin-top: 4px; }
    .login-box { max-width: 380px; margin: 0 auto; background: #fff; border: 1px solid #e5e7eb; border-radius: 16px; padding: 28px 24px; }
    .login-box h2 { font-size: 18px; color: var(--navy); margin: 0 0 16px; text-align: center; }
    .login-box .form-group { margin-bottom: 14px; }
    .login-box label { font-size: 13px; font-weight: 600; color: #374151; display: block; margin-bottom: 4px; }
    .login-box .form-input { width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 15px; box-sizing: border-box; }
    .login-box .btn-primary { width: 100%; padding: 12px; font-size: 16px; font-weight: 700; }
    .login-footer { text-align: center; margin-top: 20px; font-size: 13px; color: #6b7280; }
    .login-footer a { color: var(--navy); font-weight: 600; }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <div class="header-content">
        <div class="header-text">
          <div class="logo">&#9918;</div>
          <div>
            <h1><%= teamName %></h1>
            <p class="subtitle">Summer 2026 &middot; Major Division</p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="container">
    <% if (success) { %>
      <div class="alert" style="background:#dcfce7;color:#166534;border:1px solid #bbf7d0;padding:12px;border-radius:8px;margin-bottom:16px;text-align:center;"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="login-hero">
      <p class="sub">Sign in to view the schedule, RSVPs, lineups, and more.</p>
    </div>

    <div class="login-box">
      <h2>Parent Login</h2>
      <form method="POST" action="/parent/login">
        <div class="form-group">
          <label>Username or Phone Number</label>
          <input type="text" name="login_id" required class="form-input" placeholder="Username or (941) 555-1234" autocomplete="username">
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" required class="form-input" placeholder="Your password">
        </div>
        <button type="submit" class="btn btn-primary">Sign In</button>
      </form>
      <p style="text-align:center;margin-top:12px;"><a href="/forgot-password?type=parent" style="color:#6b7280;font-size:13px;">Forgot password?</a></p>
    </div>

    <div class="login-footer">
      <p>First time here? <a href="/verify">Look up your player by phone</a></p>
      <p>Not a parent? <a href="/fan/register">Register as a Fan</a></p>
      <p>Coach? <a href="/admin/login">Admin Login</a></p>
    </div>
  </main>

  <footer>
    <div class="container">
      <p>Summer 2026 <%= teamName %> &middot; Major Division</p>
    </div>
  </footer>
</body>
</html>
