<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Parent Login &middot; <%= teamName %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <div class="container">
      <div class="header-content">
        <a href="/" class="back-link">&larr; Back to Roster</a>
        <div class="header-text">
          <div class="logo">&#9918;</div>
          <div>
            <h1>Parent Login</h1>
            <p class="subtitle"><%= teamName %></p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="container">
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="verify-box">
      <h2>Log In</h2>
      <p>Use your registered phone number and the password you created.</p>
      <form method="POST" action="/parent/login">
        <div class="form-group">
          <label>Phone Number</label>
          <input type="tel" name="phone" required class="form-input" placeholder="(941) 555-1234" autocomplete="tel">
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" required class="form-input" placeholder="Your password">
        </div>
        <button type="submit" class="btn btn-primary">Log In</button>
      </form>
      <p style="margin-top:16px;font-size:13px;color:#6b7280;text-align:center;">
        Don't have an account? <a href="/verify" style="color:var(--navy);font-weight:600;">Verify with your phone number</a> first.
      </p>
    </div>
  </main>

  <footer>
    <div class="container">
      <p>Summer 2026 <%= teamName %> &middot; Major Division</p>
    </div>
  </footer>
</body>
</html>
