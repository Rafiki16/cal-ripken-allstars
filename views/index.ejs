<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Summer 2026 Cal Ripken All-Stars</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <div class="container">
      <div class="header-content">
        <div class="logo">&#9918;</div>
        <div>
          <h1>Cal Ripken All-Stars</h1>
          <p class="subtitle">Summer 2026 &middot; Major Division</p>
        </div>
      </div>
    </div>
  </header>

  <main class="container">
    <div class="cta-section">
      <a href="/verify" class="btn btn-primary btn-large">Confirm Your Player</a>
      <p class="cta-hint">Parents: verify your child's participation using your registered phone number</p>
    </div>

    <h2 class="section-title">Roster</h2>

    <div class="roster-section">
      <div class="roster-grid">
        <% players.filter(p => p.status !== 'declined').forEach(player => { %>
          <div class="player-card">
            <% if (player.status === 'pending') { %>
              <div class="player-status-badge badge-pending">Pending</div>
            <% } %>
            <h3 class="player-name"><%= player.player_name %></h3>
            <div class="player-details">
              <span class="player-team"><%= player.team %></span>
              <span class="player-age">Age <%= player.age %></span>
            </div>
            <% if (player.best_positions) { %>
              <div class="player-positions-mini"><%- player.best_positions.split(',').join(' &middot; ') %></div>
            <% } %>
            <% if (player.profile_updated_at) { %>
              <div class="profile-badge-mini">Profile Complete</div>
            <% } %>
          </div>
        <% }); %>
      </div>
    </div>

    <% if (teamEvents.length > 0) { %>
    <h2 class="section-title" style="margin-top:40px;">Schedule</h2>

    <div class="calendar-section">
      <div class="cal-header">
        <button class="cal-nav" id="calPrev">&larr;</button>
        <h3 class="cal-month" id="calMonth"></h3>
        <button class="cal-nav" id="calNext">&rarr;</button>
      </div>
      <div class="cal-grid">
        <div class="cal-day-label">Sun</div>
        <div class="cal-day-label">Mon</div>
        <div class="cal-day-label">Tue</div>
        <div class="cal-day-label">Wed</div>
        <div class="cal-day-label">Thu</div>
        <div class="cal-day-label">Fri</div>
        <div class="cal-day-label">Sat</div>
        <div id="calCells"></div>
      </div>
    </div>

    <h2 class="section-title" style="margin-top:32px;">Upcoming Events</h2>
    <div id="upcomingEvents" class="te-list"></div>
    <% } %>

    <script>
    (function() {
      var EVENTS = <%- JSON.stringify(teamEvents.map(e => ({
        id: e.id,
        type: e.event_type,
        title: e.title,
        start_date: e.start_date,
        start_time: e.start_time || null,
        end_date: e.end_date || null,
        end_time: e.end_time || null,
        location_name: e.location_name || null,
        address: e.address || null,
        notes: e.notes || null,
        hotel_info: e.hotel_info || null,
        carpool_info: e.carpool_info || null
      }))) %>;

      if (!EVENTS.length) return;

      var now = new Date();
      var calMonth = now.getMonth();
      var calYear = now.getFullYear();

      function renderCalendar() {
        var monthEl = document.getElementById('calMonth');
        var cellsEl = document.getElementById('calCells');
        var months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
        monthEl.textContent = months[calMonth] + ' ' + calYear;

        var first = new Date(calYear, calMonth, 1);
        var last = new Date(calYear, calMonth + 1, 0);
        var startDay = first.getDay();
        var totalDays = last.getDate();

        var today = new Date();
        var todayStr = today.getFullYear() + '-' + String(today.getMonth()+1).padStart(2,'0') + '-' + String(today.getDate()).padStart(2,'0');

        var eventDates = {};
        EVENTS.forEach(function(e) {
          var d = e.start_date;
          if (!eventDates[d]) eventDates[d] = [];
          eventDates[d].push(e);
        });

        var html = '';
        for (var i = 0; i < startDay; i++) {
          html += '<div class="cal-cell cal-empty"></div>';
        }
        for (var d = 1; d <= totalDays; d++) {
          var dateStr = calYear + '-' + String(calMonth+1).padStart(2,'0') + '-' + String(d).padStart(2,'0');
          var isToday = dateStr === todayStr;
          var hasEvent = eventDates[dateStr];
          html += '<div class="cal-cell' + (isToday ? ' cal-today' : '') + (hasEvent ? ' cal-has-event' : '') + '"';
          if (hasEvent) {
            html += ' onclick="scrollToEvent(\'' + dateStr + '\')" style="cursor:pointer"';
          }
          html += '>';
          html += '<span class="cal-date">' + d + '</span>';
          if (hasEvent) {
            hasEvent.forEach(function(ev) {
              var color = ev.type === 'practice' ? '#2563eb' : ev.type === 'game' ? '#16a34a' : ev.type === 'tournament' ? '#9333ea' : '#6b7280';
              html += '<div class="cal-event-dot" style="background:' + color + '" title="' + ev.title + '"></div>';
            });
          }
          html += '</div>';
        }
        cellsEl.innerHTML = html;
      }

      function formatTime(t) {
        if (!t) return '';
        var parts = t.split(':');
        var h = parseInt(parts[0]);
        var m = parts[1];
        return (h % 12 || 12) + ':' + m + ' ' + (h >= 12 ? 'PM' : 'AM');
      }

      function renderEvents() {
        var container = document.getElementById('upcomingEvents');
        if (!container) return;
        var today = new Date();
        today.setHours(0,0,0,0);
        var upcoming = EVENTS.filter(function(e) {
          return new Date(e.start_date + 'T23:59:59') >= today;
        }).sort(function(a, b) {
          return a.start_date.localeCompare(b.start_date);
        });

        if (!upcoming.length) {
          container.innerHTML = '<p style="color:var(--gray-500);text-align:center;padding:20px;">No upcoming events</p>';
          return;
        }

        var html = '';
        upcoming.forEach(function(ev) {
          var typeColors = { practice: '#2563eb', game: '#16a34a', tournament: '#9333ea' };
          var color = typeColors[ev.type] || '#6b7280';
          var typeLabel = ev.type.charAt(0).toUpperCase() + ev.type.slice(1);
          var dateObj = new Date(ev.start_date + 'T12:00:00');
          var dateStr = dateObj.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
          if (ev.end_date) {
            var endObj = new Date(ev.end_date + 'T12:00:00');
            dateStr += ' – ' + endObj.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
          }

          html += '<a href="/event/' + ev.id + '" class="te-card" data-date="' + ev.start_date + '" style="text-decoration:none;color:inherit;">';
          html += '<div class="te-type-badge" style="background:' + color + '20;color:' + color + '">' + typeLabel + '</div>';
          html += '<div class="te-title">' + ev.title + '</div>';
          html += '<div class="te-meta">' + dateStr;
          if (ev.start_time) html += ' at ' + formatTime(ev.start_time);
          html += '</div>';
          if (ev.location_name) html += '<div class="te-meta">' + ev.location_name + '</div>';
          html += '</a>';
        });

        container.innerHTML = html;
      }

      window.scrollToEvent = function(dateStr) {
        var card = document.querySelector('.te-card[data-date="' + dateStr + '"]');
        if (card) card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      };

      document.getElementById('calPrev').addEventListener('click', function() {
        calMonth--;
        if (calMonth < 0) { calMonth = 11; calYear--; }
        renderCalendar();
      });
      document.getElementById('calNext').addEventListener('click', function() {
        calMonth++;
        if (calMonth > 11) { calMonth = 0; calYear++; }
        renderCalendar();
      });

      renderCalendar();
      renderEvents();
    })();
    </script>
  </main>

  <footer>
    <div class="container">
      <p>Summer 2026 Cal Ripken All-Stars &middot; Major Division</p>
      <p style="margin-top:8px;"><a href="/admin/login" style="color:#9ca3af;font-size:13px;">Admin</a></p>
    </div>
  </footer>
</body>
</html>
