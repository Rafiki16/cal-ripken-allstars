<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= teamName %></title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    .login-hero { text-align: center; padding: 40px 0 20px; }
    .login-hero .logo { font-size: 48px; margin-bottom: 8px; }
    .login-hero h1 { font-size: 26px; color: var(--navy); margin: 0; }
    .login-hero .sub { font-size: 14px; color: #6b7280; margin-top: 4px; line-height: 1.5; }
    .login-box { max-width: 420px; margin: 0 auto; background: #fff; border: 1px solid #e5e7eb; border-radius: 16px; padding: 28px 24px; }
    .login-box h2 { font-size: 18px; color: var(--navy); margin: 0 0 16px; text-align: center; }
    .login-box .form-group { margin-bottom: 14px; }
    .login-box label { font-size: 13px; font-weight: 600; color: #374151; display: block; margin-bottom: 4px; }
    .login-box .form-input { width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 15px; box-sizing: border-box; }
    .login-box select.form-input { appearance: auto; }
    .login-box .btn-primary { width: 100%; padding: 12px; font-size: 16px; font-weight: 700; }
    .login-footer { text-align: center; margin-top: 20px; font-size: 13px; color: #6b7280; }
    .login-footer a { color: var(--navy); font-weight: 600; }
    .safety-note { max-width: 420px; margin: 16px auto 0; text-align: center; font-size: 12px; color: #9ca3af; line-height: 1.5; }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <div class="header-content">
        <div class="header-text">
          <div class="logo">&#9918;</div>
          <div>
            <h1><%= teamName %></h1>
            <p class="subtitle">Summer 2026 &middot; Major Division</p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="container">
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="login-hero">
      <p class="sub">Register as a fan to follow a player's schedule.<br>Fan accounts require admin approval for player safety.</p>
    </div>

    <div class="login-box">
      <h2>Fan Registration</h2>
      <form method="POST" action="/fan/register">
        <div class="form-group">
          <label>Your Name</label>
          <input type="text" name="display_name" required class="form-input" placeholder="First and Last Name">
        </div>
        <div class="form-group">
          <label>Phone Number</label>
          <input type="tel" name="phone" required class="form-input" placeholder="(941) 555-1234" autocomplete="tel">
        </div>
        <div class="form-group">
          <label>Which player are you following?</label>
          <select name="player_id" required class="form-input">
            <option value="">Select a player...</option>
            <% players.forEach(p => { %>
              <option value="<%= p.id %>"><%= p.player_name %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" required class="form-input" placeholder="At least 6 characters" minlength="6">
        </div>
        <div class="form-group">
          <label>Confirm Password</label>
          <input type="password" name="confirm_password" required class="form-input" placeholder="Confirm your password">
        </div>
        <button type="submit" class="btn btn-primary">Request Fan Access</button>
      </form>
    </div>

    <p class="safety-note">Fan accounts can only view the team schedule. A team administrator must approve your request before you can access any information.</p>

    <div class="login-footer">
      <p>Already have an account? <a href="/parent/login">Sign In</a></p>
      <p>Parent? <a href="/verify">Parent Registration</a></p>
    </div>
  </main>

  <footer>
    <div class="container">
      <p>Summer 2026 <%= teamName %> &middot; Major Division</p>
    </div>
  </footer>
</body>
</html>
