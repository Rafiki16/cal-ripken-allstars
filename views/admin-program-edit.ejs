<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title>Edit: <%= program.title %> &middot; Admin &middot; <%= teamName %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <div class="container">
      <div class="header-content">
        <a href="/admin/programs" class="back-link">&larr; Back to Programs</a>
        <div class="header-text">
          <div class="logo">&#9918;</div>
          <div>
            <h1>Edit Program</h1>
            <p class="subtitle"><%= program.title %></p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="container">
    <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div style="margin:24px 0; padding:20px; background:#fff; border:1px solid var(--gray-200); border-radius:12px;">
      <h3 style="font-size:15px; font-weight:700; color:var(--navy); margin:0 0 16px;">Program Details</h3>
      <form method="POST" action="/admin/programs/<%= program.id %>/update">
        <div style="display:flex; flex-direction:column; gap:12px;">
          <div>
            <label style="font-size:12px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:4px;">Title *</label>
            <input type="text" name="title" value="<%= program.title %>" required class="form-input" style="width:100%;">
          </div>
          <div>
            <label style="font-size:12px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:4px;">Description</label>
            <textarea name="description" class="form-input" rows="2" style="width:100%; resize:vertical;"><%= program.description || '' %></textarea>
          </div>
          <div style="display:flex; gap:12px; flex-wrap:wrap;">
            <div style="flex:1; min-width:140px;">
              <label style="font-size:12px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:4px;">Author</label>
              <input type="text" name="author" value="<%= program.author || '' %>" class="form-input" style="width:100%;">
            </div>
            <div style="flex:1; min-width:140px;">
              <label style="font-size:12px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:4px;">Type</label>
              <select name="program_type" class="form-input" style="width:100%;">
                <option value="at_home" <%= program.program_type === 'at_home' ? 'selected' : '' %>>At Home Program</option>
                <option value="practice_template" <%= program.program_type === 'practice_template' ? 'selected' : '' %>>Practice Template</option>
              </select>
            </div>
            <div style="flex:1; min-width:140px;">
              <label style="font-size:12px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:4px;">Schedule</label>
              <select name="schedule_type" class="form-input" style="width:100%;">
                <option value="weekly" <%= program.schedule_type === 'weekly' ? 'selected' : '' %>>Weekly</option>
                <option value="sequential" <%= program.schedule_type === 'sequential' ? 'selected' : '' %>>Sequential</option>
              </select>
            </div>
          </div>
          <div style="display:flex; align-items:center; gap:12px;">
            <label style="display:flex; align-items:center; gap:8px; font-size:13px; font-weight:600; color:var(--navy); cursor:pointer;">
              <input type="hidden" name="published" value="0">
              <input type="checkbox" name="published" value="1" <%= program.published ? 'checked' : '' %> style="width:18px; height:18px;"> Published
            </label>
            <span style="font-size:11px; color:var(--gray-400);">Published programs are visible to parents</span>
          </div>
          <div style="display:flex; gap:8px;">
            <button type="submit" class="btn btn-confirm" style="align-self:flex-start;">Save Changes</button>
            <% if (program.published) { %>
            <a href="/programs/<%= program.id %>" class="btn btn-secondary" style="text-decoration:none;">View Public Page</a>
            <% } %>
          </div>
        </div>
      </form>
    </div>

    <div style="margin:24px 0; padding:20px; background:#fff; border:1px solid var(--gray-200); border-radius:12px;">
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
        <h3 id="days-section" style="font-size:15px; font-weight:700; color:var(--navy); margin:0;">Days</h3>
        <form method="POST" action="/admin/programs/<%= program.id %>/day" style="display:flex; gap:8px; align-items:end;">
          <input type="text" name="day_label" placeholder="<%= program.schedule_type === 'weekly' ? 'e.g. Monday' : 'e.g. Day ' + (days.length + 1) %>" class="form-input" style="width:140px; font-size:13px;">
          <button type="submit" class="btn btn-confirm" style="font-size:12px; padding:6px 12px; white-space:nowrap;">+ Add Day</button>
        </form>
      </div>

      <% if (days.length === 0) { %>
      <p style="color:var(--gray-500); font-size:13px;">No days added yet. Add one above to start building the program.</p>
      <% } %>

      <% days.forEach((day, dayIdx) => { %>
      <div id="day-<%= day.id %>" style="margin-bottom:20px; border:1px solid var(--gray-200); border-radius:10px; overflow:hidden;">
        <div style="background:var(--gray-50); padding:10px 14px; display:flex; align-items:center; gap:8px; border-bottom:1px solid var(--gray-200);">
          <form method="POST" action="/admin/programs/<%= program.id %>/day/<%= day.id %>/update" style="display:flex; align-items:center; gap:8px; flex:1;">
            <input type="text" name="day_label" value="<%= day.day_label %>" class="form-input" style="font-size:13px; font-weight:700; width:120px; padding:4px 8px;">
            <input type="hidden" name="day_number" value="<%= day.day_number %>">
            <input type="hidden" name="sort_order" value="<%= day.sort_order %>">
            <button type="submit" class="btn btn-secondary" style="font-size:11px; padding:3px 8px;">Rename</button>
          </form>
          <form method="POST" action="/admin/programs/<%= program.id %>/day/<%= day.id %>/delete" style="margin:0;" onsubmit="return confirm('Delete this day and all its activities?')">
            <button type="submit" class="btn btn-secondary" style="font-size:11px; padding:3px 8px; color:#dc2626;">Delete Day</button>
          </form>
        </div>

        <div style="padding:12px 14px;">
          <% if (day.activities.length > 0) { %>
          <% day.activities.forEach((act, actIdx) => { %>
          <details style="margin-bottom:8px; border:1px solid var(--gray-100); border-radius:8px; overflow:hidden;">
            <summary style="padding:8px 12px; cursor:pointer; font-size:13px; font-weight:600; background:#fff; display:flex; align-items:center; gap:8px;">
              <span style="color:var(--gray-400); font-size:11px; min-width:20px;"><%= actIdx + 1 %>.</span>
              <span style="flex:1;"><%= act.activity_name %></span>
              <% if (act.link_url) { %>
              <a href="<%= act.link_url %>" target="_blank" rel="noopener" onclick="event.stopPropagation();" style="font-size:11px; color:#2563eb; font-weight:400; text-decoration:none;">&#9654; Video</a>
              <% } %>
              <% if (act.reps) { %>
              <span style="font-size:11px; color:var(--gray-400); font-weight:400;"><%= act.reps %></span>
              <% } %>
            </summary>
            <div style="padding:12px; border-top:1px solid var(--gray-100); background:var(--gray-50);">
              <form method="POST" action="/admin/programs/<%= program.id %>/activity/<%= act.id %>/update">
                <input type="hidden" name="program_day_id" value="<%= day.id %>">
                <div style="display:flex; flex-direction:column; gap:8px;">
                  <div style="display:flex; gap:8px; flex-wrap:wrap;">
                    <div style="flex:2; min-width:150px;">
                      <label style="font-size:11px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:2px;">Name</label>
                      <input type="text" name="activity_name" value="<%= act.activity_name %>" class="form-input" style="width:100%; font-size:12px; padding:6px 8px;">
                    </div>
                    <div style="width:100px;">
                      <label style="font-size:11px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:2px;">Reps/Duration</label>
                      <input type="text" name="reps" value="<%= act.reps || '' %>" placeholder="e.g. 3x10" class="form-input" style="width:100%; font-size:12px; padding:6px 8px;">
                    </div>
                  </div>
                  <div>
                    <label style="font-size:11px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:2px;">Description</label>
                    <textarea name="description" class="form-input" rows="2" style="width:100%; font-size:12px; padding:6px 8px; resize:vertical;"><%= act.description || '' %></textarea>
                  </div>
                  <div>
                    <label style="font-size:11px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:2px;">Instructions</label>
                    <textarea name="instructions" class="form-input" rows="3" style="width:100%; font-size:12px; padding:6px 8px; resize:vertical;"><%= act.instructions || '' %></textarea>
                  </div>
                  <div>
                    <label style="font-size:11px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:2px;">Link (YouTube, video, etc.)</label>
                    <input type="url" name="link_url" value="<%= act.link_url || '' %>" placeholder="https://youtube.com/watch?v=..." class="form-input" style="width:100%; font-size:12px; padding:6px 8px;">
                  </div>
                  <input type="hidden" name="sort_order" value="<%= act.sort_order %>">
                  <div style="display:flex; gap:8px;">
                    <button type="submit" class="btn btn-confirm" style="font-size:11px; padding:4px 10px;">Update</button>
                  </div>
                </div>
              </form>
              <form method="POST" action="/admin/programs/<%= program.id %>/activity/<%= act.id %>/delete" style="margin-top:8px; padding-top:8px; border-top:1px solid var(--gray-200);" onsubmit="return confirm('Delete this activity?')">
                <input type="hidden" name="program_day_id" value="<%= day.id %>">
                <button type="submit" class="btn btn-secondary" style="font-size:11px; padding:3px 8px; color:#dc2626;">Delete Activity</button>
              </form>
            </div>
          </details>
          <% }); %>
          <% } %>

          <div style="margin-top:8px; padding-top:8px; border-top:1px solid var(--gray-100);">
            <form method="POST" action="/admin/programs/<%= program.id %>/day/<%= day.id %>/activity" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
              <div style="flex:2; min-width:150px;">
                <label style="font-size:11px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:2px;">Activity Name</label>
                <input type="text" name="activity_name" placeholder="e.g. Tee Work" class="form-input" style="width:100%; font-size:12px; padding:6px 8px;">
              </div>
              <div style="width:90px;">
                <label style="font-size:11px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:2px;">Reps</label>
                <input type="text" name="reps" placeholder="e.g. 3x10" class="form-input" style="width:100%; font-size:12px; padding:6px 8px;">
              </div>
              <div style="flex:2; min-width:150px;">
                <label style="font-size:11px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:2px;">Link</label>
                <input type="url" name="link_url" placeholder="https://youtube.com/..." class="form-input" style="width:100%; font-size:12px; padding:6px 8px;">
              </div>
              <button type="submit" class="btn btn-secondary" style="font-size:11px; padding:6px 10px; white-space:nowrap;">+ Activity</button>
            </form>
          </div>
        </div>
      </div>
      <% }); %>
    </div>

    <!-- Equipment Section -->
    <div style="margin:24px 0; padding:20px; background:#fff; border:1px solid var(--gray-200); border-radius:12px;">
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
        <h3 style="font-size:15px; font-weight:700; color:var(--navy); margin:0;">Equipment Needed</h3>
      </div>
      <p style="font-size:12px; color:var(--gray-500); margin:0 0 16px;">List the gear players need for this program. Add buy links so parents can purchase items directly.</p>

      <% if (equipment.length > 0) { %>
      <div style="margin-bottom:16px;">
        <% equipment.forEach((eq, eqIdx) => { %>
        <details style="margin-bottom:6px; border:1px solid var(--gray-100); border-radius:8px; overflow:hidden;">
          <summary style="padding:10px 14px; cursor:pointer; font-size:13px; background:#fff; display:flex; align-items:center; gap:8px;">
            <span style="font-size:11px; font-weight:700; padding:1px 6px; border-radius:3px; <%= eq.is_required ? 'background:#fef2f2; color:#dc2626;' : 'background:#f0fdf4; color:#16a34a;' %>"><%= eq.is_required ? 'Required' : 'Optional' %></span>
            <span style="flex:1; font-weight:600;"><%= eq.item_name %></span>
            <% if (eq.buy_url) { %>
            <span style="font-size:11px; color:#3b82f6;">Has link</span>
            <% } %>
          </summary>
          <div style="padding:12px 14px; border-top:1px solid var(--gray-100); background:var(--gray-50);">
            <form method="POST" action="/admin/programs/<%= program.id %>/equipment/<%= eq.id %>/update">
              <div style="display:flex; flex-direction:column; gap:8px;">
                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                  <div style="flex:2; min-width:150px;">
                    <label style="font-size:11px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:2px;">Item Name</label>
                    <input type="text" name="item_name" value="<%= eq.item_name %>" class="form-input" style="width:100%; font-size:12px; padding:6px 8px;">
                  </div>
                  <div style="width:100px;">
                    <label style="font-size:11px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:2px;">Type</label>
                    <select name="is_required" class="form-input" style="width:100%; font-size:12px; padding:6px 8px;">
                      <option value="1" <%= eq.is_required ? 'selected' : '' %>>Required</option>
                      <option value="0" <%= !eq.is_required ? 'selected' : '' %>>Optional</option>
                    </select>
                  </div>
                </div>
                <div>
                  <label style="font-size:11px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:2px;">Buy Link (URL)</label>
                  <input type="url" name="buy_url" value="<%= eq.buy_url || '' %>" placeholder="https://www.amazon.com/..." class="form-input" style="width:100%; font-size:12px; padding:6px 8px;">
                </div>
                <input type="hidden" name="sort_order" value="<%= eq.sort_order %>">
                <div style="display:flex; gap:8px;">
                  <button type="submit" class="btn btn-confirm" style="font-size:11px; padding:4px 10px;">Update</button>
                </div>
              </div>
            </form>
            <form method="POST" action="/admin/programs/<%= program.id %>/equipment/<%= eq.id %>/delete" style="margin-top:8px; padding-top:8px; border-top:1px solid var(--gray-200);" onsubmit="return confirm('Remove this equipment item?')">
              <button type="submit" class="btn btn-secondary" style="font-size:11px; padding:3px 8px; color:#dc2626;">Remove</button>
            </form>
          </div>
        </details>
        <% }); %>
      </div>
      <% } else { %>
      <p style="color:var(--gray-400); font-size:13px; margin-bottom:12px;">No equipment added yet.</p>
      <% } %>

      <div style="padding-top:8px; border-top:1px solid var(--gray-100);">
        <form method="POST" action="/admin/programs/<%= program.id %>/equipment" style="display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
          <div style="flex:2; min-width:150px;">
            <label style="font-size:11px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:2px;">Item Name</label>
            <input type="text" name="item_name" placeholder="e.g. Training Bat" required class="form-input" style="width:100%; font-size:12px; padding:6px 8px;">
          </div>
          <div style="width:100px;">
            <label style="font-size:11px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:2px;">Type</label>
            <select name="is_required" class="form-input" style="width:100%; font-size:12px; padding:6px 8px;">
              <option value="1">Required</option>
              <option value="0">Optional</option>
            </select>
          </div>
          <div style="flex:2; min-width:180px;">
            <label style="font-size:11px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:2px;">Buy Link</label>
            <input type="url" name="buy_url" placeholder="https://..." class="form-input" style="width:100%; font-size:12px; padding:6px 8px;">
          </div>
          <button type="submit" class="btn btn-secondary" style="font-size:11px; padding:6px 10px; white-space:nowrap;">+ Add Equipment</button>
        </form>
      </div>
    </div>

    <%
      function fmtDate(d) {
        if (!d) return '';
        if (d instanceof Date) return d.toISOString().substring(0,10);
        return String(d).substring(0,10);
      }
      var commonStart = '';
      var commonEnd = '';
      if (assignments.length > 0) {
        var starts = assignments.map(function(a) { return fmtDate(a.start_date); }).filter(Boolean);
        var ends = assignments.map(function(a) { return fmtDate(a.end_date); }).filter(Boolean);
        if (starts.length > 0 && starts.every(function(s) { return s === starts[0]; })) commonStart = starts[0];
        if (ends.length > 0 && ends.every(function(s) { return s === ends[0]; })) commonEnd = ends[0];
      }
    %>

    <div style="margin:24px 0; padding:20px; background:#f0f9ff; border:1px solid #bae6fd; border-radius:12px;">
      <h3 style="font-size:15px; font-weight:700; color:var(--navy); margin:0 0 8px;">Program Date Range</h3>
      <p style="font-size:12px; color:var(--gray-500); margin:0 0 12px;">Set when this program is active. Dates apply to new assignments and can be applied to existing ones.</p>
      <div style="display:flex; gap:16px; flex-wrap:wrap; align-items:end;">
        <div>
          <label style="font-size:12px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:4px;">Start Date</label>
          <input type="date" id="program-start-date" value="<%= commonStart %>" style="padding:6px 10px; border:1px solid var(--gray-200); border-radius:6px; font-size:13px;">
        </div>
        <div>
          <label style="font-size:12px; font-weight:600; color:var(--gray-500); display:block; margin-bottom:4px;">End Date</label>
          <input type="date" id="program-end-date" value="<%= commonEnd %>" style="padding:6px 10px; border:1px solid var(--gray-200); border-radius:6px; font-size:13px;">
        </div>
        <% if (assignments.length > 0) { %>
        <form method="POST" action="/admin/programs/<%= program.id %>/set-all-dates" id="set-all-dates-form" style="margin:0;">
          <input type="hidden" name="start_date" id="bulk-start-date" value="<%= commonStart %>">
          <input type="hidden" name="end_date" id="bulk-end-date" value="<%= commonEnd %>">
          <button type="submit" class="btn btn-confirm" style="font-size:12px; padding:6px 14px;">Apply to All (<%= assignments.length %>)</button>
        </form>
        <% } %>
      </div>
    </div>

    <div style="margin:24px 0; padding:20px; background:#fff; border:1px solid var(--gray-200); border-radius:12px;">
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
        <h3 style="font-size:15px; font-weight:700; color:var(--navy); margin:0;">Position-Based Assignment</h3>
      </div>
      <p style="font-size:12px; color:var(--gray-500); margin:0 0 12px;">Select positions to auto-assign all confirmed players who play those positions.</p>
      <form method="POST" action="/admin/programs/<%= program.id %>/assign-positions">
        <input type="hidden" name="start_date" class="sync-start-date" value="<%= commonStart %>">
        <input type="hidden" name="end_date" class="sync-end-date" value="<%= commonEnd %>">
        <div style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:12px;">
          <% const currentPositions = (program.assigned_positions || '').split(',').filter(Boolean); %>
          <% POSITIONS.forEach(pos => { %>
          <label style="display:flex; align-items:center; gap:4px; font-size:13px; font-weight:600; cursor:pointer; padding:6px 10px; border:1px solid var(--gray-200); border-radius:8px; background:<%= currentPositions.includes(pos) ? '#e0f2fe' : '#fff' %>;">
            <input type="checkbox" name="positions" value="<%= pos %>" <%= currentPositions.includes(pos) ? 'checked' : '' %>> <%= pos %>
          </label>
          <% }); %>
        </div>
        <button type="submit" class="btn btn-confirm" style="font-size:12px; padding:6px 14px;">Save Positions & Assign Matching Players</button>
      </form>
      <div style="margin-top:12px; padding-top:12px; border-top:1px solid var(--gray-100);">
        <form method="POST" action="/admin/programs/<%= program.id %>/assign-all" style="display:inline;" onsubmit="return confirm('Assign ALL confirmed players to this program?')">
          <input type="hidden" name="start_date" class="sync-start-date" value="<%= commonStart %>">
          <input type="hidden" name="end_date" class="sync-end-date" value="<%= commonEnd %>">
          <button type="submit" class="btn btn-secondary" style="font-size:12px; padding:6px 14px;">Assign All Confirmed Players</button>
        </form>
      </div>
    </div>

    <div style="margin:24px 0; padding:20px; background:#fff; border:1px solid var(--gray-200); border-radius:12px;">
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
        <h3 style="font-size:15px; font-weight:700; color:var(--navy); margin:0;">Assignments</h3>
        <a href="/admin/programs/<%= program.id %>/dashboard" class="btn btn-primary" style="font-size:12px; padding:6px 14px; text-decoration:none;">View Dashboard</a>
      </div>

      <% if (assignments.length > 0) { %>
      <div style="margin-bottom:16px;">
        <% assignments.forEach(a => { %>
        <div style="display:flex; align-items:center; gap:8px; padding:6px 0; border-bottom:1px solid var(--gray-100); flex-wrap:wrap;">
          <span style="font-size:13px; font-weight:600; flex:1; min-width:120px;"><%= a.player_name %></span>
          <% if (a.start_date || a.end_date) { %>
          <span style="font-size:11px; color:var(--gray-400); background:var(--gray-50); padding:2px 8px; border-radius:4px;">
            <%= a.start_date ? fmtDate(a.start_date) : 'no start' %> &mdash; <%= a.end_date ? fmtDate(a.end_date) : 'no end' %>
          </span>
          <% } else { %>
          <span style="font-size:11px; color:var(--gray-300);">no dates</span>
          <% } %>
          <form method="POST" action="/admin/programs/<%= program.id %>/unassign/<%= a.player_id %>" style="margin:0;">
            <button type="submit" class="btn btn-secondary" style="font-size:11px; padding:2px 8px; color:#dc2626;">Remove</button>
          </form>
        </div>
        <% }); %>
      </div>
      <% } %>

      <form method="POST" action="/admin/programs/<%= program.id %>/assign">
        <input type="hidden" name="start_date" class="sync-start-date" value="<%= commonStart %>">
        <input type="hidden" name="end_date" class="sync-end-date" value="<%= commonEnd %>">
        <div style="display:flex; flex-direction:column; gap:8px;">
          <label style="font-size:12px; font-weight:600; color:var(--gray-500);">Assign Players</label>
          <div style="max-height:200px; overflow-y:auto; border:1px solid var(--gray-200); border-radius:8px; padding:8px; background:var(--gray-50);">
            <% const assignedIds = assignments.map(a => a.player_id); %>
            <% const unassigned = players.filter(p => !assignedIds.includes(p.id)); %>
            <% if (unassigned.length > 0) { %>
            <label style="display:flex; align-items:center; gap:8px; padding:4px 4px 8px; font-size:13px; font-weight:700; cursor:pointer; border-bottom:1px solid var(--gray-200); margin-bottom:4px; color:var(--navy);">
              <input type="checkbox" id="select-all-players" onchange="document.querySelectorAll('input[name=player_ids]').forEach(cb => cb.checked = this.checked)"> Select All
            </label>
            <% unassigned.forEach(p => { %>
            <label style="display:flex; align-items:center; gap:8px; padding:4px; font-size:13px; cursor:pointer;">
              <input type="checkbox" name="player_ids" value="<%= p.id %>"> <%= p.player_name %>
            </label>
            <% }); %>
            <% } else { %>
            <p style="font-size:12px; color:var(--gray-400); margin:4px;">All confirmed players are assigned.</p>
            <% } %>
          </div>
          <button type="submit" class="btn btn-confirm" style="align-self:flex-start;">Assign Selected</button>
        </div>
      </form>
    </div>

    <script>
    (function() {
      var startInput = document.getElementById('program-start-date');
      var endInput = document.getElementById('program-end-date');
      if (!startInput || !endInput) return;
      function syncDates() {
        document.querySelectorAll('.sync-start-date').forEach(function(el) { el.value = startInput.value; });
        document.querySelectorAll('.sync-end-date').forEach(function(el) { el.value = endInput.value; });
        var bulkStart = document.getElementById('bulk-start-date');
        var bulkEnd = document.getElementById('bulk-end-date');
        if (bulkStart) bulkStart.value = startInput.value;
        if (bulkEnd) bulkEnd.value = endInput.value;
      }
      startInput.addEventListener('change', syncDates);
      endInput.addEventListener('change', syncDates);
    })();
    </script>

    <div style="margin:24px 0; padding:20px; background:#fff4f4; border:1px solid #fecaca; border-radius:12px;">
      <h3 style="font-size:15px; font-weight:700; color:#dc2626; margin:0 0 8px;">Danger Zone</h3>
      <p style="font-size:13px; color:var(--gray-500); margin:0 0 12px;">Permanently delete this program and all its days, activities, and assignments.</p>
      <form method="POST" action="/admin/programs/<%= program.id %>/delete" onsubmit="return confirm('Are you sure you want to delete this program? This cannot be undone.')">
        <button type="submit" class="btn btn-secondary" style="color:#dc2626; border-color:#fecaca;">Delete Program</button>
      </form>
    </div>
  </main>

  <footer>
    <div class="container">
      <p>Summer 2026 <%= teamName %> &middot; Major Division</p>
    </div>
  </footer>
</body>
</html>
