<%
  // Prominent team switcher for accounts whose players span more than one
  // team. Renders nothing for single-team accounts so it never adds noise.
  // myTeams / currentTeamId come from the team-context middleware, which also
  // validates ?team=<id> against THIS account's own teams.
  //
  // The link targets "/?team=N" rather than a bare "?team=N" on purpose:
  //  - a bare relative query would clobber other params on the page
  //  - staying on e.g. a Team A event while selecting Team B is incoherent,
  //    so switching lands on the chosen team's home page instead
  var _teams = (typeof myTeams !== 'undefined' && myTeams) ? myTeams : [];
  var _current = (typeof currentTeamId !== 'undefined') ? currentTeamId : null;
%>
<% if (_teams.length > 1) { %>
  <div class="team-switcher">
    <div class="team-switcher-label">
      You have players on <%= _teams.length %> teams &mdash; you're viewing:
    </div>
    <div class="team-switcher-buttons">
      <% _teams.forEach(function(t) { %>
        <% if (t.id === _current) { %>
          <span class="team-chip team-chip-active">
            <%= t.name %><% if (!t.is_active) { %> <span class="team-chip-archived">(past season)</span><% } %>
            <span class="team-chip-tick">&#10003;</span>
          </span>
        <% } else { %>
          <a class="team-chip team-chip-switch" href="/?team=<%= t.id %>">
            Switch to <%= t.name %><% if (!t.is_active) { %> <span class="team-chip-archived">(past season)</span><% } %>
          </a>
        <% } %>
      <% }); %>
    </div>
  </div>
<% } %>
