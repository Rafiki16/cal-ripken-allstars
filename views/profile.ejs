<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= player.player_name %> Profile &middot; <%= teamName %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <div class="container">
      <div class="header-content">
        <a href="<%= isAdmin ? '/admin' : '/verify' %>" class="back-link">&larr; Back</a>
        <div class="header-text">
          <div class="logo">&#9918;</div>
          <div>
            <h1><%= player.player_name %></h1>
            <p class="subtitle">Player Profile</p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="container">
    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (isAdmin) { %>
    <div class="profile-section" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
      <div>
        <div style="font-size:13px; color:var(--gray-500); font-weight:600; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:4px;">Status</div>
        <span class="player-status-badge badge-<%= player.status %>" style="position:static; font-size:13px; padding:6px 14px;">
          <%= player.status === 'confirmed' ? 'Confirmed' : player.status === 'declined' ? 'Declined' : 'Pending' %>
        </span>
      </div>
      <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <% if (player.status !== 'confirmed') { %>
          <form method="POST" action="/admin/status" style="margin:0;">
            <input type="hidden" name="player_id" value="<%= player.id %>">
            <input type="hidden" name="status" value="confirmed">
            <input type="hidden" name="redirect" value="/profile/<%= player.id %>">
            <button type="submit" class="btn btn-confirm" style="padding:10px 20px;">Confirm Player</button>
          </form>
        <% } %>
        <% if (player.status !== 'declined') { %>
          <form method="POST" action="/admin/status" style="margin:0;">
            <input type="hidden" name="player_id" value="<%= player.id %>">
            <input type="hidden" name="status" value="declined">
            <input type="hidden" name="redirect" value="/profile/<%= player.id %>">
            <button type="submit" class="btn btn-decline" style="padding:10px 20px;">Decline Player</button>
          </form>
        <% } %>
        <% if (player.status !== 'pending') { %>
          <form method="POST" action="/admin/status" style="margin:0;">
            <input type="hidden" name="player_id" value="<%= player.id %>">
            <input type="hidden" name="status" value="pending">
            <input type="hidden" name="redirect" value="/profile/<%= player.id %>">
            <button type="submit" class="btn btn-secondary" style="padding:10px 20px;">Reset to Pending</button>
          </form>
        <% } %>
      </div>
    </div>
    <% } %>

    <form method="POST" action="/profile/<%= player.id %>" class="profile-form">
      <input type="hidden" name="phone" value="<%= phone %>">

      <!-- Personal Info -->
      <div class="profile-section">
        <h2 class="profile-section-title">Personal Info</h2>
        <div class="form-row">
          <div class="form-group">
            <label for="birthdate">Date of Birth</label>
            <input type="date" id="birthdate" name="birthdate" value="<%= player.birthdate || '' %>" class="form-input">
          </div>
          <div class="form-group">
            <label for="jersey_number">Jersey Number</label>
            <input type="text" id="jersey_number" name="jersey_number" value="<%= player.jersey_number || '' %>" class="form-input" maxlength="3" placeholder="#" style="max-width:80px;">
          </div>
        </div>
      </div>

      <!-- Positions -->
      <div class="profile-section">
        <h2 class="profile-section-title">Best Positions</h2>
        <p class="section-hint">Select all positions the player excels at</p>
        <div class="positions-grid">
          <% POSITIONS.forEach(pos => { %>
            <label class="position-checkbox">
              <input type="checkbox" name="best_positions" value="<%= pos %>"
                <%= (player.best_positions || '').split(',').includes(pos) ? 'checked' : '' %>>
              <span class="position-label"><%= pos %></span>
            </label>
          <% }); %>
        </div>
      </div>

      <div class="profile-section">
        <h2 class="profile-section-title">Favorite Positions</h2>
        <p class="section-hint">Select positions the player prefers to play</p>
        <div class="positions-grid">
          <% POSITIONS.forEach(pos => { %>
            <label class="position-checkbox">
              <input type="checkbox" name="favorite_positions" value="<%= pos %>"
                <%= (player.favorite_positions || '').split(',').includes(pos) ? 'checked' : '' %>>
              <span class="position-label"><%= pos %></span>
            </label>
          <% }); %>
        </div>
      </div>

      <!-- Skills Ratings -->
      <div class="profile-section">
        <h2 class="profile-section-title">Skills Assessment</h2>
        <p class="section-hint">Rate each skill from 1 (developing) to 5 (elite)</p>

        <div class="ratings-list">
          <% RATING_FIELDS.forEach(field => { %>
            <div class="rating-row">
              <span class="rating-label"><%= field.label %></span>
              <div class="rating-buttons">
                <% for (let i = 1; i <= 5; i++) { %>
                  <label class="rating-option">
                    <input type="radio" name="<%= field.key %>" value="<%= i %>"
                      <%= player[field.key] == i ? 'checked' : '' %>>
                    <span class="rating-circle"><%= i %></span>
                  </label>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

      <!-- Parent / Guardian Contacts (for GameChanger & team communications) -->
      <div class="profile-section">
        <h2 class="profile-section-title">Parent / Guardian Contacts</h2>
        <p class="section-hint">Add emails for GameChanger invites and phone numbers for team contacts</p>

        <% let contacts = []; try { if (player.contacts) contacts = JSON.parse(player.contacts); } catch(e) {} %>
        <div id="contacts-list">
          <% if (contacts.length === 0) { contacts.push({ name: '', email: '', phone: '', relation: '' }); } %>
          <% contacts.forEach((c, i) => { %>
            <div class="contact-row" data-index="<%= i %>">
              <div class="form-row">
                <div class="form-group">
                  <label>Name</label>
                  <input type="text" name="contact_name" value="<%= c.name %>" class="form-input" placeholder="Full name">
                </div>
                <div class="form-group">
                  <label>Relation</label>
                  <input type="text" name="contact_relation" value="<%= c.relation %>" class="form-input" placeholder="Mom, Dad, Guardian...">
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label>Email (for GameChanger)</label>
                  <input type="email" name="contact_email" value="<%= c.email %>" class="form-input" placeholder="email@example.com">
                </div>
                <div class="form-group">
                  <label>Phone</label>
                  <input type="tel" name="contact_phone" value="<%= c.phone ? String(c.phone).replace(/(\d{3})(\d{3})(\d{4})/, '($1) $2-$3') : '' %>" class="form-input" placeholder="(941) 555-1234">
                </div>
              </div>
            </div>
          <% }); %>
        </div>
        <button type="button" onclick="addContact()" class="btn btn-secondary" style="margin-top:12px;">+ Add Another Contact</button>
      </div>

      <div class="profile-actions">
        <button type="submit" class="btn btn-confirm btn-large">Save Profile</button>
      </div>
    </form>

    <!-- Programs Enrolled -->
    <% if (programData && programData.length > 0) { %>
    <% programData.forEach((pd, pi) => { %>
    <div class="profile-section program-enrollment-section">
      <div class="program-enrollment-header">
        <h2 class="profile-section-title" style="margin:0;"><%= pd.assignment.title %></h2>
        <span class="program-enrolled-badge">Enrolled</span>
      </div>
      <% if (pd.assignment.description) { %>
        <p style="color:#6b7280;font-size:14px;margin:4px 0 16px;"><%= pd.assignment.description %></p>
      <% } %>

      <%
        const now = new Date();
        const dayNames = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
        const todayName = dayNames[now.getDay()];
        const todayDay = pd.days.find(d => d.day_label === todayName);
        const todayDateStr = now.toISOString().split('T')[0];

        function getMondayOf(d) {
          const dt = new Date(d);
          const day = dt.getDay();
          const diff = dt.getDate() - day + (day === 0 ? -6 : 1);
          dt.setDate(diff);
          return dt.toISOString().split('T')[0];
        }
      %>

      <% if (todayDay && todayDay.activities && todayDay.activities.length > 0) { %>
        <%
          const todayWeekOf = getMondayOf(now);
          const todayComplete = pd.completions.some(c => c.program_day_id === todayDay.id && c.week_of && c.week_of.substring(0,10) === todayWeekOf);
        %>
        <div class="today-activities-card <%= todayComplete ? 'today-complete' : '' %>">
          <div class="today-activities-header">
            <span class="today-label"><%= todayComplete ? 'Completed Today' : "Today's Activities" %> &mdash; <%= todayName %></span>
            <% if (todayComplete) { %>
              <span class="today-check">&#10003;</span>
            <% } %>
          </div>
          <ul class="today-activities-list">
            <% todayDay.activities.forEach(act => { %>
              <li>
                <strong><%= act.title %></strong>
                <% if (act.sets || act.reps || act.duration) { %>
                  <span class="activity-detail">
                    <% if (act.sets) { %><%= act.sets %> sets<% } %>
                    <% if (act.reps) { %><%= act.sets ? ' x ' : '' %><%= act.reps %> reps<% } %>
                    <% if (act.duration) { %><%= (act.sets || act.reps) ? ' &middot; ' : '' %><%= act.duration %><% } %>
                  </span>
                <% } %>
              </li>
            <% }); %>
          </ul>
          <% if (!todayComplete) { %>
            <button class="btn btn-confirm btn-mark-complete" onclick="markDayComplete(<%= pd.assignment.program_id %>, <%= player.id %>, <%= todayDay.id %>, this)">
              &#10003; Mark Today Complete
            </button>
          <% } %>
        </div>
      <% } else { %>
        <div class="today-activities-card today-rest">
          <span class="today-label">Rest Day &mdash; <%= todayName %></span>
          <p style="margin:8px 0 0;color:#6b7280;font-size:14px;">No activities scheduled for today.</p>
        </div>
      <% } %>

      <!-- Monthly Calendar -->
      <%
        const calYear = now.getFullYear();
        const calMonth = now.getMonth();
        const monthName = now.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
        const firstDay = new Date(calYear, calMonth, 1);
        const lastDay = new Date(calYear, calMonth + 1, 0);
        const startPad = firstDay.getDay();
        const daysInMonth = lastDay.getDate();

        const dayLabelMap = {};
        pd.days.forEach(d => { dayLabelMap[d.day_label] = d; });

        const completionMap = {};
        pd.completions.forEach(c => {
          const key = c.program_day_id + '|' + (c.week_of ? c.week_of.substring(0,10) : '');
          completionMap[key] = true;
        });
      %>
      <div class="program-calendar">
        <div class="calendar-header"><%= monthName %></div>
        <div class="calendar-grid">
          <div class="cal-dow">Sun</div><div class="cal-dow">Mon</div><div class="cal-dow">Tue</div><div class="cal-dow">Wed</div><div class="cal-dow">Thu</div><div class="cal-dow">Fri</div><div class="cal-dow">Sat</div>
          <% for (let i = 0; i < startPad; i++) { %><div class="cal-day cal-empty"></div><% } %>
          <% for (let d = 1; d <= daysInMonth; d++) { %>
            <%
              const cellDate = new Date(calYear, calMonth, d);
              const cellDayName = dayNames[cellDate.getDay()];
              const cellProgramDay = dayLabelMap[cellDayName];
              const cellWeekOf = getMondayOf(cellDate);
              const isToday = d === now.getDate() && calMonth === now.getMonth() && calYear === now.getFullYear();
              const isPast = cellDate < new Date(calYear, calMonth, now.getDate());
              const isFuture = cellDate > now;
              let cellClass = 'cal-day';
              if (isToday) cellClass += ' cal-today';
              if (cellProgramDay) {
                const ckey = cellProgramDay.id + '|' + cellWeekOf;
                if (completionMap[ckey]) {
                  cellClass += ' cal-complete';
                } else if (isPast) {
                  cellClass += ' cal-missed';
                } else if (isToday) {
                  cellClass += ' cal-due';
                } else {
                  cellClass += ' cal-scheduled';
                }
              } else {
                cellClass += ' cal-rest';
              }
            %>
            <div class="<%= cellClass %>"><span class="cal-num"><%= d %></span></div>
          <% } %>
        </div>
        <div class="calendar-legend">
          <span class="legend-item"><span class="legend-dot legend-complete"></span>Completed</span>
          <span class="legend-item"><span class="legend-dot legend-missed"></span>Missed</span>
          <span class="legend-item"><span class="legend-dot legend-scheduled"></span>Scheduled</span>
          <span class="legend-item"><span class="legend-dot legend-rest"></span>Rest</span>
        </div>
      </div>
    </div>
    <% }); %>
    <% } %>

    <!-- Availability / Events -->
    <div class="profile-section">
      <h2 class="profile-section-title">Availability / Absences</h2>
      <p class="section-hint">Add dates when the player will be unavailable (vacations, conflicts, etc.)</p>

      <form method="POST" action="/profile/<%= player.id %>/event" class="event-form">
        <input type="hidden" name="phone" value="<%= phone %>">
        <div class="form-row">
          <div class="form-group">
            <label>Type</label>
            <select name="event_type" class="form-input">
              <option value="vacation">Vacation</option>
              <option value="practice_conflict">Practice Conflict</option>
              <option value="game_conflict">Game Conflict</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="form-group">
            <label>Start Date *</label>
            <input type="date" name="start_date" required class="form-input">
          </div>
          <div class="form-group">
            <label>End Date</label>
            <input type="date" name="end_date" class="form-input">
          </div>
        </div>
        <div class="form-group">
          <label>Notes</label>
          <input type="text" name="notes" class="form-input" placeholder="Optional details">
        </div>
        <button type="submit" class="btn btn-secondary" style="margin-top:8px;">Add Absence</button>
      </form>

      <% if (events.length > 0) { %>
        <div class="events-list">
          <% events.forEach(ev => { %>
            <div class="event-item">
              <div class="event-info">
                <span class="event-type-badge event-type-<%= ev.event_type %>">
                  <%= ev.event_type === 'vacation' ? 'Vacation' : ev.event_type === 'practice_conflict' ? 'Practice Conflict' : ev.event_type === 'game_conflict' ? 'Game Conflict' : 'Other' %>
                </span>
                <span class="event-dates">
                  <%= new Date(ev.start_date + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %><% if (ev.end_date) { %> &ndash; <%= new Date(ev.end_date + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %><% } %>
                </span>
                <% if (ev.notes) { %><span class="event-notes"><%= ev.notes %></span><% } %>
              </div>
              <form method="POST" action="/profile/<%= player.id %>/event/delete" style="margin:0;">
                <input type="hidden" name="phone" value="<%= phone %>">
                <input type="hidden" name="event_id" value="<%= ev.id %>">
                <button type="submit" class="btn-sm btn-sm-remove" title="Remove">&times;</button>
              </form>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p style="color:#6b7280; margin-top:16px; font-size:14px;">No absences reported yet.</p>
      <% } %>
    </div>

      <script>
      async function markDayComplete(programId, playerId, dayId, btn) {
        btn.disabled = true;
        btn.textContent = 'Saving...';
        try {
          const res = await fetch('/programs/' + programId + '/complete-day', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ player_id: playerId, day_id: dayId })
          });
          if (res.ok) {
            const card = btn.closest('.today-activities-card');
            card.classList.add('today-complete');
            card.querySelector('.today-activities-header .today-label').textContent = "Completed Today — " + new Date().toLocaleDateString('en-US', { weekday: 'long' });
            const headerEl = card.querySelector('.today-activities-header');
            if (!headerEl.querySelector('.today-check')) {
              const checkSpan = document.createElement('span');
              checkSpan.className = 'today-check';
              checkSpan.innerHTML = '&#10003;';
              headerEl.appendChild(checkSpan);
            }
            btn.remove();
            location.reload();
          } else { btn.disabled = false; btn.textContent = '✓ Mark Today Complete'; }
        } catch (e) { btn.disabled = false; btn.textContent = '✓ Mark Today Complete'; }
      }

      function addContact() {
        const list = document.getElementById('contacts-list');
        const idx = list.querySelectorAll('.contact-row').length;
        const div = document.createElement('div');
        div.className = 'contact-row';
        div.dataset.index = idx;
        div.innerHTML = `
          <hr style="margin:16px 0;border:none;border-top:1px solid #e5e7eb;">
          <div class="form-row">
            <div class="form-group">
              <label>Name</label>
              <input type="text" name="contact_name" class="form-input" placeholder="Full name">
            </div>
            <div class="form-group">
              <label>Relation</label>
              <input type="text" name="contact_relation" class="form-input" placeholder="Mom, Dad, Guardian...">
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Email (for GameChanger)</label>
              <input type="email" name="contact_email" class="form-input" placeholder="email@example.com">
            </div>
            <div class="form-group">
              <label>Phone</label>
              <input type="tel" name="contact_phone" class="form-input" placeholder="(941) 555-1234">
            </div>
          </div>`;
        list.appendChild(div);
      }
      </script>
  </main>

  <footer>
    <div class="container">
      <p>Summer 2026 <%= teamName %> &middot; Major Division</p>
    </div>
  </footer>
</body>
</html>
