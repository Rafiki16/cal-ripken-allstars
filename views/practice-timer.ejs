<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title>Practice Timer &middot; Cal Ripken All-Stars</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Arial, Helvetica, sans-serif; background: #0f172a; color: #e2e8f0; min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column; }

    .pt-top-bar { background: #1a2744; padding: 10px 16px; display: flex; align-items: center; justify-content: space-between; }
    .pt-top-bar a { color: #94a3b8; text-decoration: none; font-size: 14px; }
    .pt-top-bar .pt-title { color: #d4a843; font-weight: 700; font-size: 15px; }

    .pt-timer { background: #1e293b; padding: 24px 16px 20px; text-align: center; border-bottom: 1px solid #334155; }
    .pt-drill-label { font-size: 20px; font-weight: 700; color: #fff; margin-bottom: 4px; min-height: 28px; }
    .pt-drill-desc { font-size: 13px; color: #94a3b8; margin-bottom: 12px; min-height: 18px; }
    .pt-clock { font-size: 72px; font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: 2px; color: #fff; line-height: 1; margin-bottom: 12px; }
    .pt-clock.warning { color: #f59e0b; }
    .pt-clock.danger { color: #ef4444; }

    .pt-progress { width: 100%; height: 8px; background: #334155; border-radius: 4px; overflow: hidden; margin-bottom: 14px; }
    .pt-progress-fill { height: 100%; background: #d4a843; border-radius: 4px; transition: width 0.4s linear; }
    .pt-progress-fill.warning { background: #f59e0b; }
    .pt-progress-fill.danger { background: #ef4444; }

    .pt-next-label { font-size: 13px; color: #64748b; margin-bottom: 16px; min-height: 18px; }

    .pt-controls { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
    .pt-btn { border: none; border-radius: 10px; padding: 14px 28px; font-size: 16px; font-weight: 700; cursor: pointer; min-width: 100px; transition: transform 0.1s, opacity 0.1s; }
    .pt-btn:active { transform: scale(0.95); opacity: 0.85; }
    .pt-btn-start { background: #16a34a; color: #fff; padding: 16px 44px; font-size: 20px; }
    .pt-btn-pause { background: #f59e0b; color: #1a2744; }
    .pt-btn-skip { background: #3b82f6; color: #fff; }
    .pt-btn-end { background: #475569; color: #fff; }
    .pt-btn-restart { background: #16a34a; color: #fff; margin-top: 8px; }

    .pt-overall { display: flex; justify-content: center; gap: 24px; padding: 10px 16px; background: #0f172a; border-bottom: 1px solid #1e293b; font-size: 12px; color: #64748b; }
    .pt-overall strong { color: #94a3b8; }

    .pt-drills { flex: 1; overflow-y: auto; padding: 12px 16px 80px; -webkit-overflow-scrolling: touch; }

    .pt-drill { background: #1e293b; border: 2px solid #334155; border-radius: 12px; padding: 14px 16px; margin-bottom: 10px; display: flex; align-items: center; gap: 12px; transition: border-color 0.3s, background 0.3s, transform 0.2s; }
    .pt-drill.active { border-color: #d4a843; background: #1a2744; transform: scale(1.02); }
    .pt-drill.done { opacity: 0.45; border-color: #1e293b; }
    .pt-drill.done .pt-drill-check { display: flex; }

    .pt-drill-num { width: 30px; height: 30px; border-radius: 50%; background: #334155; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px; color: #94a3b8; flex-shrink: 0; }
    .pt-drill.active .pt-drill-num { background: #d4a843; color: #1a2744; }

    .pt-drill-info { flex: 1; min-width: 0; }
    .pt-drill-name { font-weight: 700; font-size: 15px; color: #e2e8f0; }
    .pt-drill.active .pt-drill-name { color: #fff; }
    .pt-drill-subdesc { font-size: 12px; color: #64748b; margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .pt-drill-time { font-weight: 700; font-size: 14px; color: #94a3b8; white-space: nowrap; flex-shrink: 0; }
    .pt-drill.active .pt-drill-time { color: #d4a843; }

    .pt-drill-check { display: none; color: #22c55e; font-size: 18px; flex-shrink: 0; }

    .pt-btn-alarm { background: #7c3aed; color: #fff; font-size: 14px; padding: 10px 18px; }
    .pt-audio-note { margin-top: 14px; }
    .pt-audio-hint { font-size: 11px; color: #64748b; margin-top: 6px; }
    .pt-conn { font-size: 11px; color: #ef4444; margin-top: 8px; min-height: 14px; }
    .pt-viewer-note { font-size: 12px; color: #64748b; margin-top: 12px; }

    .pt-complete { text-align: center; padding: 32px 16px; }
    .pt-complete-icon { font-size: 48px; margin-bottom: 12px; }
    .pt-complete-text { font-size: 22px; font-weight: 800; color: #22c55e; margin-bottom: 8px; }
    .pt-complete-sub { font-size: 14px; color: #94a3b8; }

    @media (min-width: 500px) {
      .pt-clock { font-size: 96px; }
      .pt-drill { padding: 16px 20px; }
      .pt-drill-name { font-size: 16px; }
    }
  </style>
</head>
<body>
  <div class="pt-top-bar">
    <a href="/event/<%= event.id %>">&larr; Back</a>
    <span class="pt-title"><%= event.title %></span>
    <span style="width:50px;"></span>
  </div>

  <div class="pt-timer">
    <div class="pt-drill-label" id="drill-label">Ready to start</div>
    <div class="pt-drill-desc" id="drill-desc"></div>
    <div class="pt-clock" id="clock">00:00</div>
    <div class="pt-progress"><div class="pt-progress-fill" id="progress"></div></div>
    <div class="pt-next-label" id="next-label"></div>
    <div class="pt-controls" id="controls"></div>
    <div class="pt-audio-note" id="audio-note" style="display:none;">
      <button class="pt-btn pt-btn-alarm" id="btn-enable-audio">&#128276; Enable alarm on this phone</button>
      <div class="pt-audio-hint">Each device needs one tap before it can play sound.</div>
    </div>
    <div class="pt-conn" id="conn-status"></div>
  </div>

  <div class="pt-overall" id="overall-bar" style="display:none;">
    <span>Drill <strong id="drill-counter">1 / <%= drills.length %></strong></span>
    <span>Elapsed <strong id="elapsed-time">00:00</strong></span>
    <span>Remaining <strong id="remaining-time"><%= drills.reduce((s, d) => s + d.duration_minutes, 0) %>:00</strong></span>
  </div>

  <div class="pt-drills" id="drill-list">
    <% drills.forEach(function(drill, i) { %>
    <div class="pt-drill" id="drill-<%= i %>" data-mins="<%= drill.duration_minutes %>">
      <div class="pt-drill-num"><%= i + 1 %></div>
      <div class="pt-drill-info">
        <div class="pt-drill-name"><%= drill.drill_name %></div>
        <% if (drill.description) { %><div class="pt-drill-subdesc"><%= drill.description %></div><% } %>
      </div>
      <div class="pt-drill-time"><%= drill.duration_minutes %> min</div>
      <div class="pt-drill-check">&#10003;</div>
    </div>
    <% }); %>
  </div>

  <script src="/practice-timer.js"></script>
  <script>
  (function() {
    var EVENT_ID = <%= event.id %>;
    var IS_STAFF = <%= isStaff ? 'true' : 'false' %>;
    var PLAN = <%- JSON.stringify(drills.map(function(d) { return { name: d.drill_name, desc: d.description || '', mins: d.duration_minutes }; })) %>;

    var label = document.getElementById('drill-label');
    var desc = document.getElementById('drill-desc');
    var clock = document.getElementById('clock');
    var progress = document.getElementById('progress');
    var nextLabel = document.getElementById('next-label');
    var controls = document.getElementById('controls');
    var overallBar = document.getElementById('overall-bar');
    var drillCounter = document.getElementById('drill-counter');
    var elapsedEl = document.getElementById('elapsed-time');
    var remainingEl = document.getElementById('remaining-time');
    var listEl = document.getElementById('drill-list');
    var audioNote = document.getElementById('audio-note');
    var connEl = document.getElementById('conn-status');
    var fmt = window.practiceFmt;

    var clockObj = new PracticeClock(EVENT_ID, {
      onUpdate: render,
      onError: function(e) { connEl.textContent = 'Reconnecting\u2026'; }
    });

    var listSig = null, controlSig = null;

    // The running plan comes from the server's snapshot, so a plan edited
    // mid-practice can't desync this device from the others.
    function renderList(schedule, idx, live) {
      var sig = JSON.stringify(schedule) + '|' + idx + '|' + live;
      if (sig === listSig) return;
      listSig = sig;
      var html = '';
      for (var i = 0; i < schedule.length; i++) {
        var d = schedule[i];
        var cls = 'pt-drill' + (i < idx ? ' done' : (i === idx && live ? ' active' : ''));
        html += '<div class="' + cls + '" id="drill-' + i + '">' +
          '<div class="pt-drill-num">' + (i + 1) + '</div>' +
          '<div class="pt-drill-info"><div class="pt-drill-name"></div>' +
          (d.desc ? '<div class="pt-drill-subdesc"></div>' : '') + '</div>' +
          '<div class="pt-drill-time">' + d.mins + ' min</div>' +
          '<div class="pt-drill-check">&#10003;</div></div>';
      }
      listEl.innerHTML = html;
      // Names go in as text, never as markup.
      for (var j = 0; j < schedule.length; j++) {
        var card = document.getElementById('drill-' + j);
        card.querySelector('.pt-drill-name').textContent = schedule[j].name;
        var sub = card.querySelector('.pt-drill-subdesc');
        if (sub) sub.textContent = schedule[j].desc;
      }
      var act = document.getElementById('drill-' + idx);
      if (act && live) act.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function btn(cls, text, fn) {
      var b = document.createElement('button');
      b.className = 'pt-btn ' + cls;
      b.textContent = text;
      b.onclick = fn;
      return b;
    }

    function renderControls(s) {
      var sig = s.status + '|' + s.can_control;
      if (sig === controlSig) return;
      controlSig = sig;
      controls.innerHTML = '';

      if (!s.can_control) {
        var note = document.createElement('div');
        note.className = 'pt-viewer-note';
        note.textContent = s.status === 'running' || s.status === 'paused'
          ? 'Following the coach\u2019s clock.'
          : 'Waiting for a coach to start practice.';
        controls.appendChild(note);
        return;
      }

      if (s.status === 'running') {
        controls.appendChild(btn('pt-btn-pause', 'Pause', function() { clockObj.send('pause'); }));
        controls.appendChild(btn('pt-btn-skip', 'Skip', function() {
          clockObj.send('skip', { expected_index: clockObj.state.index });
        }));
        controls.appendChild(btn('pt-btn-end', 'End', function() { clockObj.send('end'); }));
      } else if (s.status === 'paused') {
        controls.appendChild(btn('pt-btn-start', 'Resume', function() { clockObj.send('resume'); }));
        controls.appendChild(btn('pt-btn-skip', 'Skip', function() {
          clockObj.send('skip', { expected_index: clockObj.state.index });
        }));
        controls.appendChild(btn('pt-btn-end', 'End', function() { clockObj.send('end'); }));
      } else {
        var startBtn = btn('pt-btn-start', s.status === 'ended' ? 'Restart Practice' : 'Start Practice', function() {
          clockObj.send('start');
        });
        controls.appendChild(startBtn);
        if (s.status === 'ended') {
          var done = document.createElement('a');
          done.href = '/event/' + EVENT_ID;
          done.className = 'pt-btn pt-btn-end';
          done.style.cssText = 'text-decoration:none;text-align:center;';
          done.textContent = 'Done';
          controls.appendChild(done);
        }
      }
    }

    function render(s, c) {
      connEl.textContent = '';
      var live = s.status === 'running' || s.status === 'paused';
      var schedule = s.schedule && s.schedule.length ? s.schedule : PLAN;

      renderControls(s);
      renderList(schedule, live ? s.index : (s.status === 'ended' ? schedule.length : -1), live);
      audioNote.style.display = c.alarm.isUnlocked() ? 'none' : '';
      overallBar.style.display = live || s.status === 'ended' ? '' : 'none';

      if (!live) {
        label.textContent = s.status === 'ended' ? 'Practice Complete!' : 'Ready to start';
        desc.textContent = '';
        clock.textContent = s.status === 'ended' ? fmt(c.elapsedTotal()) : '00:00';
        clock.className = 'pt-clock';
        progress.style.width = s.status === 'ended' ? '100%' : '0%';
        progress.className = 'pt-progress-fill';
        nextLabel.textContent = s.status === 'ended'
          ? 'Total practice time: ' + fmt(c.elapsedTotal())
          : (schedule.length ? schedule.length + ' drills queued' : 'No drills in this plan yet');
        if (s.status === 'ended') {
          drillCounter.textContent = schedule.length + ' / ' + schedule.length;
          elapsedEl.textContent = fmt(c.elapsedTotal());
          remainingEl.textContent = '00:00';
        }
        return;
      }

      var cur = schedule[s.index] || { name: '', desc: '', mins: 0 };
      var totalMs = cur.mins * 60000;
      var remMs = c.remaining();

      label.textContent = cur.name + (s.status === 'paused' ? ' (paused)' : '');
      desc.textContent = cur.desc || '';
      clock.textContent = fmt(remMs);

      var pct = totalMs > 0 ? (totalMs - remMs) / totalMs * 100 : 100;
      progress.style.width = pct + '%';
      var frac = totalMs > 0 ? remMs / totalMs : 0;
      var cls = frac <= 0.15 ? 'danger' : (frac <= 0.3 ? 'warning' : '');
      clock.className = 'pt-clock' + (cls ? ' ' + cls : '');
      progress.className = 'pt-progress-fill' + (cls ? ' ' + cls : '');

      var nxt = schedule[s.index + 1];
      nextLabel.textContent = nxt ? 'Next: ' + nxt.name + ' (' + nxt.mins + ' min)' : 'Final drill';

      drillCounter.textContent = (s.index + 1) + ' / ' + schedule.length;
      elapsedEl.textContent = fmt(c.elapsedTotal());
      var left = remMs;
      for (var i = s.index + 1; i < schedule.length; i++) left += schedule[i].mins * 60000;
      remainingEl.textContent = fmt(left);
    }

    document.getElementById('btn-enable-audio').onclick = function() {
      clockObj.alarm.unlock();
      clockObj.alarm.blip(880);
      audioNote.style.display = clockObj.alarm.isUnlocked() ? 'none' : '';
    };

    // Any tap is a valid gesture to arm audio — catches coaches who hit a
    // control button before the explicit enable button.
    document.addEventListener('touchend', function() { clockObj.alarm.unlock(); }, { passive: true });
    document.addEventListener('click', function() { clockObj.alarm.unlock(); });

    clockObj.start();
  })();
  </script>
</body>
</html>
