<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Parent Registration &middot; <%= teamName %></title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    .login-hero { text-align: center; padding: 40px 0 20px; }
    .login-hero .logo { font-size: 48px; margin-bottom: 8px; }
    .login-hero h1 { font-size: 26px; color: var(--navy); margin: 0; }
    .login-hero .sub { font-size: 14px; color: #6b7280; margin-top: 4px; line-height: 1.5; }
    .login-box { max-width: 420px; margin: 0 auto; background: #fff; border: 1px solid #e5e7eb; border-radius: 16px; padding: 28px 24px; }
    .login-box h2 { font-size: 18px; color: var(--navy); margin: 0 0 16px; text-align: center; }
    .login-box .form-group { margin-bottom: 14px; }
    .login-box label { font-size: 13px; font-weight: 600; color: #374151; display: block; margin-bottom: 4px; }
    .login-box .form-input { width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 15px; box-sizing: border-box; }
    .login-box .btn-primary { width: 100%; padding: 12px; font-size: 16px; font-weight: 700; }
    .login-footer { text-align: center; margin-top: 20px; font-size: 13px; color: #6b7280; }
    .login-footer a { color: var(--navy); font-weight: 600; }
    .hint { font-size: 12px; color: #9ca3af; margin-top: 3px; }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <div class="header-content">
        <div class="header-text">
          <div class="logo">&#9918;</div>
          <div>
            <h1><%= teamName %></h1>
            <p class="subtitle">Summer 2026 &middot; Major Division</p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="container">
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="login-hero">
      <p class="sub">Create your parent account to view schedules, RSVPs, lineups, and more.</p>
    </div>

    <div class="login-box">
      <h2>Parent Registration</h2>
      <form method="POST" action="/parent/register">
        <div class="form-group">
          <label>Phone Number on File</label>
          <input type="tel" name="phone" required class="form-input" placeholder="(941) 555-1234" autocomplete="tel" value="<%= phone %>">
          <p class="hint">The phone number your league has on file for your player.</p>
        </div>
        <div class="form-group">
          <label>Your Name</label>
          <input type="text" name="display_name" required class="form-input" placeholder="e.g. Jane Smith" autocomplete="name" value="<%= typeof displayName !== 'undefined' ? displayName : '' %>">
          <p class="hint">Your name as it should appear to the coaching staff.</p>
        </div>
        <div class="form-group">
          <label>Choose a Username</label>
          <input type="text" name="username" required class="form-input" placeholder="e.g. jsmith" minlength="3" maxlength="30" autocomplete="username" value="<%= username %>">
          <p class="hint">Letters, numbers, and underscores only. This is what you'll use to log in.</p>
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" required class="form-input" placeholder="At least 6 characters" minlength="6" autocomplete="new-password">
        </div>
        <div class="form-group">
          <label>Confirm Password</label>
          <input type="password" name="confirm_password" required class="form-input" placeholder="Re-enter password" autocomplete="new-password">
        </div>
        <button type="submit" class="btn btn-primary">Create Account</button>
      </form>
    </div>

    <div class="login-footer">
      <p>Already have an account? <a href="/parent/login">Sign In</a></p>
      <p>Not a parent? <a href="/fan/register">Register as a Fan</a></p>
    </div>
  </main>

  <footer>
    <div class="container">
      <p>Summer 2026 <%= teamName %> &middot; Major Division</p>
    </div>
  </footer>
</body>
</html>
