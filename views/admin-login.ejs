<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login &middot; Cal Ripken All-Stars</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <div class="container">
      <div class="header-content">
        <a href="/" class="back-link">&larr; Back to Roster</a>
        <div class="header-text">
          <div class="logo">&#9918;</div>
          <div>
            <h1>Admin Access</h1>
            <p class="subtitle">Cal Ripken All-Stars</p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="container">
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="verify-box">
      <h2>Admin Login</h2>
      <form method="POST" action="/admin/login" class="phone-form">
        <input type="text" name="username" placeholder="Username" required autofocus autocomplete="username" class="phone-input" style="font-size:16px;">
        <input type="password" name="password" placeholder="Password" required autocomplete="current-password" class="phone-input" style="font-size:16px;">
        <button type="submit" class="btn btn-primary">Log In</button>
      </form>
    </div>
  </main>

  <footer>
    <div class="container">
      <p>Summer 2026 Cal Ripken All-Stars &middot; Major Division</p>
    </div>
  </footer>
</body>
</html>
