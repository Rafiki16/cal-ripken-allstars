<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title>Admin Login &middot; <%= teamName %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <div class="container">
      <div class="header-content">
        <a href="/" class="back-link">&larr; Back to Roster</a>
        <div class="header-text">
          <div class="logo">&#9918;</div>
          <div>
            <h1>Admin Access</h1>
            <p class="subtitle"><%= teamName %></p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="container">
    <% if (success) { %>
      <div class="alert" style="background:#dcfce7;color:#166534;border:1px solid #bbf7d0;padding:12px;border-radius:8px;margin-bottom:16px;"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="verify-box">
      <h2>Admin Login</h2>
      <form method="POST" action="/admin/login" class="phone-form">
        <input type="text" name="username" placeholder="Username" required autofocus autocomplete="username" class="phone-input" style="font-size:16px;">
        <input type="password" name="password" placeholder="Password" required autocomplete="current-password" class="phone-input" style="font-size:16px;">
        <button type="submit" class="btn btn-primary">Log In</button>
      </form>
      <p style="text-align:center;margin-top:12px;"><a href="/forgot-password?type=admin" style="color:#6b7280;font-size:13px;">Forgot password?</a></p>
    </div>
  </main>

  <footer>
    <div class="container">
      <p>Summer 2026 <%= teamName %> &middot; Major Division</p>
    </div>
  </footer>
</body>
</html>
