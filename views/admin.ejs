<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin &middot; Cal Ripken All-Stars</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <div class="container">
      <div class="header-content">
        <a href="/" class="back-link">&larr; Back to Roster</a>
        <div class="header-text">
          <div class="logo">&#9918;</div>
          <div>
            <h1>Admin Dashboard</h1>
            <p class="subtitle">Manage Roster &amp; Status</p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="container">
    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <!-- Stats -->
    <div class="stats-bar">
      <div class="stat">
        <span class="stat-number"><%= total %></span>
        <span class="stat-label">Players</span>
      </div>
      <div class="stat stat-confirmed">
        <span class="stat-number"><%= confirmed %></span>
        <span class="stat-label">Confirmed</span>
      </div>
      <div class="stat stat-declined">
        <span class="stat-number"><%= declined %></span>
        <span class="stat-label">Declined</span>
      </div>
      <div class="stat stat-pending">
        <span class="stat-number"><%= pending %></span>
        <span class="stat-label">Pending</span>
      </div>
    </div>

    <!-- Add Player -->
    <div class="admin-section">
      <h2 class="profile-section-title">Add New Player</h2>
      <form method="POST" action="/admin/add-player" class="add-player-form">
        <input type="hidden" name="key" value="<%= key %>">
        <div class="form-row">
          <div class="form-group">
            <label>Player Name *</label>
            <input type="text" name="player_name" required class="form-input" placeholder="First Last">
          </div>
          <div class="form-group">
            <label>Age</label>
            <select name="age" class="form-input">
              <option value="11">11</option>
              <option value="12">12</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Division</label>
            <input type="text" name="division" value="Major" class="form-input">
          </div>
          <div class="form-group">
            <label>Regular Season Team</label>
            <input type="text" name="team" class="form-input" placeholder="Team name">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Parent Name *</label>
            <input type="text" name="parent_name" required class="form-input" placeholder="First Last">
          </div>
          <div class="form-group">
            <label>Parent Phone *</label>
            <input type="tel" name="parent_phone" required class="form-input" placeholder="(941) 555-1234">
          </div>
        </div>
        <button type="submit" class="btn btn-confirm">Add Player to Roster</button>
      </form>
    </div>

    <!-- Player Management Table -->
    <div class="admin-section">
      <h2 class="profile-section-title">Manage Roster</h2>

      <% ['11', '12'].forEach(ageGroup => { %>
        <h3 class="age-group-title" style="margin-top:20px;"><%= ageGroup %>U</h3>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Player</th>
                <th>Team</th>
                <th>Parent</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Profile</th>
                <th>Absences</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% players.filter(p => p.age == ageGroup).forEach(player => { %>
                <tr>
                  <td class="td-bold"><a href="/profile/<%= player.id %>?key=<%= key %>" class="admin-player-link"><%= player.player_name %></a></td>
                  <td><%= player.team %></td>
                  <td><%= player.parent_name %></td>
                  <td class="td-mono"><%= player.parent_phone.replace(/(\d{3})(\d{3})(\d{4})/, '($1) $2-$3') %></td>
                  <td>
                    <span class="player-status-badge badge-<%= player.status %>" style="position:static;">
                      <%= player.status === 'confirmed' ? 'Confirmed' : player.status === 'declined' ? 'Declined' : 'Pending' %>
                    </span>
                  </td>
                  <td><%= player.profile_updated_at ? 'Done' : '-' %></td>
                  <td>
                    <% const pEvents = allEvents.filter(e => e.player_id === player.id); %>
                    <% if (pEvents.length > 0) { %>
                      <% pEvents.forEach(ev => { %>
                        <div class="admin-event-pill event-type-<%= ev.event_type %>">
                          <%= new Date(ev.start_date + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %><% if (ev.end_date) { %>&ndash;<%= new Date(ev.end_date + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %><% } %>
                        </div>
                      <% }); %>
                    <% } else { %>-<% } %>
                  </td>
                  <td class="td-actions">
                    <div class="admin-action-row">
                      <% if (player.status !== 'confirmed') { %>
                        <form method="POST" action="/admin/status">
                          <input type="hidden" name="key" value="<%= key %>">
                          <input type="hidden" name="player_id" value="<%= player.id %>">
                          <input type="hidden" name="status" value="confirmed">
                          <button type="submit" class="btn-sm btn-sm-confirm" title="Mark In">IN</button>
                        </form>
                      <% } %>
                      <% if (player.status !== 'declined') { %>
                        <form method="POST" action="/admin/status">
                          <input type="hidden" name="key" value="<%= key %>">
                          <input type="hidden" name="player_id" value="<%= player.id %>">
                          <input type="hidden" name="status" value="declined">
                          <button type="submit" class="btn-sm btn-sm-decline" title="Mark Out">OUT</button>
                        </form>
                      <% } %>
                      <% if (player.status !== 'pending') { %>
                        <form method="POST" action="/admin/status">
                          <input type="hidden" name="key" value="<%= key %>">
                          <input type="hidden" name="player_id" value="<%= player.id %>">
                          <input type="hidden" name="status" value="pending">
                          <button type="submit" class="btn-sm btn-sm-reset" title="Reset to Pending">RESET</button>
                        </form>
                      <% } %>
                      <form method="POST" action="/admin/remove-player" onsubmit="return confirm('Remove <%= player.player_name %> from the roster?')">
                        <input type="hidden" name="key" value="<%= key %>">
                        <input type="hidden" name="player_id" value="<%= player.id %>">
                        <button type="submit" class="btn-sm btn-sm-remove" title="Remove Player">&times;</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% }); %>
    </div>
    <!-- Staff Management -->
    <div class="admin-section">
      <h2 class="profile-section-title">Staff Members</h2>
      <p class="section-hint">Staff can view the full roster, profiles, ratings, and contacts at <strong>/staff</strong> using their phone number. They cannot edit anything.</p>

      <form method="POST" action="/admin/add-staff" class="add-player-form">
        <input type="hidden" name="key" value="<%= key %>">
        <div class="form-row" style="grid-template-columns:1fr 1fr 1fr;">
          <div class="form-group">
            <label>Name *</label>
            <input type="text" name="name" required class="form-input" placeholder="Coach name">
          </div>
          <div class="form-group">
            <label>Role</label>
            <input type="text" name="role" value="Coach" class="form-input" placeholder="Coach, Manager...">
          </div>
          <div class="form-group">
            <label>Phone *</label>
            <input type="tel" name="phone" required class="form-input" placeholder="(941) 555-1234">
          </div>
        </div>
        <button type="submit" class="btn btn-confirm">Add Staff Member</button>
      </form>

      <% if (staff.length > 0) { %>
        <table class="admin-table" style="margin-top:20px; min-width:auto;">
          <thead>
            <tr>
              <th>Name</th>
              <th>Role</th>
              <th>Phone</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% staff.forEach(s => { %>
              <tr>
                <td class="td-bold"><%= s.name %></td>
                <td><%= s.role %></td>
                <td class="td-mono"><%= s.phone.replace(/(\d{3})(\d{3})(\d{4})/, '($1) $2-$3') %></td>
                <td>
                  <form method="POST" action="/admin/remove-staff" onsubmit="return confirm('Remove <%= s.name %>?')">
                    <input type="hidden" name="key" value="<%= key %>">
                    <input type="hidden" name="staff_id" value="<%= s.id %>">
                    <button type="submit" class="btn-sm btn-sm-remove">&times;</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <p style="color:#6b7280; margin-top:16px; font-size:14px;">No staff members added yet.</p>
      <% } %>
    </div>
  </main>

  <footer>
    <div class="container">
      <p>Summer 2026 Cal Ripken All-Stars &middot; Major Division</p>
    </div>
  </footer>
</body>
</html>
