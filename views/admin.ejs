<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title>Admin &middot; <%= teamName %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <div class="container">
      <div class="header-content">
        <div style="display:flex;justify-content:space-between;align-items:center;width:100%;">
          <a href="/" class="back-link">&larr; Back to Roster</a>
          <div style="display:flex;gap:16px;align-items:center;">
            <span style="color:rgba(255,255,255,0.85);font-size:13px;">Signed in as <strong style="color:#fff;"><%= adminUser.username %></strong></span>
            <a href="/admin/settings" style="color:#fff;font-size:13px;text-decoration:none;">Settings</a>
            <a href="/admin/logout" style="color:rgba(255,255,255,0.85);font-size:13px;text-decoration:none;">Log Out</a>
          </div>
        </div>
        <div class="header-text">
          <div class="logo">&#9918;</div>
          <div>
            <h1>Admin Dashboard</h1>
            <p class="subtitle">Manage Roster &amp; Status</p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="container">
    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <!-- Stats -->
    <div class="stats-bar">
      <div class="stat">
        <span class="stat-number"><%= total %></span>
        <span class="stat-label">Players</span>
      </div>
      <div class="stat stat-confirmed">
        <span class="stat-number"><%= confirmed %></span>
        <span class="stat-label">Confirmed</span>
      </div>
      <div class="stat stat-declined">
        <span class="stat-number"><%= declined %></span>
        <span class="stat-label">Declined</span>
      </div>
      <div class="stat stat-pending">
        <span class="stat-number"><%= pending %></span>
        <span class="stat-label">Pending</span>
      </div>
    </div>

    <!-- Player Management Table -->
    <div class="admin-section">
      <h2 class="profile-section-title">Manage Roster</h2>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Player</th>
              <th>Age</th>
              <th>Team</th>
              <th>Parent</th>
              <th>Account</th>
              <th>Phone</th>
              <th>Status</th>
              <th>Profile</th>
              <th>Absences</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% players.forEach(player => { %>
              <tr>
                <td><input type="text" class="jersey-inp" value="<%= player.jersey_number || '' %>" data-pid="<%= player.id %>" maxlength="3"></td>
                <td class="td-bold"><a href="/profile/<%= player.id %>" class="admin-player-link"><%= player.player_name %></a></td>
                <td><%= player.age %></td>
                <td><%= player.team %></td>
                <td><%= player.parent_name %></td>
                <td style="text-align:center;">
                  <% const acct = accountsByPhone[player.parent_phone]; %>
                  <% if (acct && acct.last_login_at) { %>
                    <span style="display:inline-block;background:#dcfce7;color:#166534;font-size:11px;font-weight:700;padding:2px 8px;border-radius:4px;" title="Logged in <%= new Date(acct.last_login_at).toLocaleDateString() %>">Verified</span>
                  <% } else if (acct) { %>
                    <span style="display:inline-block;background:#fef9c3;color:#854d0e;font-size:11px;font-weight:700;padding:2px 8px;border-radius:4px;" title="Account created, awaiting first login">Pending</span>
                  <% } else { %>
                    <button type="button" class="btn-sm" style="background:#7c3aed;color:#fff;font-size:10px;padding:2px 6px;border:none;border-radius:4px;cursor:pointer;white-space:nowrap;" onclick="quickCreateAccount(<%= player.id %>, '<%= player.parent_name.replace(/'/g, "\\'") %>', '<%= player.parent_phone %>')" title="Create parent account">+ Account</button>
                  <% } %>
                </td>
                <td class="td-mono"><%= player.parent_phone.replace(/(\d{3})(\d{3})(\d{4})/, '($1) $2-$3') %></td>
                <td>
                  <span class="player-status-badge badge-<%= player.status %>" style="position:static;">
                    <%= player.status === 'confirmed' ? 'Confirmed' : player.status === 'declined' ? 'Declined' : 'Pending' %>
                  </span>
                </td>
                <td><%= player.profile_updated_at ? 'Done' : '-' %></td>
                <td>
                  <% const pEvents = allEvents.filter(e => e.player_id === player.id); %>
                  <% if (pEvents.length > 0) { %>
                    <% pEvents.forEach(ev => { %>
                      <div class="admin-event-pill event-type-<%= ev.event_type %>">
                        <%= new Date(ev.start_date + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %><% if (ev.end_date) { %>&ndash;<%= new Date(ev.end_date + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %><% } %>
                      </div>
                    <% }); %>
                  <% } else { %>-<% } %>
                </td>
                <td class="td-actions">
                  <div class="admin-action-row">
                    <% if (player.status !== 'confirmed') { %>
                      <form method="POST" action="/admin/status">
                        <input type="hidden" name="player_id" value="<%= player.id %>">
                        <input type="hidden" name="status" value="confirmed">
                        <button type="submit" class="btn-sm btn-sm-confirm" title="Mark In">IN</button>
                      </form>
                    <% } %>
                    <% if (player.status !== 'declined') { %>
                      <form method="POST" action="/admin/status">
                        <input type="hidden" name="player_id" value="<%= player.id %>">
                        <input type="hidden" name="status" value="declined">
                        <button type="submit" class="btn-sm btn-sm-decline" title="Mark Out">OUT</button>
                      </form>
                    <% } %>
                    <% if (player.status !== 'pending') { %>
                      <form method="POST" action="/admin/status">
                        <input type="hidden" name="player_id" value="<%= player.id %>">
                        <input type="hidden" name="status" value="pending">
                        <button type="submit" class="btn-sm btn-sm-reset" title="Reset to Pending">RESET</button>
                      </form>
                    <% } %>
                    <form method="POST" action="/admin/send-email">
                      <input type="hidden" name="player_id" value="<%= player.id %>">
                      <button type="submit" class="btn-sm btn-sm-email" title="Send Confirmation Email">&#9993;</button>
                    </form>
                    <form method="POST" action="/admin/remove-player" onsubmit="return confirm('Remove <%= player.player_name %> from the roster?')">
                      <input type="hidden" name="player_id" value="<%= player.id %>">
                      <button type="submit" class="btn-sm btn-sm-remove" title="Remove Player">&times;</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <!-- Team Events / Calendar -->
    <div class="admin-section">
      <h2 class="profile-section-title">Team Calendar</h2>
      <p class="section-hint">Add practices, games, and tournaments. These appear on the public schedule.</p>

      <form method="POST" action="/admin/add-team-event" class="add-player-form">
        <div class="form-row">
          <div class="form-group">
            <label>Event Type *</label>
            <select name="event_type" class="form-input" id="admin-event-type" onchange="toggleTournamentFields(this.value, 'add')">
              <option value="practice">Practice</option>
              <option value="game">Game</option>
              <option value="tournament">Tournament</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="form-group">
            <label>Title *</label>
            <input type="text" name="title" required class="form-input" placeholder="e.g. Practice at Twin Lakes">
          </div>
        </div>
        <div id="single-date-row" class="form-row" style="grid-template-columns:1fr 1fr 1fr;">
          <div class="form-group">
            <label>Start Date *</label>
            <input type="date" name="start_date" id="add-start-date" class="form-input">
          </div>
          <div class="form-group">
            <label>Start Time</label>
            <input type="time" name="start_time" id="add-start-time" class="form-input">
          </div>
          <div class="form-group" id="add-duration-group">
            <label>Duration</label>
            <select name="duration" id="add-duration" class="form-input">
              <option value="">None</option>
              <option value="60">1 hour</option>
              <option value="90">1.5 hours</option>
              <option value="120" selected>2 hours</option>
              <option value="150">2.5 hours</option>
              <option value="180">3 hours</option>
              <option value="210">3.5 hours</option>
              <option value="240">4 hours</option>
              <option value="300">5 hours</option>
            </select>
          </div>
          <div class="form-group" id="add-end-date-group" style="display:none;">
            <label>End Date</label>
            <input type="date" name="end_date" class="form-input">
          </div>
        </div>

        <div id="multi-day-toggle" class="form-group" style="margin-bottom:0;">
          <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:14px; font-weight:600; color:var(--navy);">
            <input type="checkbox" id="multi-day-check" onchange="toggleMultiDay()">
            Repeat on multiple days
            <span style="font-weight:400; color:var(--gray-500); font-size:12px;">(same time &amp; location for each)</span>
          </label>
        </div>

        <div id="multi-day-picker" style="display:none; margin:12px 0 16px;">
          <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:12px;">
            <div class="form-group" style="margin:0;">
              <label>Start Time</label>
              <input type="time" id="multi-start-time" class="form-input">
            </div>
            <div class="form-group" style="margin:0;">
              <label>Duration</label>
              <select id="multi-duration" class="form-input">
                <option value="">None</option>
                <option value="60">1 hour</option>
                <option value="90">1.5 hours</option>
                <option value="120" selected>2 hours</option>
                <option value="150">2.5 hours</option>
                <option value="180">3 hours</option>
                <option value="210">3.5 hours</option>
                <option value="240">4 hours</option>
                <option value="300">5 hours</option>
              </select>
            </div>
          </div>
          <div class="multi-cal-wrap">
            <div class="calendar-header" style="margin-bottom:0;">
              <button type="button" class="cal-nav" id="mp-prev">&larr;</button>
              <h3 class="cal-month-title" id="mp-title" style="font-size:15px;"></h3>
              <button type="button" class="cal-nav" id="mp-next">&rarr;</button>
            </div>
            <div class="cal-grid" id="mp-grid">
              <div class="cal-day-header">S</div><div class="cal-day-header">M</div><div class="cal-day-header">T</div><div class="cal-day-header">W</div><div class="cal-day-header">T</div><div class="cal-day-header">F</div><div class="cal-day-header">S</div>
              <% for (let i = 0; i < 42; i++) { %><div class="cal-cell mp-cell" data-index="<%= i %>"></div><% } %>
            </div>
          </div>
          <div id="mp-selected-info" style="margin-top:10px; font-size:13px; color:var(--gray-500);">No dates selected</div>
          <div id="mp-hidden-dates"></div>
        </div>
        <% if (savedLocations.length > 0) { %>
        <div class="form-group">
          <label>Saved Locations</label>
          <select id="add-saved-loc" class="form-input" onchange="applySavedLocation(this, 'add')">
            <option value="">— Select a saved location —</option>
            <% savedLocations.forEach(loc => { %>
              <option value="<%= loc.id %>" data-name="<%= loc.location_name %>" data-address="<%= loc.address %>"><%= loc.location_name %> — <%= loc.address %></option>
            <% }); %>
          </select>
        </div>
        <% } %>
        <div class="form-group">
          <label>Search Location</label>
          <div style="display:flex; gap:8px;">
            <input type="text" id="add-loc-search" class="form-input" placeholder="Type a place name, e.g. Twin Lakes Park Sarasota" style="flex:1;">
            <button type="button" class="btn btn-secondary" onclick="searchLocation('add')" style="white-space:nowrap;">Search</button>
          </div>
          <div id="add-loc-results" class="loc-results"></div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Location Name</label>
            <input type="text" name="location_name" id="add-loc-name" class="form-input" placeholder="Filled by search or type manually">
          </div>
          <div class="form-group">
            <label>Address</label>
            <input type="text" name="address" id="add-loc-address" class="form-input" placeholder="Filled by search or type manually">
          </div>
        </div>
        <div class="form-group">
          <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:13px;">
            <input type="checkbox" name="save_location" value="1"> Save this location for future events
          </label>
        </div>
        <div class="form-group" id="add-opponent-group" style="display:none;">
          <label>Opponent</label>
          <input type="text" name="opponent_name" id="add-opponent-name" class="form-input" placeholder="Opponent team name">
        </div>
        <div class="form-group">
          <label>Notes</label>
          <input type="text" name="notes" class="form-input" placeholder="Optional details">
        </div>
        <div id="add-tournament-fields" style="display:none;">
          <div class="form-group">
            <label>Hotel Info</label>
            <textarea name="hotel_info" class="form-input" rows="3" placeholder="Preferred hotels, rates, booking info..."></textarea>
          </div>
          <div class="form-group">
            <label>Carpool Info</label>
            <textarea name="carpool_info" class="form-input" rows="3" placeholder="Carpool coordination, meeting points, departure times..."></textarea>
          </div>
        </div>
        <button type="submit" class="btn btn-confirm">Add Event</button>
      </form>

      <!-- Admin Calendar -->
      <div class="calendar-section" style="margin-top:24px;">
        <div class="calendar-header">
          <button type="button" class="cal-nav" id="adm-cal-prev">&larr;</button>
          <h3 class="cal-month-title" id="adm-cal-title"></h3>
          <button type="button" class="cal-nav" id="adm-cal-next">&rarr;</button>
        </div>
        <div class="cal-grid">
          <div class="cal-day-header">Sun</div><div class="cal-day-header">Mon</div><div class="cal-day-header">Tue</div><div class="cal-day-header">Wed</div><div class="cal-day-header">Thu</div><div class="cal-day-header">Fri</div><div class="cal-day-header">Sat</div>
          <% for (let i = 0; i < 42; i++) { %><div class="cal-cell adm-cal-cell" data-index="<%= i %>"></div><% } %>
        </div>
        <div style="display:flex; gap:12px; margin-top:8px; font-size:11px; color:var(--gray-500); flex-wrap:wrap;">
          <span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#16a34a;vertical-align:middle;"></span> Practice</span>
          <span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#111827;vertical-align:middle;"></span> Game</span>
          <span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#2563eb;vertical-align:middle;"></span> Tournament</span>
          <span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#dc2626;vertical-align:middle;"></span> Player Absence</span>
        </div>
      </div>
      <script>
      (function(){
        const TE = <%- JSON.stringify(teamEvents.map(e => ({ type: e.event_type, title: e.title, start_date: e.start_date, end_date: e.end_date, start_time: e.start_time || '', location_name: e.location_name || '' }))) %>;
        <% const playerMap = {}; players.forEach(p => { playerMap[p.id] = p.player_name; }); %>
        const ABS = <%- JSON.stringify(allEvents.map(e => ({ start_date: e.start_date, end_date: e.end_date, player_name: playerMap[e.player_id] || 'Unknown', notes: e.notes || '' }))) %>;
        const TC = { practice:'#16a34a', game:'#111827', tournament:'#2563eb', other:'#6b7280' };
        const TL = { practice:'Practice', game:'Game', tournament:'Tournament', other:'Other' };
        const today = new Date();
        let cMonth = today.getMonth(), cYear = today.getFullYear();

        const flyout = document.createElement('div');
        flyout.className = 'cal-flyout';
        flyout.style.display = 'none';
        document.body.appendChild(flyout);

        function showFlyout(dot, html) {
          flyout.innerHTML = html;
          flyout.style.display = 'block';
          const dr = dot.getBoundingClientRect();
          const fr = flyout.getBoundingClientRect();
          let top = dr.top - fr.height - 8;
          let left = dr.left + dr.width / 2 - fr.width / 2;
          if (top < 4) top = dr.bottom + 8;
          if (left < 4) left = 4;
          if (left + fr.width > window.innerWidth - 4) left = window.innerWidth - fr.width - 4;
          flyout.style.top = top + window.scrollY + 'px';
          flyout.style.left = left + 'px';
        }

        function hideFlyout() { flyout.style.display = 'none'; }

        function fmtDate(d) {
          const [y,m,dd] = d.split('-');
          return parseInt(m) + '/' + parseInt(dd);
        }

        function fmtTime(t) {
          if (!t) return '';
          var s = t.replace(/[{}"]/g, '').split(',').filter(Boolean).pop() || '';
          if (!s || !s.includes(':')) return '';
          const [h,m] = s.split(':');
          const hr = parseInt(h);
          if (isNaN(hr)) return '';
          const ampm = hr >= 12 ? 'PM' : 'AM';
          return ((hr % 12) || 12) + ':' + m + ' ' + ampm;
        }

        function attachFlyout(dot, html) {
          dot.addEventListener('mouseenter', function() { showFlyout(dot, html); });
          dot.addEventListener('mouseleave', hideFlyout);
        }

        function renderAdmCal() {
          const firstDay = new Date(cYear, cMonth, 1).getDay();
          const daysInMonth = new Date(cYear, cMonth + 1, 0).getDate();
          document.getElementById('adm-cal-title').textContent = new Date(cYear, cMonth).toLocaleDateString('en-US', { month:'long', year:'numeric' });
          const cells = document.querySelectorAll('.adm-cal-cell');
          cells.forEach((cell, i) => {
            cell.innerHTML = ''; cell.className = 'cal-cell adm-cal-cell';
            const day = i - firstDay + 1;
            if (day >= 1 && day <= daysInMonth) {
              const ds = cYear + '-' + String(cMonth+1).padStart(2,'0') + '-' + String(day).padStart(2,'0');
              cell.innerHTML = '<span class="cal-day-num">' + day + '</span>';
              if (ds === today.toISOString().slice(0,10)) cell.classList.add('cal-today');
              TE.filter(e => { if (e.end_date) return ds >= e.start_date && ds <= e.end_date; return e.start_date === ds; }).forEach(ev => {
                const dot = document.createElement('div'); dot.className = 'cal-event-dot'; dot.style.background = TC[ev.type] || TC.other; cell.appendChild(dot);
                let html = '<div class="cal-flyout-title" style="color:' + (TC[ev.type] || TC.other) + '">' + (TL[ev.type] || 'Event') + '</div>';
                html += '<div class="cal-flyout-name">' + ev.title + '</div>';
                const parts = [];
                if (ev.start_time) parts.push(fmtTime(ev.start_time));
                if (ev.end_date && ev.end_date !== ev.start_date) parts.push(fmtDate(ev.start_date) + ' – ' + fmtDate(ev.end_date));
                if (ev.location_name) parts.push(ev.location_name);
                if (parts.length) html += '<div class="cal-flyout-detail">' + parts.join(' · ') + '</div>';
                attachFlyout(dot, html);
              });
              const dayAbs = ABS.filter(a => { if (a.end_date) return ds >= a.start_date && ds <= a.end_date; return a.start_date === ds; });
              if (dayAbs.length) {
                const dot = document.createElement('div'); dot.className = 'cal-event-dot'; dot.style.background = '#dc2626'; cell.appendChild(dot);
                let html = '<div class="cal-flyout-title" style="color:#dc2626">Player Absence' + (dayAbs.length > 1 ? 's' : '') + '</div>';
                dayAbs.forEach(a => {
                  html += '<div class="cal-flyout-name">' + a.player_name + '</div>';
                  const parts = [];
                  if (a.end_date && a.end_date !== a.start_date) parts.push(fmtDate(a.start_date) + ' – ' + fmtDate(a.end_date));
                  if (a.notes) parts.push(a.notes);
                  if (parts.length) html += '<div class="cal-flyout-detail">' + parts.join(' · ') + '</div>';
                });
                attachFlyout(dot, html);
              }
            } else { cell.classList.add('cal-empty'); }
          });
        }
        document.getElementById('adm-cal-prev').onclick = () => { cMonth--; if (cMonth<0){cMonth=11;cYear--;} renderAdmCal(); };
        document.getElementById('adm-cal-next').onclick = () => { cMonth++; if (cMonth>11){cMonth=0;cYear++;} renderAdmCal(); };
        renderAdmCal();
      })();
      </script>

      <% if (teamEvents.length > 0) { %>
        <table class="admin-table" style="margin-top:20px; min-width:auto;">
          <thead>
            <tr>
              <th>Type</th>
              <th>Title</th>
              <th>Date</th>
              <th>Time</th>
              <th>Location</th>
              <th>RSVPs</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% teamEvents.forEach(ev => { %>
              <tr>
                <td>
                  <span class="te-type-badge" style="background:<%= ev.event_type === 'practice' ? '#16a34a' : ev.event_type === 'game' ? '#111827' : ev.event_type === 'tournament' ? '#2563eb' : '#6b7280' %>; font-size:10px;">
                    <%= ev.event_type === 'practice' ? 'Practice' : ev.event_type === 'game' ? 'Game' : ev.event_type === 'tournament' ? 'Tournament' : 'Other' %>
                  </span>
                </td>
                <td class="td-bold"><a href="/event/<%= ev.id %>" style="color:inherit;text-decoration:none;"><%= ev.title %></a><% if (ev.event_type === 'game' && ev.our_score != null) { %> <span style="font-weight:400;font-size:12px;color:<%= ev.our_score > ev.opponent_score ? '#16a34a' : ev.our_score < ev.opponent_score ? '#dc2626' : '#854d0e' %>;"><%= ev.our_score > ev.opponent_score ? 'W' : ev.our_score < ev.opponent_score ? 'L' : 'T' %> <%= ev.our_score %>-<%= ev.opponent_score %></span><% } %></td>
                <td style="white-space:nowrap; font-size:13px;"><%= new Date(ev.start_date + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %><% if (ev.end_date) { %>&ndash;<%= new Date(ev.end_date + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %><% } %></td>
                <td style="font-size:13px; white-space:nowrap;"><% if (ev.start_time) { const [_h,_m] = ev.start_time.split(':'); const _hr = parseInt(_h); %><%= (_hr % 12 || 12) + ':' + _m.slice(0,2) + ' ' + (_hr >= 12 ? 'PM' : 'AM') %><% if (ev.end_time) { const [_eh,_em] = ev.end_time.split(':'); const _ehr = parseInt(_eh); %><span style="color:var(--gray-400);"> &ndash; </span><%= (_ehr % 12 || 12) + ':' + _em.slice(0,2) + ' ' + (_ehr >= 12 ? 'PM' : 'AM') %><% } %><% } else { %>-<% } %></td>
                <td style="font-size:13px;"><%= ev.location_name || ev.address || '-' %></td>
                <td style="text-align:center; white-space:nowrap;">
                  <% const rc = rsvpCounts[ev.id] || { yes: 0, no: 0, maybe: 0 }; %>
                  <span style="cursor:pointer;" onclick="viewRsvps(<%= ev.id %>, '<%= ev.title.replace(/'/g, "\\'") %>')" title="Click for details">
                    <span style="color:#16a34a;font-weight:800;font-size:13px;"><%= rc.yes %></span><span style="color:var(--gray-300);"> / </span><span style="color:#d97706;font-weight:800;font-size:13px;"><%= rc.maybe %></span><span style="color:var(--gray-300);"> / </span><span style="color:#dc2626;font-weight:800;font-size:13px;"><%= rc.no %></span>
                  </span>
                </td>
                <td>
                  <div class="admin-action-row">
                    <a href="/event/<%= ev.id %>" class="btn-sm btn-sm-email" style="font-size:11px;padding:3px 8px;text-decoration:none;">View</a>
                    <% if (ev.event_type === 'game') { %>
                    <a href="/event/<%= ev.id %>#lineup-grid-section" class="btn-sm btn-sm-email" style="font-size:11px;padding:3px 8px;text-decoration:none;">Lineup</a>
                    <% } %>
                    <button type="button" class="btn-sm btn-sm-email" title="Edit" onclick='editTeamEvent(<%- JSON.stringify({id:ev.id,event_type:ev.event_type,title:ev.title,start_date:ev.start_date,start_time:ev.start_time||"",end_date:ev.end_date||"",end_time:ev.end_time||"",location_name:ev.location_name||"",address:ev.address||"",notes:ev.notes||"",hotel_info:ev.hotel_info||"",carpool_info:ev.carpool_info||"",opponent_name:ev.opponent_name||""}) %>)'>&#9998;</button>
                    <form method="POST" action="/admin/remove-team-event" onsubmit="return confirm('Remove this event?')" style="margin:0;">
                      <input type="hidden" name="event_id" value="<%= ev.id %>">
                      <button type="submit" class="btn-sm btn-sm-remove">&times;</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <p style="color:#6b7280; margin-top:16px; font-size:14px;">No events scheduled yet.</p>
      <% } %>
      <div style="margin-top:12px; display:flex; gap:8px; flex-wrap:wrap;">
        <a href="/admin/programs" class="btn btn-secondary" style="text-decoration:none; font-size:13px; padding:8px 16px;">Programs</a>
        <a href="/admin/quizzes" class="btn btn-secondary" style="text-decoration:none; font-size:13px; padding:8px 16px;">Quizzes</a>
        <a href="/admin/blank-lineup" class="btn btn-secondary" style="text-decoration:none; font-size:13px; padding:8px 16px;" target="_blank">Print Blank Lineup Cards</a>
        <a href="/stats" class="btn btn-secondary" style="text-decoration:none; font-size:13px; padding:8px 16px;">Player Stats</a>
      </div>
    </div>

    <!-- Edit Team Event Modal -->
    <div id="edit-te-modal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); z-index:100; overflow-y:auto;">
      <div style="background:white; border-radius:16px; padding:28px; max-width:600px; width:90%; margin:60px auto;">
        <h3 style="font-size:18px; font-weight:800; color:var(--navy); margin-bottom:16px;">Edit Event</h3>
        <form method="POST" action="/admin/edit-team-event">
          <input type="hidden" name="event_id" id="edit-te-id">
          <div class="form-row">
            <div class="form-group">
              <label>Event Type</label>
              <select name="event_type" id="edit-te-type" class="form-input" onchange="toggleTournamentFields(this.value, 'edit')">
                <option value="practice">Practice</option>
                <option value="game">Game</option>
                <option value="tournament">Tournament</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="form-group">
              <label>Title *</label>
              <input type="text" name="title" id="edit-te-title" required class="form-input">
            </div>
          </div>
          <div class="form-row" id="edit-date-row" style="grid-template-columns:1fr 1fr 1fr;">
            <div class="form-group">
              <label>Start Date *</label>
              <input type="date" name="start_date" id="edit-te-start-date" required class="form-input">
            </div>
            <div class="form-group">
              <label>Start Time</label>
              <input type="time" name="start_time" id="edit-te-start-time" class="form-input">
            </div>
            <div class="form-group" id="edit-duration-group">
              <label>Duration</label>
              <select name="duration" id="edit-te-duration" class="form-input">
                <option value="">None</option>
                <option value="60">1 hour</option>
                <option value="90">1.5 hours</option>
                <option value="120">2 hours</option>
                <option value="150">2.5 hours</option>
                <option value="180">3 hours</option>
                <option value="210">3.5 hours</option>
                <option value="240">4 hours</option>
                <option value="300">5 hours</option>
              </select>
            </div>
            <div class="form-group" id="edit-end-date-group" style="display:none;">
              <label>End Date</label>
              <input type="date" name="end_date" id="edit-te-end-date" class="form-input">
            </div>
          </div>
          <% if (savedLocations.length > 0) { %>
          <div class="form-group">
            <label>Saved Locations</label>
            <select id="edit-saved-loc" class="form-input" onchange="applySavedLocation(this, 'edit')">
              <option value="">— Select a saved location —</option>
              <% savedLocations.forEach(loc => { %>
                <option value="<%= loc.id %>" data-name="<%= loc.location_name %>" data-address="<%= loc.address %>"><%= loc.location_name %> — <%= loc.address %></option>
              <% }); %>
            </select>
          </div>
          <% } %>
          <div class="form-group">
            <label>Search Location</label>
            <div style="display:flex; gap:8px;">
              <input type="text" id="edit-loc-search" class="form-input" placeholder="Type a place name to search" style="flex:1;">
              <button type="button" class="btn btn-secondary" onclick="searchLocation('edit')" style="white-space:nowrap;">Search</button>
            </div>
            <div id="edit-loc-results" class="loc-results"></div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Location Name</label>
              <input type="text" name="location_name" id="edit-te-location" class="form-input">
            </div>
            <div class="form-group">
              <label>Address</label>
              <input type="text" name="address" id="edit-te-address" class="form-input">
            </div>
          </div>
          <div class="form-group">
            <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:13px;">
              <input type="checkbox" name="save_location" value="1"> Save this location for future events
            </label>
          </div>
          <div class="form-group" id="edit-opponent-group" style="display:none;">
            <label>Opponent</label>
            <input type="text" name="opponent_name" id="edit-te-opponent" class="form-input" placeholder="Opponent team name">
          </div>
          <div class="form-group">
            <label>Notes</label>
            <input type="text" name="notes" id="edit-te-notes" class="form-input">
          </div>
          <div id="edit-tournament-fields" style="display:none;">
            <div class="form-group">
              <label>Hotel Info</label>
              <textarea name="hotel_info" id="edit-te-hotel" class="form-input" rows="3"></textarea>
            </div>
            <div class="form-group">
              <label>Carpool Info</label>
              <textarea name="carpool_info" id="edit-te-carpool" class="form-input" rows="3"></textarea>
            </div>
          </div>
          <div style="display:flex; gap:12px; margin-top:16px;">
            <button type="submit" class="btn btn-confirm" style="flex:1;">Save Changes</button>
            <button type="button" class="btn btn-secondary" style="flex:1;" onclick="closeEditTE()">Cancel</button>
          </div>
        </form>
      </div>
    </div>

    <script>
      function searchLocation(mode) {
        var inputId = mode === 'edit' ? 'edit-loc-search' : 'add-loc-search';
        var resultsId = mode === 'edit' ? 'edit-loc-results' : 'add-loc-results';
        var q = document.getElementById(inputId).value.trim();
        if (!q) return;
        var resultsEl = document.getElementById(resultsId);
        resultsEl.innerHTML = '<div class="loc-loading">Searching...</div>';
        resultsEl.style.display = 'block';
        fetch('/api/location-search?q=' + encodeURIComponent(q))
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (!data.length) {
              resultsEl.innerHTML = '<div class="loc-loading">No results found. Try adding a city or state.</div>';
              return;
            }
            var html = '';
            data.forEach(function(r, i) {
              html += '<div class="loc-result-item" data-idx="' + i + '" data-mode="' + mode + '">';
              html += '<div class="loc-result-name">' + r.name + '</div>';
              html += '<div class="loc-result-addr">' + r.address + '</div>';
              html += '</div>';
            });
            resultsEl._data = data;
            resultsEl.innerHTML = html;
          })
          .catch(function() {
            resultsEl.innerHTML = '<div class="loc-loading">Search failed. Try again.</div>';
          });
      }

      document.addEventListener('click', function(e) {
        var item = e.target.closest('.loc-result-item');
        if (!item) return;
        var mode = item.dataset.mode;
        var idx = parseInt(item.dataset.idx);
        var resultsEl = document.getElementById(mode + '-loc-results');
        var r = resultsEl._data[idx];
        if (mode === 'edit') {
          document.getElementById('edit-te-location').value = r.name;
          document.getElementById('edit-te-address').value = r.address;
          document.getElementById('edit-loc-search').value = '';
        } else {
          document.getElementById('add-loc-name').value = r.name;
          document.getElementById('add-loc-address').value = r.address;
          document.getElementById('add-loc-search').value = '';
        }
        resultsEl.style.display = 'none';
      });

      document.querySelectorAll('[id$="-loc-search"]').forEach(function(el) {
        el.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            searchLocation(el.id.startsWith('edit') ? 'edit' : 'add');
          }
        });
      });

      function toggleTournamentFields(type, mode) {
        const id = mode === 'edit' ? 'edit-tournament-fields' : 'add-tournament-fields';
        document.getElementById(id).style.display = type === 'tournament' ? 'block' : 'none';
        const oppId = mode === 'edit' ? 'edit-opponent-group' : 'add-opponent-group';
        document.getElementById(oppId).style.display = type === 'game' ? 'block' : 'none';
        if (mode === 'add') {
          const show = type !== 'tournament';
          document.getElementById('multi-day-toggle').style.display = show ? '' : 'none';
          if (!show) { document.getElementById('multi-day-check').checked = false; toggleMultiDay(); }
          document.getElementById('add-duration-group').style.display = type === 'tournament' ? 'none' : '';
          document.getElementById('add-end-date-group').style.display = type === 'tournament' ? '' : 'none';
          var row = document.getElementById('single-date-row');
          row.style.gridTemplateColumns = type === 'tournament' ? '1fr 1fr 1fr' : '1fr 1fr 1fr';
        } else {
          document.getElementById('edit-duration-group').style.display = type === 'tournament' ? 'none' : '';
          document.getElementById('edit-end-date-group').style.display = type === 'tournament' ? '' : 'none';
        }
      }

      function applySavedLocation(sel, mode) {
        var opt = sel.options[sel.selectedIndex];
        if (!opt || !opt.value) return;
        var name = opt.dataset.name;
        var addr = opt.dataset.address;
        if (mode === 'edit') {
          document.getElementById('edit-te-location').value = name;
          document.getElementById('edit-te-address').value = addr;
        } else {
          document.getElementById('add-loc-name').value = name;
          document.getElementById('add-loc-address').value = addr;
        }
      }

      // --- Multi-Day Picker ---
      var mpSelectedDates = new Set();
      var mpMonth, mpYear;
      (function() {
        var t = new Date(); mpMonth = t.getMonth(); mpYear = t.getFullYear();
      })();

      function toggleMultiDay() {
        var on = document.getElementById('multi-day-check').checked;
        document.getElementById('multi-day-picker').style.display = on ? '' : 'none';
        document.getElementById('single-date-row').style.display = on ? 'none' : '';
        // Disable the single-date inputs when multi-day is active so the form
        // doesn't submit duplicate start_time/duration fields alongside the
        // hidden values injected by the multi-day picker.
        var addStartTime = document.getElementById('add-start-time');
        var addDuration = document.getElementById('add-duration');
        if (on) {
          document.getElementById('add-start-date').removeAttribute('required');
          document.getElementById('add-start-date').value = '';
          addStartTime.disabled = true;
          addDuration.disabled = true;
          renderMpCal();
        } else {
          document.getElementById('add-start-date').setAttribute('required', '');
          addStartTime.disabled = false;
          addDuration.disabled = false;
        }
      }

      function renderMpCal() {
        var firstDay = new Date(mpYear, mpMonth, 1).getDay();
        var daysInMonth = new Date(mpYear, mpMonth + 1, 0).getDate();
        document.getElementById('mp-title').textContent = new Date(mpYear, mpMonth).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
        var cells = document.querySelectorAll('.mp-cell');
        cells.forEach(function(cell, i) {
          cell.innerHTML = ''; cell.className = 'cal-cell mp-cell'; cell.onclick = null; cell.style.cursor = '';
          var day = i - firstDay + 1;
          if (day >= 1 && day <= daysInMonth) {
            var ds = mpYear + '-' + String(mpMonth+1).padStart(2,'0') + '-' + String(day).padStart(2,'0');
            cell.innerHTML = '<span class="cal-day-num">' + day + '</span>';
            cell.dataset.date = ds;
            cell.style.cursor = 'pointer';
            if (mpSelectedDates.has(ds)) cell.classList.add('mp-selected');
            var today = new Date().toISOString().slice(0,10);
            if (ds === today) cell.classList.add('cal-today');
            cell.onclick = function() { toggleMpDate(ds, this); };
          } else {
            cell.classList.add('cal-empty');
            cell.dataset.date = '';
          }
        });
      }

      function toggleMpDate(ds, cell) {
        if (mpSelectedDates.has(ds)) { mpSelectedDates.delete(ds); cell.classList.remove('mp-selected'); }
        else { mpSelectedDates.add(ds); cell.classList.add('mp-selected'); }
        updateMpInfo();
      }

      function updateMpInfo() {
        var sorted = Array.from(mpSelectedDates).sort();
        var info = document.getElementById('mp-selected-info');
        var hidden = document.getElementById('mp-hidden-dates');
        if (sorted.length === 0) {
          info.textContent = 'No dates selected';
          hidden.innerHTML = '';
          return;
        }
        var labels = sorted.map(function(d) {
          return new Date(d + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
        });
        info.innerHTML = '<strong>' + sorted.length + ' date' + (sorted.length > 1 ? 's' : '') + ' selected:</strong> ' + labels.join(', ');
        hidden.innerHTML = sorted.map(function(d) { return '<input type="hidden" name="dates" value="' + d + '">'; }).join('');
        var st = document.getElementById('multi-start-time').value;
        var dur = document.getElementById('multi-duration').value;
        if (st) hidden.innerHTML += '<input type="hidden" name="start_time" value="' + st + '">';
        if (dur) hidden.innerHTML += '<input type="hidden" name="duration" value="' + dur + '">';
      }

      document.getElementById('multi-start-time').addEventListener('change', updateMpInfo);
      document.getElementById('multi-duration').addEventListener('change', updateMpInfo);
      document.getElementById('mp-prev').onclick = function() { mpMonth--; if (mpMonth<0){mpMonth=11;mpYear--;} renderMpCal(); };
      document.getElementById('mp-next').onclick = function() { mpMonth++; if (mpMonth>11){mpMonth=0;mpYear++;} renderMpCal(); };

      function editTeamEvent(ev) {
        document.getElementById('edit-te-id').value = ev.id;
        document.getElementById('edit-te-type').value = ev.event_type;
        document.getElementById('edit-te-title').value = ev.title;
        document.getElementById('edit-te-start-date').value = ev.start_date;
        document.getElementById('edit-te-start-time').value = ev.start_time;
        document.getElementById('edit-te-end-date').value = ev.end_date;
        document.getElementById('edit-te-location').value = ev.location_name;
        document.getElementById('edit-te-address').value = ev.address;
        document.getElementById('edit-te-notes').value = ev.notes;
        document.getElementById('edit-te-hotel').value = ev.hotel_info;
        document.getElementById('edit-te-carpool').value = ev.carpool_info;
        document.getElementById('edit-te-opponent').value = ev.opponent_name || '';
        var dur = '';
        if (ev.start_time && ev.end_time && ev.event_type !== 'tournament') {
          var sp = ev.start_time.split(':').map(Number);
          var ep = ev.end_time.split(':').map(Number);
          var diff = (ep[0]*60+ep[1]) - (sp[0]*60+sp[1]);
          if (diff > 0) dur = String(diff);
        }
        document.getElementById('edit-te-duration').value = dur;
        toggleTournamentFields(ev.event_type, 'edit');
        document.getElementById('edit-te-modal').style.display = 'block';
      }

      function closeEditTE() {
        document.getElementById('edit-te-modal').style.display = 'none';
      }

      document.getElementById('edit-te-modal').addEventListener('click', function(e) {
        if (e.target === this) closeEditTE();
      });
    </script>

    <!-- Pending Fan Approvals -->
    <div class="admin-section" id="pending-fans-section" style="display:none;">
      <h2 class="profile-section-title" style="color:#dc2626;">Pending Fan Approvals</h2>
      <p class="section-hint">These fan accounts are waiting for your approval. Fans can only see the schedule. Deny access to any account you don't recognize.</p>
      <div id="pending-fans-list"></div>
    </div>

    <!-- User Account Management -->
    <div class="admin-section">
      <h2 class="profile-section-title">Accounts</h2>
      <p class="section-hint">Manage parent and fan login accounts, link multiple parents to the same player, reset passwords, or view the site as any user.</p>

      <div id="ua-list" style="margin-bottom:16px;"></div>

      <details style="margin-bottom:16px;">
        <summary style="cursor:pointer;font-weight:700;color:var(--navy);font-size:14px;margin-bottom:8px;">+ Create New Account</summary>
        <div class="add-player-form" style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;">
          <div style="flex:1;min-width:130px;">
            <label style="font-size:12px;color:#6b7280;">Name *</label>
            <input type="text" id="ua-name" placeholder="Parent name" style="width:100%;padding:8px;border:1px solid #d1d5db;border-radius:4px;">
          </div>
          <div style="flex:1;min-width:130px;">
            <label style="font-size:12px;color:#6b7280;">Username</label>
            <input type="text" id="ua-username" placeholder="Optional login name" style="width:100%;padding:8px;border:1px solid #d1d5db;border-radius:4px;">
          </div>
          <div style="flex:1;min-width:130px;">
            <label style="font-size:12px;color:#6b7280;">Phone *</label>
            <input type="tel" id="ua-phone" placeholder="(941) 555-1234" style="width:100%;padding:8px;border:1px solid #d1d5db;border-radius:4px;">
          </div>
          <div style="flex:1;min-width:130px;">
            <label style="font-size:12px;color:#6b7280;">Password *</label>
            <input type="text" id="ua-password" placeholder="Min 6 chars" style="width:100%;padding:8px;border:1px solid #d1d5db;border-radius:4px;">
          </div>
          <div style="flex:1;min-width:160px;">
            <label style="font-size:12px;color:#6b7280;">Link Players</label>
            <select id="ua-players" multiple style="width:100%;padding:8px;border:1px solid #d1d5db;border-radius:4px;min-height:60px;font-size:13px;">
              <% players.filter(p => p.status === 'confirmed').forEach(p => { %>
                <option value="<%= p.id %>"><%= p.player_name %></option>
              <% }); %>
            </select>
          </div>
          <button type="button" class="btn btn-confirm" onclick="createAccount()" style="white-space:nowrap;">Create Account</button>
        </div>
      </details>
    </div>

    <!-- Account Modals -->
    <div id="ua-reset-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:100;align-items:center;justify-content:center;">
      <div style="background:white;border-radius:16px;padding:28px;max-width:400px;width:90%;margin:auto;position:relative;top:50%;transform:translateY(-50%);">
        <h3 style="font-size:18px;font-weight:800;color:var(--navy);margin-bottom:16px;">Reset Password</h3>
        <p id="ua-reset-name" style="font-size:14px;color:#6b7280;margin-bottom:12px;"></p>
        <input type="text" id="ua-reset-pw" placeholder="New password (min 6 chars)" style="width:100%;padding:10px;border:1px solid #d1d5db;border-radius:6px;margin-bottom:12px;box-sizing:border-box;">
        <input type="hidden" id="ua-reset-id">
        <div style="display:flex;gap:12px;">
          <button class="btn btn-confirm" style="flex:1;" onclick="submitResetPassword()">Reset Password</button>
          <button class="btn btn-secondary" style="flex:1;" onclick="document.getElementById('ua-reset-modal').style.display='none'">Cancel</button>
        </div>
      </div>
    </div>

    <div id="ua-link-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:100;align-items:center;justify-content:center;">
      <div style="background:white;border-radius:16px;padding:28px;max-width:400px;width:90%;margin:auto;position:relative;top:50%;transform:translateY(-50%);">
        <h3 style="font-size:18px;font-weight:800;color:var(--navy);margin-bottom:16px;">Link Player</h3>
        <p id="ua-link-name" style="font-size:14px;color:#6b7280;margin-bottom:12px;"></p>
        <select id="ua-link-player" style="width:100%;padding:10px;border:1px solid #d1d5db;border-radius:6px;margin-bottom:12px;">
          <% players.filter(p => p.status === 'confirmed').forEach(p => { %>
            <option value="<%= p.id %>"><%= p.player_name %></option>
          <% }); %>
        </select>
        <input type="hidden" id="ua-link-id">
        <div style="display:flex;gap:12px;">
          <button class="btn btn-confirm" style="flex:1;" onclick="submitLinkPlayer()">Link Player</button>
          <button class="btn btn-secondary" style="flex:1;" onclick="document.getElementById('ua-link-modal').style.display='none'">Cancel</button>
        </div>
      </div>
    </div>

    <div id="ua-edit-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:100;align-items:center;justify-content:center;">
      <div style="background:white;border-radius:16px;padding:28px;max-width:400px;width:90%;margin:auto;position:relative;top:50%;transform:translateY(-50%);">
        <h3 style="font-size:18px;font-weight:800;color:var(--navy);margin-bottom:16px;">Edit Account</h3>
        <input type="hidden" id="ua-edit-id">
        <div style="margin-bottom:12px;">
          <label style="font-size:12px;color:#6b7280;font-weight:600;">Name</label>
          <input type="text" id="ua-edit-name" style="width:100%;padding:10px;border:1px solid #d1d5db;border-radius:6px;box-sizing:border-box;">
        </div>
        <div style="margin-bottom:12px;">
          <label style="font-size:12px;color:#6b7280;font-weight:600;">Username <span style="font-weight:400;color:#9ca3af;">(optional)</span></label>
          <input type="text" id="ua-edit-username" placeholder="e.g. jsmith" style="width:100%;padding:10px;border:1px solid #d1d5db;border-radius:6px;box-sizing:border-box;">
        </div>
        <div style="margin-bottom:12px;">
          <label style="font-size:12px;color:#6b7280;font-weight:600;">Phone</label>
          <input type="tel" id="ua-edit-phone" style="width:100%;padding:10px;border:1px solid #d1d5db;border-radius:6px;box-sizing:border-box;">
        </div>
        <div style="display:flex;gap:12px;">
          <button class="btn btn-confirm" style="flex:1;" onclick="submitEditAccount()">Save</button>
          <button class="btn btn-secondary" style="flex:1;" onclick="document.getElementById('ua-edit-modal').style.display='none'">Cancel</button>
        </div>
      </div>
    </div>

    <!-- Quick Create Account Modal (from roster) -->
    <div id="qa-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:100;align-items:center;justify-content:center;">
      <div style="background:white;border-radius:16px;padding:28px;max-width:420px;width:90%;margin:auto;position:relative;top:50%;transform:translateY(-50%);">
        <h3 style="font-size:18px;font-weight:800;color:var(--navy);margin-bottom:4px;">Create Parent Account</h3>
        <p id="qa-player-label" style="font-size:13px;color:#6b7280;margin-bottom:16px;"></p>
        <input type="hidden" id="qa-player-id">
        <div style="margin-bottom:12px;">
          <label style="font-size:12px;color:#6b7280;font-weight:600;">Parent Name</label>
          <input type="text" id="qa-name" style="width:100%;padding:10px;border:1px solid #d1d5db;border-radius:6px;box-sizing:border-box;">
        </div>
        <div style="margin-bottom:12px;">
          <label style="font-size:12px;color:#6b7280;font-weight:600;">Phone Number</label>
          <input type="tel" id="qa-phone" style="width:100%;padding:10px;border:1px solid #d1d5db;border-radius:6px;box-sizing:border-box;">
        </div>
        <div style="margin-bottom:16px;">
          <label style="font-size:12px;color:#6b7280;font-weight:600;">Password</label>
          <input type="text" id="qa-password" style="width:100%;padding:10px;border:1px solid #d1d5db;border-radius:6px;box-sizing:border-box;">
        </div>
        <div style="display:flex;gap:12px;">
          <button class="btn btn-confirm" style="flex:1;" onclick="submitQuickCreate()">Create & Send Text</button>
          <button class="btn btn-secondary" style="flex:1;" onclick="document.getElementById('qa-modal').style.display='none'">Cancel</button>
        </div>
      </div>
    </div>

    <script>
    function quickCreateAccount(playerId, parentName, parentPhone) {
      document.getElementById('qa-player-id').value = playerId;
      document.getElementById('qa-player-label').textContent = 'Linked player will be auto-selected';
      document.getElementById('qa-name').value = parentName;
      var ph = parentPhone.replace(/(\d{3})(\d{3})(\d{4})/, '($1) $2-$3');
      document.getElementById('qa-phone').value = ph;
      var pw = Math.random().toString(36).slice(-8);
      document.getElementById('qa-password').value = pw;
      document.getElementById('qa-modal').style.display = 'flex';
    }
    function submitQuickCreate() {
      var name = document.getElementById('qa-name').value.trim();
      var phone = document.getElementById('qa-phone').value.trim();
      var password = document.getElementById('qa-password').value.trim();
      var playerId = Number(document.getElementById('qa-player-id').value);
      if (!name || !phone || !password) return alert('All fields are required.');
      fetch('/admin/accounts/create', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ display_name: name, phone: phone, password: password, player_ids: [playerId] })
      }).then(r => r.json()).then(function(d) {
        if (d.ok) {
          document.getElementById('qa-modal').style.display = 'none';
          alert('Account created!' + (d.smsSent ? ' Login credentials sent via text.' : ' SMS not configured — share credentials manually.'));
          location.reload();
        } else { alert(d.error); }
      });
    }
    document.getElementById('qa-modal').addEventListener('click', function(e) { if (e.target === this) this.style.display = 'none'; });
    </script>

    <script>
    function loadPendingFans() {
      fetch('/admin/pending-fans').then(r => r.json()).then(function(fans) {
        var section = document.getElementById('pending-fans-section');
        if (fans.length === 0) { section.style.display = 'none'; return; }
        section.style.display = '';
        var html = '';
        fans.forEach(function(f) {
          var ph = f.phone.replace(/(\d{3})(\d{3})(\d{4})/, '($1) $2-$3');
          var pNames = (f.player_names || []).join(', ') || 'None';
          html += '<div style="display:flex;align-items:center;justify-content:space-between;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:12px 16px;margin-bottom:8px;flex-wrap:wrap;gap:8px;">';
          html += '<div><strong>' + f.display_name + '</strong> <span style="color:#6b7280;font-size:12px;">(' + ph + ')</span>';
          html += '<br><span style="font-size:12px;color:#6b7280;">Following: ' + pNames + '</span></div>';
          html += '<div style="display:flex;gap:6px;">';
          html += '<button onclick="approveFan(' + f.id + ')" style="background:#059669;color:#fff;border:none;border-radius:6px;padding:6px 14px;font-size:12px;font-weight:700;cursor:pointer;">Approve</button>';
          html += '<button onclick="denyFan(' + f.id + ',\'' + f.display_name.replace(/'/g, "\\'") + '\')" style="background:#dc2626;color:#fff;border:none;border-radius:6px;padding:6px 14px;font-size:12px;font-weight:700;cursor:pointer;">Deny</button>';
          html += '</div></div>';
        });
        document.getElementById('pending-fans-list').innerHTML = html;
      });
    }
    function approveFan(id) {
      fetch('/admin/accounts/' + id + '/approve', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(r => r.json()).then(function(d) { if (d.ok) { loadPendingFans(); loadAccounts(); } else alert(d.error); });
    }
    function denyFan(id, name) {
      if (!confirm('Deny and delete the fan request from ' + name + '?')) return;
      fetch('/admin/accounts/' + id + '/deny', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(r => r.json()).then(function(d) { if (d.ok) { loadPendingFans(); loadAccounts(); } else alert(d.error); });
    }

    function loadAccounts() {
      fetch('/admin/accounts').then(r => r.json()).then(list => {
        var approved = list.filter(function(a) { return a.approved; });
        if (approved.length === 0) {
          document.getElementById('ua-list').innerHTML = '<p style="color:#6b7280;font-size:13px;">No accounts yet.</p>';
          return;
        }
        var html = '<table style="width:100%;border-collapse:collapse;font-size:13px;">';
        html += '<tr style="background:#f3f4f6;"><th style="padding:8px;text-align:left;">Name</th><th style="padding:8px;text-align:left;">Role</th><th style="padding:8px;text-align:left;">Login</th><th style="padding:8px;text-align:left;">Players</th><th style="padding:8px;text-align:right;">Actions</th></tr>';
        approved.forEach(function(a) {
          var ph = a.phone.replace(/(\d{3})(\d{3})(\d{4})/, '($1) $2-$3');
          var roleBadge = a.role === 'fan'
            ? '<span style="background:#fef3c7;color:#92400e;font-size:10px;font-weight:700;padding:2px 6px;border-radius:4px;">FAN</span>'
            : '<span style="background:#d1fae5;color:#065f46;font-size:10px;font-weight:700;padding:2px 6px;border-radius:4px;">PARENT</span>';
          var pNames = a.players.map(function(p) {
            return '<span style="display:inline-flex;align-items:center;gap:2px;background:#e0e7ff;color:#3730a3;border-radius:4px;padding:2px 6px;font-size:11px;margin:1px;">' + p.name +
              ' <button onclick="unlinkPlayer(' + a.id + ',' + p.id + ')" style="background:none;border:none;color:#6366f1;cursor:pointer;font-size:13px;padding:0;line-height:1;" title="Unlink">&times;</button></span>';
          }).join(' ') || '<span style="color:#9ca3af;font-size:12px;">None</span>';
          var loginInfo = a.username ? '<strong>' + a.username + '</strong><br><span style="color:#9ca3af;font-size:11px;">' + ph + '</span>' : '<span style="font-family:monospace;font-size:12px;">' + ph + '</span>';
          html += '<tr style="border-bottom:1px solid #f3f4f6;">';
          html += '<td style="padding:8px;"><strong>' + a.display_name + '</strong></td>';
          html += '<td style="padding:8px;">' + roleBadge + '</td>';
          html += '<td style="padding:8px;">' + loginInfo + '</td>';
          html += '<td style="padding:8px;">' + pNames + '</td>';
          html += '<td style="padding:8px;text-align:right;white-space:nowrap;">';
          html += '<a href="/admin/impersonate/' + a.id + '" style="background:#7c3aed;color:#fff;border:none;border-radius:4px;padding:4px 8px;font-size:11px;cursor:pointer;text-decoration:none;margin-right:4px;" title="View site as this user">View As</a>';
          if (a.role === 'parent') {
            html += '<button onclick="makeStaff(' + a.id + ',\'' + a.display_name.replace(/'/g, "\\'") + '\')" style="background:#059669;color:#fff;border:none;border-radius:4px;padding:4px 8px;font-size:11px;cursor:pointer;margin-right:4px;" title="Add as staff member">Staff</button>';
          }
          if (a.role === 'fan') {
            html += '<button onclick="setRole(' + a.id + ',\'parent\')" style="background:#059669;color:#fff;border:none;border-radius:4px;padding:4px 8px;font-size:11px;cursor:pointer;margin-right:4px;" title="Upgrade to parent">Upgrade</button>';
          } else {
            html += '<button onclick="setRole(' + a.id + ',\'fan\')" style="background:#f59e0b;color:#fff;border:none;border-radius:4px;padding:4px 8px;font-size:11px;cursor:pointer;margin-right:4px;" title="Downgrade to fan">Fan</button>';
          }
          html += '<button onclick="showLinkPlayer(' + a.id + ',\'' + a.display_name.replace(/'/g, "\\'") + '\')" style="background:#3b82f6;color:#fff;border:none;border-radius:4px;padding:4px 8px;font-size:11px;cursor:pointer;margin-right:4px;" title="Link a player">Link</button>';
          html += '<button onclick="showEditAccount(' + a.id + ',\'' + a.display_name.replace(/'/g, "\\'") + '\',\'' + a.phone + '\',\'' + (a.username || '').replace(/'/g, "\\'") + '\')" style="background:#6b7280;color:#fff;border:none;border-radius:4px;padding:4px 8px;font-size:11px;cursor:pointer;margin-right:4px;" title="Edit">Edit</button>';
          html += '<button onclick="showResetPassword(' + a.id + ',\'' + a.display_name.replace(/'/g, "\\'") + '\')" style="background:#6b7280;color:#fff;border:none;border-radius:4px;padding:4px 8px;font-size:11px;cursor:pointer;margin-right:4px;" title="Reset password">PW</button>';
          html += '<button onclick="deleteAccount(' + a.id + ',\'' + a.display_name.replace(/'/g, "\\'") + '\')" style="background:none;border:none;color:#dc2626;cursor:pointer;font-size:12px;" title="Delete">&times;</button>';
          html += '</td></tr>';
        });
        html += '</table>';
        document.getElementById('ua-list').innerHTML = html;
      });
    }

    function createAccount() {
      var name = document.getElementById('ua-name').value.trim();
      var username = document.getElementById('ua-username').value.trim();
      var phone = document.getElementById('ua-phone').value.trim();
      var password = document.getElementById('ua-password').value.trim();
      var sel = document.getElementById('ua-players');
      var pids = Array.from(sel.selectedOptions).map(function(o) { return Number(o.value); });
      if (!name || !phone || !password) return alert('Name, phone, and password are required.');
      fetch('/admin/accounts/create', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ display_name: name, username: username || undefined, phone: phone, password: password, player_ids: pids })
      }).then(r => r.json()).then(function(d) {
        if (d.ok) {
          document.getElementById('ua-name').value = '';
          document.getElementById('ua-username').value = '';
          document.getElementById('ua-phone').value = '';
          document.getElementById('ua-password').value = '';
          sel.selectedIndex = -1;
          loadAccounts();
          alert('Account created!' + (d.smsSent ? ' Login credentials sent via text.' : ' SMS not configured — share the credentials manually.'));
        } else { alert(d.error); }
      });
    }

    function showResetPassword(id, name) {
      document.getElementById('ua-reset-id').value = id;
      document.getElementById('ua-reset-name').textContent = 'Reset password for ' + name;
      document.getElementById('ua-reset-pw').value = '';
      document.getElementById('ua-reset-modal').style.display = 'flex';
    }
    function submitResetPassword() {
      var id = document.getElementById('ua-reset-id').value;
      var pw = document.getElementById('ua-reset-pw').value.trim();
      if (!pw || pw.length < 6) return alert('Password must be at least 6 characters.');
      fetch('/admin/accounts/' + id + '/reset-password', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: pw })
      }).then(r => r.json()).then(function(d) {
        if (d.ok) {
          document.getElementById('ua-reset-modal').style.display = 'none';
          alert('Password reset successfully.');
        } else { alert(d.error); }
      });
    }

    function showLinkPlayer(id, name) {
      document.getElementById('ua-link-id').value = id;
      document.getElementById('ua-link-name').textContent = 'Link a player to ' + name;
      document.getElementById('ua-link-modal').style.display = 'flex';
    }
    function submitLinkPlayer() {
      var id = document.getElementById('ua-link-id').value;
      var pid = document.getElementById('ua-link-player').value;
      fetch('/admin/accounts/' + id + '/link-player', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ player_id: pid })
      }).then(r => r.json()).then(function(d) {
        if (d.ok) {
          document.getElementById('ua-link-modal').style.display = 'none';
          loadAccounts();
        } else { alert(d.error); }
      });
    }

    function unlinkPlayer(accountId, playerId) {
      if (!confirm('Unlink this player from the account?')) return;
      fetch('/admin/accounts/' + accountId + '/unlink-player', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ player_id: playerId })
      }).then(r => r.json()).then(function(d) { if (d.ok) loadAccounts(); });
    }

    function showEditAccount(id, name, phone, username) {
      document.getElementById('ua-edit-id').value = id;
      document.getElementById('ua-edit-name').value = name;
      document.getElementById('ua-edit-username').value = username || '';
      document.getElementById('ua-edit-phone').value = phone.replace(/(\d{3})(\d{3})(\d{4})/, '($1) $2-$3');
      document.getElementById('ua-edit-modal').style.display = 'flex';
    }
    function submitEditAccount() {
      var id = document.getElementById('ua-edit-id').value;
      var name = document.getElementById('ua-edit-name').value.trim();
      var username = document.getElementById('ua-edit-username').value.trim();
      var phone = document.getElementById('ua-edit-phone').value.trim();
      fetch('/admin/accounts/' + id + '/update', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ display_name: name, phone: phone, username: username })
      }).then(r => r.json()).then(function(d) {
        if (d.ok) {
          document.getElementById('ua-edit-modal').style.display = 'none';
          loadAccounts();
        } else { alert(d.error); }
      });
    }

    function makeStaff(id, name) {
      if (!confirm('Add ' + name + ' as a staff member?')) return;
      fetch('/admin/accounts/' + id + '/make-staff', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(r => r.json()).then(function(d) {
          if (d.ok) { alert(name + ' added to staff.'); location.reload(); }
          else alert(d.error);
        });
    }

    function setRole(id, role) {
      var label = role === 'parent' ? 'Upgrade this account to parent? They will see full team info.' : 'Downgrade this account to fan? They will only see the schedule.';
      if (!confirm(label)) return;
      fetch('/admin/accounts/' + id + '/set-role', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ role: role })
      }).then(r => r.json()).then(function(d) { if (d.ok) loadAccounts(); else alert(d.error); });
    }

    function deleteAccount(id, name) {
      if (!confirm('Delete the account for ' + name + '? This cannot be undone.')) return;
      fetch('/admin/accounts/' + id + '/delete', { method: 'POST' }).then(r => r.json()).then(function(d) {
        if (d.ok) loadAccounts();
      });
    }

    loadAccounts();
    loadPendingFans();

    ['ua-reset-modal','ua-link-modal','ua-edit-modal'].forEach(function(mid) {
      document.getElementById(mid).addEventListener('click', function(e) { if (e.target === this) this.style.display = 'none'; });
    });
    </script>

    <!-- Scorekeeper Management -->
    <div class="admin-section">
      <h2 class="profile-section-title">Scorekeepers</h2>
      <p class="section-hint">Scorekeepers can access the live scoring interface via a unique link sent to their phone/email.</p>

      <div id="sk-list" style="margin-bottom:16px;"></div>

      <div class="add-player-form" style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;">
        <div style="flex:1;min-width:120px;">
          <label style="font-size:12px;color:#6b7280;">Name</label>
          <input type="text" id="sk-name" placeholder="Name" style="width:100%;padding:8px;border:1px solid #d1d5db;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:120px;">
          <label style="font-size:12px;color:#6b7280;">Phone</label>
          <input type="text" id="sk-phone" placeholder="Phone" style="width:100%;padding:8px;border:1px solid #d1d5db;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label style="font-size:12px;color:#6b7280;">Email</label>
          <input type="text" id="sk-email" placeholder="Email" style="width:100%;padding:8px;border:1px solid #d1d5db;border-radius:4px;">
        </div>
        <button type="button" class="btn btn-confirm" onclick="addScoreKeeper()" style="white-space:nowrap;">Add Scorekeeper</button>
      </div>
    </div>

    <script>
    function loadScoreKeepers() {
      fetch('/admin/scorekeepers').then(r => r.json()).then(list => {
        if (list.length === 0) {
          document.getElementById('sk-list').innerHTML = '<p style="color:#6b7280;font-size:13px;">No scorekeepers added yet.</p>';
          return;
        }
        let html = '<table style="width:100%;border-collapse:collapse;font-size:13px;">';
        html += '<tr style="background:#f3f4f6;"><th style="padding:6px 8px;text-align:left;">Name</th><th>Phone</th><th>Email</th><th></th></tr>';
        list.forEach(sk => {
          html += '<tr style="border-bottom:1px solid #f3f4f6;"><td style="padding:6px 8px;"><strong>' + sk.name + '</strong></td>';
          html += '<td style="padding:6px 8px;">' + (sk.phone || '-') + '</td>';
          html += '<td style="padding:6px 8px;">' + (sk.email || '-') + '</td>';
          html += '<td style="padding:6px 8px;"><button onclick="removeScoreKeeper(' + sk.id + ')" style="background:none;border:none;color:#dc2626;cursor:pointer;font-size:12px;">Remove</button></td></tr>';
        });
        html += '</table>';
        document.getElementById('sk-list').innerHTML = html;
      });
    }
    function addScoreKeeper() {
      const name = document.getElementById('sk-name').value.trim();
      if (!name) return alert('Name is required');
      fetch('/admin/scorekeepers', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          phone: document.getElementById('sk-phone').value.trim(),
          email: document.getElementById('sk-email').value.trim()
        })
      }).then(r => r.json()).then(data => {
        if (data.ok) {
          document.getElementById('sk-name').value = '';
          document.getElementById('sk-phone').value = '';
          document.getElementById('sk-email').value = '';
          loadScoreKeepers();
          alert('Scorekeeper added! Link: ' + data.link);
        }
      });
    }
    function removeScoreKeeper(id) {
      if (!confirm('Remove this scorekeeper?')) return;
      fetch('/admin/scorekeepers/' + id + '/delete', { method: 'POST' }).then(() => loadScoreKeepers());
    }
    loadScoreKeepers();
    </script>

    <!-- Staff Management -->
    <div class="admin-section">
      <h2 class="profile-section-title">Staff Members</h2>
      <p class="section-hint">Staff can view the full roster, profiles, ratings, and contacts at <strong>/staff</strong> using their phone number. They cannot edit anything.</p>

      <form method="POST" action="/admin/add-staff" class="add-player-form">
        <div class="form-row" style="grid-template-columns:1fr 1fr;">
          <div class="form-group">
            <label>Name *</label>
            <input type="text" name="name" required class="form-input" placeholder="Coach name">
          </div>
          <div class="form-group">
            <label>Role</label>
            <input type="text" name="role" value="Coach" class="form-input" placeholder="Coach, Manager...">
          </div>
        </div>
        <div class="form-row" style="grid-template-columns:1fr 1fr;">
          <div class="form-group">
            <label>Phone *</label>
            <input type="tel" name="phone" required class="form-input" placeholder="(941) 555-1234">
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" class="form-input" placeholder="coach@email.com">
          </div>
        </div>
        <button type="submit" class="btn btn-confirm">Add Staff Member</button>
      </form>

      <% if (staff.length > 0) { %>
        <table class="admin-table" style="margin-top:20px; min-width:auto;">
          <thead>
            <tr>
              <th>Name</th>
              <th>Role</th>
              <th>Phone</th>
              <th>Email</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% staff.forEach(s => { %>
              <tr id="staff-row-<%= s.id %>">
                <td class="td-bold"><%= s.name %></td>
                <td><%= s.role %></td>
                <td class="td-mono"><%= s.phone.replace(/(\d{3})(\d{3})(\d{4})/, '($1) $2-$3') %></td>
                <td style="font-size:13px;"><%= s.email || '-' %></td>
                <td>
                  <div class="admin-action-row">
                    <button type="button" class="btn-sm btn-sm-email" title="Edit" onclick="editStaff(<%= s.id %>, '<%= s.name.replace(/'/g, "\\'") %>', '<%= s.role.replace(/'/g, "\\'") %>', '<%= s.phone %>', '<%= (s.email || '').replace(/'/g, "\\'") %>')">&#9998;</button>
                    <form method="POST" action="/admin/remove-staff" onsubmit="return confirm('Remove <%= s.name %>?')" style="margin:0;">
                      <input type="hidden" name="staff_id" value="<%= s.id %>">
                      <button type="submit" class="btn-sm btn-sm-remove">&times;</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <p style="color:#6b7280; margin-top:16px; font-size:14px;">No staff members added yet.</p>
      <% } %>

      <!-- Edit Staff Modal -->
      <div id="edit-staff-modal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); z-index:100; align-items:center; justify-content:center;">
        <div style="background:white; border-radius:16px; padding:28px; max-width:500px; width:90%; margin:auto; position:relative; top:50%; transform:translateY(-50%);">
          <h3 style="font-size:18px; font-weight:800; color:var(--navy); margin-bottom:16px;">Edit Staff Member</h3>
          <form method="POST" action="/admin/edit-staff">
            <input type="hidden" name="staff_id" id="edit-staff-id">
            <div class="form-group">
              <label>Name *</label>
              <input type="text" name="name" id="edit-staff-name" required class="form-input">
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Role</label>
                <input type="text" name="role" id="edit-staff-role" class="form-input">
              </div>
              <div class="form-group">
                <label>Phone *</label>
                <input type="tel" name="phone" id="edit-staff-phone" required class="form-input">
              </div>
            </div>
            <div class="form-group">
              <label>Email</label>
              <input type="email" name="email" id="edit-staff-email" class="form-input">
            </div>
            <div style="display:flex; gap:12px; margin-top:16px;">
              <button type="submit" class="btn btn-confirm" style="flex:1;">Save Changes</button>
              <button type="button" class="btn btn-secondary" style="flex:1;" onclick="closeEditStaff()">Cancel</button>
            </div>
          </form>
        </div>
      </div>

      <script>
        function editStaff(id, name, role, phone, email) {
          document.getElementById('edit-staff-id').value = id;
          document.getElementById('edit-staff-name').value = name;
          document.getElementById('edit-staff-role').value = role;
          document.getElementById('edit-staff-phone').value = phone.replace(/(\d{3})(\d{3})(\d{4})/, '($1) $2-$3');
          document.getElementById('edit-staff-email').value = email;
          document.getElementById('edit-staff-modal').style.display = 'flex';
        }
        function closeEditStaff() {
          document.getElementById('edit-staff-modal').style.display = 'none';
        }
        document.getElementById('edit-staff-modal').addEventListener('click', function(e) {
          if (e.target === this) closeEditStaff();
        });
      </script>
    </div>

    <!-- Add Player -->
    <div class="admin-section">
      <h2 class="profile-section-title">Add New Player</h2>
      <form method="POST" action="/admin/add-player" class="add-player-form">
        <div class="form-row">
          <div class="form-group">
            <label>Player Name *</label>
            <input type="text" name="player_name" required class="form-input" placeholder="First Last">
          </div>
          <div class="form-group">
            <label>Age</label>
            <select name="age" class="form-input">
              <option value="11">11</option>
              <option value="12">12</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Division</label>
            <input type="text" name="division" value="Major" class="form-input">
          </div>
          <div class="form-group">
            <label>Regular Season Team</label>
            <input type="text" name="team" class="form-input" placeholder="Team name">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Parent Name *</label>
            <input type="text" name="parent_name" required class="form-input" placeholder="First Last">
          </div>
          <div class="form-group">
            <label>Parent Phone *</label>
            <input type="tel" name="parent_phone" required class="form-input" placeholder="(941) 555-1234">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Parent Email</label>
            <input type="email" name="parent_email" class="form-input" placeholder="parent@email.com">
          </div>
          <div class="form-group" style="display:flex;align-items:end;">
            <p class="section-hint" style="margin:0;font-size:13px;">A confirmation email will be sent if provided</p>
          </div>
        </div>
        <button type="submit" class="btn btn-confirm">Add Player to Roster</button>
      </form>
    </div>
  </main>

  <!-- RSVP Modal -->
  <div id="rsvp-modal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); z-index:100; overflow-y:auto; align-items:flex-start; justify-content:center;">
    <div style="background:white; border-radius:16px; padding:28px; max-width:500px; width:90%; margin:60px auto;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h3 id="rsvp-modal-title" style="font-size:18px; font-weight:800; color:var(--navy); margin:0;"></h3>
        <button type="button" onclick="closeRsvpModal()" style="background:none; border:none; font-size:22px; cursor:pointer; color:var(--gray-500);">&times;</button>
      </div>
      <div id="rsvp-modal-body" style="font-size:14px;"></div>
    </div>
  </div>

  <script>
    function viewRsvps(eventId, title) {
      document.getElementById('rsvp-modal-title').textContent = 'RSVPs — ' + title;
      document.getElementById('rsvp-modal-body').innerHTML = '<p style="color:var(--gray-500);">Loading...</p>';
      document.getElementById('rsvp-modal').style.display = 'flex';
      fetch('/admin/event/' + eventId + '/rsvps')
        .then(r => r.json())
        .then(data => {
          let html = '<div style="display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap;">';
          const yes = data.confirmed.filter(p => p.rsvp && p.rsvp.status === 'yes').length;
          const no = data.confirmed.filter(p => p.rsvp && p.rsvp.status === 'no').length;
          const maybe = data.confirmed.filter(p => p.rsvp && p.rsvp.status === 'maybe').length;
          const none = data.confirmed.length - yes - no - maybe;
          html += '<span style="background:#dcfce7;color:#16a34a;padding:4px 10px;border-radius:6px;font-weight:700;font-size:13px;">' + yes + ' Yes</span>';
          html += '<span style="background:#fef3c7;color:#d97706;padding:4px 10px;border-radius:6px;font-weight:700;font-size:13px;">' + maybe + ' Maybe</span>';
          html += '<span style="background:#fee2e2;color:#dc2626;padding:4px 10px;border-radius:6px;font-weight:700;font-size:13px;">' + no + ' No</span>';
          html += '<span style="background:#f3f4f6;color:#6b7280;padding:4px 10px;border-radius:6px;font-weight:700;font-size:13px;">' + none + ' Pending</span>';
          html += '</div>';
          html += '<table style="width:100%;border-collapse:collapse;">';
          data.confirmed.forEach(p => {
            const status = p.rsvp ? p.rsvp.status : 'pending';
            const colors = { yes: '#16a34a', no: '#dc2626', maybe: '#d97706', pending: '#9ca3af' };
            const labels = { yes: 'Yes', no: 'No', maybe: 'Maybe', pending: '—' };
            html += '<tr style="border-bottom:1px solid #f3f4f6;">';
            html += '<td style="padding:8px 4px;font-weight:600;">' + p.player_name + '</td>';
            html += '<td style="padding:8px 4px;text-align:right;"><span style="color:' + colors[status] + ';font-weight:700;">' + labels[status] + '</span></td>';
            html += '</tr>';
          });
          html += '</table>';
          document.getElementById('rsvp-modal-body').innerHTML = html;
        });
    }
    function closeRsvpModal() { document.getElementById('rsvp-modal').style.display = 'none'; }
    document.getElementById('rsvp-modal').addEventListener('click', function(e) { if (e.target === this) closeRsvpModal(); });
  </script>

  <script>
    document.querySelectorAll('.jersey-inp').forEach(function(inp) {
      var orig = inp.value;
      inp.addEventListener('blur', function() {
        if (inp.value !== orig) {
          orig = inp.value;
          fetch('/admin/jersey-number', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ player_id: inp.dataset.pid, jersey_number: inp.value.trim() })
          });
        }
      });
      inp.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); inp.blur(); }
      });
    });
  </script>

  <footer>
    <div class="container">
      <p>Summer 2026 <%= teamName %> &middot; Major Division</p>
    </div>
  </footer>
</body>
</html>
