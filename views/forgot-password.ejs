<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password &middot; <%= teamName %></title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    .reset-box { max-width: 400px; margin: 0 auto; background: #fff; border: 1px solid #e5e7eb; border-radius: 16px; padding: 28px 24px; }
    .reset-box h2 { font-size: 18px; color: var(--navy); margin: 0 0 16px; text-align: center; }
    .reset-box .form-group { margin-bottom: 14px; }
    .reset-box label { font-size: 13px; font-weight: 600; color: #374151; display: block; margin-bottom: 4px; }
    .reset-box .form-input { width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 15px; box-sizing: border-box; }
    .reset-box .btn-primary { width: 100%; padding: 12px; font-size: 16px; font-weight: 700; }
    .reset-box .hint { font-size: 13px; color: #6b7280; margin-top: 8px; text-align: center; }
    .reset-box .code-input { font-size: 24px; text-align: center; letter-spacing: 8px; font-weight: 700; }
    .reset-footer { text-align: center; margin-top: 20px; font-size: 13px; color: #6b7280; }
    .reset-footer a { color: var(--navy); font-weight: 600; }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <div class="header-content">
        <div class="header-text">
          <div class="logo">&#9918;</div>
          <div>
            <h1><%= teamName %></h1>
            <p class="subtitle">Password Reset</p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="container">
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (step === 'request') { %>
    <div class="reset-box">
      <h2><%= type === 'admin' ? 'Admin' : 'Parent' %> Password Reset</h2>
      <form method="POST" action="/forgot-password/send">
        <input type="hidden" name="type" value="<%= type %>">
        <div class="form-group">
          <% if (type === 'admin') { %>
            <label>Username or Email</label>
            <input type="text" name="identifier" required class="form-input" placeholder="Your admin username or email" value="<%= identifier %>">
          <% } else { %>
            <label>Username or Phone Number</label>
            <input type="text" name="identifier" required class="form-input" placeholder="Username or (941) 555-1234" value="<%= identifier %>">
          <% } %>
        </div>
        <button type="submit" class="btn btn-primary">Send Reset Code</button>
        <p class="hint">
          <% if (type === 'admin') { %>
            A verification code will be emailed to you.
          <% } else { %>
            A verification code will be texted to your phone.
          <% } %>
        </p>
      </form>
    </div>

    <% } else if (step === 'verify') { %>
    <div class="reset-box">
      <h2>Enter Verification Code</h2>
      <form method="POST" action="/forgot-password/verify">
        <input type="hidden" name="type" value="<%= type %>">
        <input type="hidden" name="identifier" value="<%= identifier %>">
        <div class="form-group">
          <label>6-Digit Code</label>
          <input type="text" name="code" required class="form-input code-input" placeholder="000000" maxlength="6" pattern="\d{6}" inputmode="numeric" autofocus>
        </div>
        <button type="submit" class="btn btn-primary">Verify Code</button>
        <p class="hint">
          <% if (type === 'admin') { %>
            Check your email for the code.
          <% } else { %>
            Check your text messages for the code.
          <% } %>
          Code expires in 15 minutes.
        </p>
      </form>
    </div>

    <% } else if (step === 'reset') { %>
    <div class="reset-box">
      <h2>Set New Password</h2>
      <form method="POST" action="/forgot-password/reset">
        <input type="hidden" name="token" value="<%= token %>">
        <input type="hidden" name="type" value="<%= type %>">
        <div class="form-group">
          <label>New Password</label>
          <input type="password" name="password" required class="form-input" placeholder="Min 6 characters" minlength="6">
        </div>
        <div class="form-group">
          <label>Confirm Password</label>
          <input type="password" name="confirm_password" required class="form-input" placeholder="Confirm password">
        </div>
        <button type="submit" class="btn btn-primary">Reset Password</button>
      </form>
    </div>
    <% } %>

    <div class="reset-footer">
      <% if (type === 'admin') { %>
        <p><a href="/admin/login">Back to Admin Login</a></p>
      <% } else { %>
        <p><a href="/parent/login">Back to Parent Login</a></p>
      <% } %>
    </div>
  </main>

  <footer>
    <div class="container">
      <p>Summer 2026 <%= teamName %> &middot; Major Division</p>
    </div>
  </footer>
</body>
</html>
